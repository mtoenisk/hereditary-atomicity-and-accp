import UnconditionalCounterexample.HorizontalOrders
import Mathlib.RingTheory.Localization.Ideal

/-!
# Actual horizontal primes of the pole algebra

A retained monic irreducible polynomial defines its actual positive-order
valuation center in the pole algebra. Its polynomial preimage is exactly the
principal ideal generated by that polynomial; the center is nonzero and
maximal. Every nonzero prime of the pole algebra has this form, uniquely.

The proof uses the actual localization of k[X], normalizes the generator of
the polynomial preimage, and derives retainedness from disjointness of the
localization denominators. The valuation center and principal-ideal
classification are explicitly identified; no abstract horizontal label or
prime-correspondence hypothesis is assumed.
-/

noncomputable section
namespace UnconditionalCounterexample.HorizontalPrimes

open Polynomial PrincipalProfiles HorizontalOrders
open scoped WithZero

variable {k : Type*} [Field k] (S : Set k[X]) (hS : ∀ f ∈ S, f ≠ 0)

/-- Literal inclusion of the pole algebra into a retained horizontal valuation ring. -/
def valuationInclusion (p : MonicIrreducible k) (hp : Retained S p) :
    PoleAlgebra.generated S →+* (valuation p).valuationSubring where
  toFun x := ⟨x, by
    by_cases hx : (x : RatFunc k) = 0
    · simp [hx]
    · exact ((mem_iff_retained_valuations_le_one S hS x hx).mp x.property) p hp⟩
  map_zero' := rfl
  map_one' := rfl
  map_add' _ _ := rfl
  map_mul' _ _ := rfl

/-- The actual positive-order center in the pole algebra. -/
def center (p : MonicIrreducible k) (hp : Retained S p) : Ideal (PoleAlgebra.generated S) :=
  Ideal.comap (valuationInclusion S hS p hp) (IsLocalRing.maximalIdeal (valuation p).valuationSubring)

@[simp] theorem mem_center (p : MonicIrreducible k) (hp : Retained S p)
    (x : PoleAlgebra.generated S) : x ∈ center S hS p hp ↔ valuation p (x : RatFunc k) < 1 :=
  Valuation.mem_maximalIdeal_iff (RatFunc k) (valuation p)

instance center_isPrime (p : MonicIrreducible k) (hp : Retained S p) :
    (center S hS p hp).IsPrime := by
  dsimp [center]
  infer_instance

theorem center_comap (p : MonicIrreducible k) (hp : Retained S p) :
    (center S hS p hp).comap (algebraMap k[X] (PoleAlgebra.generated S)) = Ideal.span {p.val} := by
  ext f
  rw [Ideal.mem_comap, mem_center]
  change valuation p (algebraMap k[X] (RatFunc k) f) < 1 ↔ f ∈ Ideal.span {p.val}
  rw [valuation, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
    IsDedekindDomain.HeightOneSpectrum.intValuation_lt_one_iff_mem]
  rfl

theorem center_eq_span (p : MonicIrreducible k) (hp : Retained S p) :
    center S hS p hp = Ideal.span {algebraMap k[X] (PoleAlgebra.generated S) p.val} := by
  let := PoleAlgebra.isLocalization_generated S hS
  rw [← IsLocalization.map_under (Submonoid.closure S) (PoleAlgebra.generated S)
    (center S hS p hp), Ideal.under, center_comap, Ideal.map_span, Set.image_singleton]

theorem center_ne_bot (p : MonicIrreducible k) (hp : Retained S p) :
    center S hS p hp ≠ ⊥ := by
  rw [center_eq_span, ne_eq, Ideal.span_singleton_eq_bot]
  intro h
  have he := congrArg (fun z : PoleAlgebra.generated S => (z : RatFunc k)) h
  exact RatFunc.algebraMap_ne_zero p.property.1.ne_zero he


/-- Every actual nonzero prime of the pole algebra is a retained horizontal center. -/
theorem exists_center_of_prime (Q : Ideal (PoleAlgebra.generated S)) [Q.IsPrime]
    (hQ : Q ≠ ⊥) : ∃ p : MonicIrreducible k, ∃ hp : Retained S p, Q = center S hS p hp := by
  classical
  let := PoleAlgebra.isLocalization_generated S hS
  let I : Ideal k[X] := Q.comap (algebraMap k[X] (PoleAlgebra.generated S))
  have hprime : I.IsPrime := inferInstance
  let := hprime
  have hI0 : I ≠ ⊥ := by
    intro hzero
    apply hQ
    rw [← IsLocalization.map_under (Submonoid.closure S) (PoleAlgebra.generated S) Q]
    change I.map (algebraMap k[X] (PoleAlgebra.generated S)) = ⊥
    rw [hzero, Ideal.map_bot]
  let g := Submodule.IsPrincipal.generator I
  have hg : Prime g := Submodule.IsPrincipal.prime_generator_of_isPrime I hI0
  let p : MonicIrreducible k := ⟨normalize g, Polynomial.monic_normalize hg.ne_zero,
    (associated_normalize g).irreducible_iff.mp hg.irreducible⟩
  have hI : I = Ideal.span {p.val} := by
    rw [← Ideal.span_singleton_generator I]
    exact Ideal.span_singleton_eq_span_singleton.mpr (associated_normalize g)
  have hp : Retained S p := by
    intro f hf hpf
    have hfI : f ∈ I := by rw [hI, Ideal.mem_span_singleton]; exact hpf
    have hdis := ((IsLocalization.isPrime_iff_isPrime_disjoint
      (Submonoid.closure S) (PoleAlgebra.generated S) Q).mp inferInstance).2
    exact Set.disjoint_left.mp hdis (Submonoid.subset_closure hf) hfI
  refine ⟨p, hp, ?_⟩
  apply (IsLocalization.orderEmbedding (Submonoid.closure S) (PoleAlgebra.generated S)).injective
  change I = (center S hS p hp).comap (algebraMap k[X] (PoleAlgebra.generated S))
  rw [center_comap]
  exact hI

theorem center_injective (p q : MonicIrreducible k) (hp : Retained S p) (hq : Retained S q)
    (he : center S hS p hp = center S hS q hq) : p = q := by
  have h := congrArg (Ideal.comap (algebraMap k[X] (PoleAlgebra.generated S))) he
  rw [center_comap, center_comap] at h
  exact Subtype.ext (Polynomial.eq_of_monic_of_associated p.property.1 q.property.1
    (Ideal.span_singleton_eq_span_singleton.mp h))


/-- Each retained horizontal center is an actual maximal ideal of the pole algebra. -/
theorem center_isMaximal (p : MonicIrreducible k) (hp : Retained S p) :
    (center S hS p hp).IsMaximal := by
  let := PoleAlgebra.isLocalization_generated S hS
  have hmax : ((center S hS p hp).under k[X]).IsMaximal := by
    change ((center S hS p hp).comap (algebraMap k[X] (PoleAlgebra.generated S))).IsMaximal
    rw [center_comap]
    exact PrincipalIdealRing.isMaximal_of_irreducible p.property.2
  let := hmax
  exact IsLocalization.isMaximal_of_isMaximal_under
    (Submonoid.closure S) (PoleAlgebra.generated S) (center S hS p hp)

end UnconditionalCounterexample.HorizontalPrimes
