import UnconditionalCounterexample.MixedSignatures
import UnconditionalCounterexample.MixedTheoremA

/-! # Corollary 8.2 of the manuscript -/

namespace UnconditionalCounterexample.MixedVariation

/-- The ring properties stated in the continuum-family corollary, including
a strict chain whose first ideal is generated by the square of an atom. -/
def RingConclusion (D : Subring (RatFunc ℚ)) : Prop :=
  Factorization.IsHereditarilyAtomic D ∧ IsAlmostDedekindDomain D ∧
    PaperTargets.IsSPDomain D ∧ IsFractionRing D (RatFunc ℚ) ∧
    Nonempty (Additive (CommRing.Pic D) ≃+ (ℕ →₀ ZMod 3)) ∧
    ∃ a : D, Irreducible a ∧ ∃ I : ℕ → Ideal D,
      I 0 = Ideal.span {a ^ 2} ∧ StrictMono I ∧ ∀ n, (I n).IsPrincipal

theorem ringConclusion_of_theoremA {D : Subring (RatFunc ℚ)}
    (h : PaperTargets.TheoremAConclusion D) : RingConclusion D := by
  obtain ⟨hHA, hfield, _, ⟨t, _, ht, hchain⟩, _, hDVR, hSP, hPic⟩ := h
  obtain ⟨_, x, _, _, hzero, _, _, hstrict, _⟩ := hchain
  refine ⟨hHA, hDVR, hSP, hfield, hPic, t, ht, fun n => Ideal.span {x n}, ?_, hstrict, ?_⟩
  · exact congrArg (fun z : D => Ideal.span {z}) hzero
  · intro n
    exact ⟨x n, rfl⟩

/-- Corollary 8.2 in the language of cardinality and abstract ring isomorphism. -/
def ContinuumMany : Prop :=
  ∃ rings : Set (Subring (RatFunc ℚ)), Cardinal.mk rings = Cardinal.continuum ∧
    (∀ D ∈ rings, RingConclusion D) ∧
      ∀ D ∈ rings, ∀ E ∈ rings, D ≠ E → ¬ Nonempty (D ≃+* E)

/-- An actual set of continuum many pairwise nonisomorphic examples with all
the properties stated in Corollary 8.2. -/
theorem continuum_many : ContinuumMany := by
  refine ⟨Set.range family, cardinal_range, ?_, ?_⟩
  · rintro _ ⟨s, rfl⟩
    exact ringConclusion_of_theoremA (MixedConstruction.theoremAConclusion s.val s.property)
  · exact fun _ hD _ hE hne => range_nonisomorphic hD hE hne

end UnconditionalCounterexample.MixedVariation
