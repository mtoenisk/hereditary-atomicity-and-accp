import UnconditionalCounterexample.PoleTensorConductor
import UnconditionalCounterexample.LocalAlgebra.ReducedConductor
import UnconditionalCounterexample.LocalAlgebra.TorsionDescent

/-!
# The paired evaluation kernel and the prescribed integer multiplier

For any integer n with nt in the original subring, use the exact conductor
in the transported tensor image and the two integral evaluation vectors to
put n times the larger tensor image inside the smaller one. The same n then
appears in the torsion descent of manuscript Theorem 6.3.
-/

noncomputable section

namespace UnconditionalCounterexample.TensorPairLifting

open Polynomial TensorProduct PoleTensorConductor RadicalConductor LocalAlgebra

/-- The paired evaluation kernel in a polynomial localization is generated by
the product of the two distinct linear factors. -/
theorem pair_kernel {K A : Type*} [Field K] [CommRing A] [Algebra K[X] A]
    (M : Submonoid K[X]) [IsLocalization M A] (a b : K) (hab : a ≠ b)
    (f : A →+* K × K) (h : ∀ g : K[X], f (algebraMap K[X] A g) = (g.eval a, g.eval b)) :
    RingHom.ker f = Ideal.span {algebraMap K[X] A ((X - C a) * (X - C b))} := by
  have hpre : (RingHom.ker f).comap (algebraMap K[X] A) =
      Ideal.span {(X - C a) * (X - C b)} := by
    ext g
    simp only [Ideal.mem_comap, RingHom.mem_ker, h, Prod.ext_iff, Prod.fst_zero, Prod.snd_zero,
      Ideal.mem_span_singleton]
    have hc := isCoprime_X_sub_C_of_isUnit_sub (sub_ne_zero.mpr hab).isUnit
    constructor
    · rintro ⟨ha, hb⟩
      exact hc.mul_dvd (dvd_iff_isRoot.mpr ha) (dvd_iff_isRoot.mpr hb)
    · intro hd
      exact ⟨dvd_iff_isRoot.mp ((dvd_mul_right _ _).trans hd),
        dvd_iff_isRoot.mp ((dvd_mul_left _ _).trans hd)⟩
  rw [← IsLocalization.map_under M A (RingHom.ker f), Ideal.under, hpre,
    Ideal.map_span, Set.image_singleton]

variable (p : ℕ) [Fact p.Prime] (S : Set ℚ[X]) (hS : ∀ f ∈ S, f ≠ 0)
local notation "B" => PoleAlgebra.generated S
local notation "A" => PoleAlgebra.generated (ScalarExtension.extendedSet ℚ ℚ_[p] S)

def pairValue (a b : ℚ_[p])
    (ha : ∀ f ∈ S, f.eval₂ (algebraMap ℚ ℚ_[p]) a ≠ 0)
    (hb : ∀ f ∈ S, f.eval₂ (algebraMap ℚ ℚ_[p]) b ≠ 0) : A →ₐ[ℚ_[p]] ℚ_[p] × ℚ_[p] :=
  (value p S hS a ha).prod (value p S hS b hb)

theorem pairValue_polynomial (a b : ℚ_[p])
    (ha : ∀ f ∈ S, f.eval₂ (algebraMap ℚ ℚ_[p]) a ≠ 0)
    (hb : ∀ f ∈ S, f.eval₂ (algebraMap ℚ ℚ_[p]) b ≠ 0) (g : ℚ_[p][X]) :
    pairValue p S hS a b ha hb (algebraMap ℚ_[p][X] A g) = (g.eval a, g.eval b) := by
  change ((PoleJets.extendedJet S hS a ha _).fst, (PoleJets.extendedJet S hS b hb _).fst) = _
  unfold PoleJets.extendedJet
  simp only [PoleJets.jet_polynomial, LocalizedPolynomialJets.firstJet_fst]

/-- The local lattice argument retains the same integer that cleared t in T. -/
theorem same_integer_in_image
    (T D : Subring B) (a b : ℤ_[p]) (hdiff : IsUnit (b - a))
    (ha : ∀ f ∈ S, f.eval₂ (algebraMap ℚ ℚ_[p]) a.val ≠ 0)
    (hb : ∀ f ∈ S, f.eval₂ (algebraMap ℚ ℚ_[p]) b.val ≠ 0)
    (hva : ∀ d : D, ‖RatFunc.eval (algebraMap ℚ ℚ_[p]) a.val ((d : B) : RatFunc ℚ)‖ ≤ 1)
    (hvb : ∀ d : D, ‖RatFunc.eval (algebraMap ℚ ℚ_[p]) b.val ((d : B) : RatFunc ℚ)‖ ≤ 1)
    (hcond : conductorIdeal (image p S hS T) =
      Ideal.span {algebraMap ℚ_[p][X] A ((X - C a.val) * (X - C b.val))})
    (n : ℤ) (hnt : (n : B) * algebraMap ℚ[X] B X ∈ T)
    (z : ℚ_[p] ⊗[ℚ] B) (hz : z ∈ IntegralTensorImage.image p B D) :
    (n : ℚ_[p] ⊗[ℚ] B) * z ∈ IntegralTensorImage.image p B T := by
  let e := ScalarExtension.tensorEquiv ℚ ℚ_[p] S hS
  let f := pairValue p S hS a.val b.val ha hb
  let := PoleAlgebra.isLocalization_generated _ (ScalarExtension.extendedSet_nonzero ℚ ℚ_[p] S hS)
  have hab : a.val ≠ b.val := by
    intro heq
    have h := Subtype.ext heq
    simp [h] at hdiff
  have hker (x : A) (hx : f x = 0) : x ∈ image p S hS T := by
    apply conductorIdeal_subset
    rw [hcond, ← pair_kernel (Submonoid.closure (ScalarExtension.extendedSet ℚ ℚ_[p] S)) a.val b.val hab f.toRingHom
      (pairValue_polynomial p S hS _ _ ha hb)]
    exact hx
  let T' : Subalgebra ℤ_[p] A :=
    { image p S hS T with
      algebraMap_mem' := fun c => TransportedIntegralImage.scalar_mem p _ _ e T c.val c.property }
  let t := algebraMap ℚ_[p][X] A X
  have hnt' : (n : ℤ_[p]) • t ∈ T' := by
    have h := TransportedIntegralImage.original_mem p _ _ e T ⟨_, hnt⟩
    have heq : (1 : ℚ_[p]) ⊗ₜ[ℚ] ((n : B) * algebraMap ℚ[X] B X) =
        (n : ℚ_[p] ⊗[ℚ] B) * ((1 : ℚ_[p]) ⊗ₜ[ℚ] algebraMap ℚ[X] B X) := by
      change Algebra.TensorProduct.includeRight ((n : B) * _) = _
      rw [map_mul, map_intCast]
      rfl
    change e ((1 : ℚ_[p]) ⊗ₜ[ℚ] ((n : B) * _)) ∈ image p S hS T at h
    rw [heq, map_mul, map_intCast] at h
    change (n : ℤ_[p]) • t ∈ image p S hS T
    simpa [e, t, Algebra.smul_def] using h
  have hDz : e z ∈ image p S hS D := ⟨z, hz, rfl⟩
  have hlocal := scaled_mem_of_integral_pair T' (f.restrictScalars ℤ_[p]) hker
    a b (n : ℤ_[p]) hdiff t (by simpa [t, f] using pairValue_polynomial p S hS _ _ ha hb X)
    hnt' (e z) ⟨⟨_, integral_values p S hS D a.val ha hva _ hDz⟩,
      ⟨_, integral_values p S hS D b.val hb hvb _ hDz⟩, rfl⟩
  change (n : ℤ_[p]) • e z ∈ image p S hS T at hlocal
  have hmem : e ((n : ℚ_[p] ⊗[ℚ] B) * z) ∈ image p S hS T := by
    simpa only [Algebra.smul_def, map_mul, map_intCast] using hlocal
  obtain ⟨w, hw, he⟩ := hmem
  exact e.injective he ▸ hw

end UnconditionalCounterexample.TensorPairLifting
