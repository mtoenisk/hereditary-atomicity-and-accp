import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.Localization.Basic
import Mathlib.Algebra.Algebra.Rat
import Mathlib.Tactic.Ring

/-!
# Rational hulls of arbitrary unital subrings

For an arbitrary subring T of a commutative Q-algebra B, the actual algebra
`Algebra.adjoin Q T` consists exactly of elements whose positive integer
multiple lies in T. Its canonical T-algebra structure is the localization
at the images of nonzero integers.

Generic-fibre recovery gives a positive integer n with nt ∈ T. Each member of B also
admits an integer denominator in T. A common denominator for the entire algebra is
provided by the conductor argument.
-/

namespace UnconditionalCounterexample.RationalHull

variable {B : Type*} [CommRing B] [Algebra ℚ B]

/-- The literal rational algebra generated by the unital subring. -/
def hull (T : Subring B) : Subalgebra ℚ B := Algebra.adjoin ℚ (T : Set B)

theorem mem_hull_iff (T : Subring B) (x : B) :
    x ∈ hull T ↔ ∃ n : ℕ, 0 < n ∧ (n : B) * x ∈ T := by
  constructor
  · intro hx
    induction hx using Algebra.adjoin_induction with
    | mem y hy =>
      refine ⟨1, Nat.zero_lt_one, ?_⟩
      simpa only [Nat.cast_one, one_mul] using (show y ∈ T from hy)
    | algebraMap q =>
      refine ⟨q.den, q.den_pos, ?_⟩
      have heq : (q.den : B) * algebraMap ℚ B q = (q.num : B) := by
        rw [← map_natCast (algebraMap ℚ B), ← map_mul]
        rw [Rat.den_mul_eq_num]
        exact map_intCast _ _
      rw [heq]
      exact intCast_mem T q.num
    | add y z _ _ hy hz =>
      obtain ⟨n, hn, hny⟩ := hy
      obtain ⟨m, hm, hmz⟩ := hz
      refine ⟨n * m, Nat.mul_pos hn hm, ?_⟩
      have heq : ((n * m : ℕ) : B) * (y + z) =
          (m : B) * ((n : B) * y) + (n : B) * ((m : B) * z) := by push_cast; ring
      rw [heq]
      exact T.add_mem (T.mul_mem (natCast_mem T m) hny) (T.mul_mem (natCast_mem T n) hmz)
    | mul y z _ _ hy hz =>
      obtain ⟨n, hn, hny⟩ := hy
      obtain ⟨m, hm, hmz⟩ := hz
      refine ⟨n * m, Nat.mul_pos hn hm, ?_⟩
      have heq : ((n * m : ℕ) : B) * (y * z) = ((n : B) * y) * ((m : B) * z) := by
        push_cast
        ring
      rw [heq]
      exact T.mul_mem hny hmz
  · rintro ⟨n, hn, hnx⟩
    have hh : algebraMap ℚ B (n : ℚ)⁻¹ * ((n : B) * x) ∈ hull T :=
      (hull T).mul_mem ((hull T).algebraMap_mem _) (Algebra.subset_adjoin hnx)
    have heq : algebraMap ℚ B (n : ℚ)⁻¹ * ((n : B) * x) = x := by
      rw [← mul_assoc, ← map_natCast (algebraMap ℚ B), ← map_mul,
        inv_mul_cancel₀ (Nat.cast_ne_zero.mpr (Nat.ne_of_gt hn)), map_one, one_mul]
    rwa [heq] at hh

/-- Canonical inclusion into the actual rational hull. -/
def inclusion (T : Subring B) : T →+* hull T :=
  Subring.inclusion (show T ≤ (hull T).toSubring from fun _ hx => Algebra.subset_adjoin hx)

instance inclusionAlgebra (T : Subring B) : Algebra T (hull T) := (inclusion T).toAlgebra

@[simp] theorem coe_algebraMap (T : Subring B) (t : T) :
    ((algebraMap T (hull T) t : hull T) : B) = t := rfl

instance inclusionScalarTower (T : Subring B) : IsScalarTower T (hull T) B :=
  IsScalarTower.of_algebraMap_eq (fun _ => rfl)

/-- The images in T of the nonzero integers. -/
def integerDenominators (T : Subring B) : Submonoid T :=
  (nonZeroDivisors ℤ).map (Int.castRingHom T)

/-- The rational hull is the actual localization of T obtained by inverting
nonzero integers, with its canonical inclusion map. -/
theorem isLocalization_hull (T : Subring B) :
    IsLocalization (integerDenominators T) (hull T) := by
  apply (isLocalization_iff _ _).mpr
  refine ⟨?_, ?_, ?_⟩
  · intro s
    obtain ⟨z, hz, hzs⟩ := s.property
    change IsUnit (algebraMap T (hull T) s.val)
    rw [← hzs]
    have hz0 : z ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hz
    have hzq : IsUnit (z : ℚ) := isUnit_iff_ne_zero.mpr (by exact_mod_cast hz0)
    simpa using hzq.map (algebraMap ℚ (hull T))
  · intro x
    obtain ⟨n, hn, hnx⟩ := (mem_hull_iff T x).mp x.property
    let a : T := ⟨(n : B) * x, hnx⟩
    have hnS : (n : T) ∈ integerDenominators T := by
      refine ⟨(n : ℤ), ?_, by simp⟩
      exact mem_nonZeroDivisors_iff_ne_zero.mpr (by exact_mod_cast Nat.ne_of_gt hn)
    refine ⟨⟨a, ⟨n, hnS⟩⟩, ?_⟩
    apply Subtype.ext
    change (x : B) * n = n * (x : B)
    exact mul_comm _ _
  · intro x y hxy
    refine ⟨1, ?_⟩
    have heq : x = y := Subtype.ext (congrArg (fun z : hull T => (z : B)) hxy)
    simp [heq]

/-- Recovery of the whole rational algebra supplies a positive integer
clearing every individual element. No uniform integer is asserted here. -/
theorem exists_nat_mul_mem_of_hull_eq_top (T : Subring B) (hT : hull T = ⊤) (b : B) :
    ∃ n : ℕ, 0 < n ∧ (n : B) * b ∈ T := by
  apply (mem_hull_iff T b).mp
  rw [hT]
  trivial

/-- The rational hull is full exactly when every ambient element can be
cleared into the subring by some positive integer. -/
theorem hull_eq_top_iff (T : Subring B) : hull T = ⊤ ↔
    ∀ b : B, ∃ n : ℕ, 0 < n ∧ (n : B) * b ∈ T := by
  constructor
  · exact exists_nat_mul_mem_of_hull_eq_top T
  · intro h
    apply top_unique
    intro b _
    exact (mem_hull_iff T b).mpr (h b)

end UnconditionalCounterexample.RationalHull
