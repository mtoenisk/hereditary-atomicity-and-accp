import UnconditionalCounterexample.LocalAlgebra.TensorImage
import Mathlib.RingTheory.Ideal.Colon
import Mathlib.Algebra.Module.LocalizedModule.Submodule
import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
import Mathlib.RingTheory.Localization.BaseChange
import Mathlib.LinearAlgebra.TensorProduct.Tower
import Mathlib.RingTheory.Ideal.Int
import Mathlib.RingTheory.Int.Basic

/-!
# Local detection of subring membership
-/

namespace UnconditionalCounterexample.LocalAlgebra

section General

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- A vector is in a submodule if it has a denominator avoiding every maximal
ideal. This is the algebraic local-to-global membership criterion. -/
theorem submodule_mem_iff_local_denominators (A : Submodule R M) (x : M) :
    x ∈ A ↔ ∀ P : Ideal R, P.IsMaximal → ∃ s : R, s ∉ P ∧ s • x ∈ A := by
  constructor
  · intro hx P hP
    exact ⟨1, (P.ne_top_iff_one.mp hP.ne_top), by simpa using hx⟩
  · intro h
    by_contra hx
    have hproper : A.colon ({x} : Set M) ≠ ⊤ := by
      intro heq
      have h1 : (1 : R) ∈ A.colon ({x} : Set M) := by rw [heq]; trivial
      exact hx (by simpa [Submodule.mem_colon_singleton] using h1)
    obtain ⟨P, hP, hle⟩ := Ideal.exists_le_maximal _ hproper
    obtain ⟨s, hsP, hsA⟩ := h P hP
    exact hsP (hle (Submodule.mem_colon_singleton.mpr hsA))

open scoped TensorProduct

/-- Membership after scalar extension to a faithfully flat algebra over a
localization supplies a denominator from the localized multiplicative set. -/
theorem submodule_local_denominator_of_tensorImage
    {A B : Type*} [CommRing A] [CommRing B] [Algebra R A] [Algebra R B]
    [Algebra A B] [IsScalarTower R A B] (T : Submonoid R) [IsLocalization T A]
    [Module.FaithfullyFlat A B] (N : Submodule R M) (x : M)
    (hx : x ⊗ₜ[R] (1 : B) ∈ LocalOrderTensor.tensorImage B N) :
    ∃ s : T, (s : R) • x ∈ N := by
  obtain ⟨y, hy⟩ := hx
  have hquot : N.mkQ x ⊗ₜ[R] (1 : B) = 0 := by
    have h := congrArg (N.mkQ.rTensor B) hy
    rw [← LinearMap.rTensor_comp_apply] at h
    have heq : N.mkQ.comp N.subtype = 0 := by ext z; simp
    simpa only [heq, LinearMap.rTensor_zero, LinearMap.zero_apply,
      LinearMap.rTensor_tmul] using h.symm
  have hcomm : (1 : B) ⊗ₜ[R] N.mkQ x = 0 := by
    simpa using congrArg (TensorProduct.comm R (M ⧸ N) B) hquot
  have hloc : (1 : A) ⊗ₜ[R] N.mkQ x = 0 := by
    apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := A) (B := B)
      (A ⊗[R] (M ⧸ N))
    apply (TensorProduct.AlgebraTensorModule.cancelBaseChange R A B B (M ⧸ N)).injective
    simpa using hcomm
  obtain ⟨s, hsx⟩ := (IsLocalizedModule.eq_zero_iff T
    (TensorProduct.mk R A (M ⧸ N) 1)).mp hloc
  refine ⟨s, ?_⟩
  apply (Submodule.Quotient.mk_eq_zero N).mp
  rw [Submodule.Quotient.mk_smul]
  exact hsx

end General

/-- Maximal ideals of the rational integers are generated by positive primes. -/
theorem integer_maximal_eq_span_prime (P : Ideal ℤ) (hP : P.IsMaximal) :
    ∃ p : ℕ, p.Prime ∧ P = Ideal.span {(p : ℤ)} := by
  let : P.IsPrime := hP.isPrime
  have hg : Prime (Submodule.IsPrincipal.generator P) :=
    Submodule.IsPrincipal.prime_generator_of_isPrime P
      (Ring.ne_bot_of_isMaximal_of_not_isField hP Int.not_isField)
  refine ⟨(Submodule.IsPrincipal.generator P).natAbs,
    Int.prime_iff_natAbs_prime.mp hg, ?_⟩
  rw [Int.span_natAbs, Ideal.span_singleton_generator]

end UnconditionalCounterexample.LocalAlgebra
