import UnconditionalCounterexample.LocalAlgebra.IntegralTensorImage
import UnconditionalCounterexample.RationalHull
import Mathlib.RingTheory.TensorProduct.Maps
import Mathlib.NumberTheory.Padics.RingHoms
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# Torsion descent through finite cyclic p-adic tensors

This follows the final paragraph of manuscript Theorem 6.3. A nonzero torsion
class contains an injected finite cyclic group ZMod m with m > 1. For a prime
p dividing m, reduction to ZMod p sends the unit tensor in Z_p tensor ZMod m
to one, proving that this tensor is nonzero. Flatness carries the cyclic
injection into the tensor of the ambient additive group.

Thus vanishing at every p detects a torsion group or a torsion element.
Rational-hull equality gives torsion of the additive quotient (nD+T)/T, with
no finite-generation or common-annihilator requirement. The last theorem
applies this finite cyclic proof to the actual integral tensor images; it
does not invoke the earlier localization-based membership theorem.
-/

namespace UnconditionalCounterexample.LocalAlgebra.TorsionDescent
noncomputable section
open scoped TensorProduct

/-- A residue reduction detects a nonzero pure tensor in the finite cyclic
p-adic tensor whenever p divides its modulus. -/
def cyclicTensorReduction (p m : ℕ) [Fact p.Prime] (hpm : p ∣ m) :
    PadicInt p ⊗[ℤ] ZMod m →ₐ[ℤ] ZMod p :=
  Algebra.TensorProduct.lift PadicInt.toZMod.toIntAlgHom
    (ZMod.castHom hpm (ZMod p)).toIntAlgHom (fun _ _ => Commute.all _ _)

theorem cyclicTensor_one_ne_zero (p m : ℕ) [Fact p.Prime] (hpm : p ∣ m) :
    (1 : PadicInt p) ⊗ₜ[ℤ] (1 : ZMod m) ≠ 0 := by
  intro h
  change (1 : PadicInt p ⊗[ℤ] ZMod m) = 0 at h
  have h' := congrArg (cyclicTensorReduction p m hpm) h
  exact one_ne_zero (by simpa only [map_one, map_zero] using h')

variable {M : Type*} [AddCommGroup M]

/-- The literal cyclic group generated by x, with its exact additive order. -/
def cyclicMap (x : M) : ZMod (addOrderOf x) →+ M :=
  ZMod.lift (addOrderOf x) ⟨zmultiplesHom M x, by simp⟩

@[simp] theorem cyclicMap_one (x : M) : cyclicMap x 1 = x := by
  simpa [cyclicMap] using
    ZMod.lift_coe (addOrderOf x) ⟨zmultiplesHom M x, by simp⟩ (1 : ℤ)

theorem cyclicMap_injective (x : M) : Function.Injective (cyclicMap x) := by
  apply (ZMod.lift_injective (addOrderOf x)).mpr
  intro z hz
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
  exact addOrderOf_dvd_iff_zsmul_eq_zero.mpr hz

/-- A nonzero torsion element supplies an actual injected finite cyclic group
of order greater than one. -/
theorem exists_finite_cyclic_embedding (x : M) (hx : x ≠ 0) (hfin : IsOfFinAddOrder x) :
    ∃ m : ℕ, 1 < m ∧ ∃ f : ZMod m →+ M, Function.Injective f ∧ f 1 = x := by
  refine ⟨addOrderOf x, ?_, cyclicMap x, cyclicMap_injective x, cyclicMap_one x⟩
  have hp : 0 < addOrderOf x := hfin.addOrderOf_pos
  have hn : addOrderOf x ≠ 1 := mt AddMonoid.addOrderOf_eq_one_iff.mp hx
  omega

/-- A nonzero finite cyclic subgroup remains visible in a p-adic tensor for
some prime dividing its order; flatness preserves the actual injection. -/
theorem exists_prime_tmul_ne_zero (x : M) (hx : x ≠ 0) (hfin : IsOfFinAddOrder x) :
    ∃ p : ℕ, ∃ _ : Fact p.Prime, (1 : PadicInt p) ⊗ₜ[ℤ] x ≠ 0 := by
  obtain ⟨m, hm, f, hf, hfx⟩ := exists_finite_cyclic_embedding x hx hfin
  obtain ⟨p, hp, hpm⟩ := Nat.exists_prime_and_dvd (by omega : m ≠ 1)
  let : Fact p.Prime := ⟨hp⟩
  refine ⟨p, inferInstance, ?_⟩
  intro hzero
  have hinj := Module.Flat.lTensor_preserves_injective_linearMap
    (M := PadicInt p) f.toIntLinearMap hf
  have hmap : f.toIntLinearMap.lTensor (PadicInt p)
      ((1 : PadicInt p) ⊗ₜ[ℤ] (1 : ZMod m)) = 0 := by
    simpa only [LinearMap.lTensor_tmul, AddMonoidHom.coe_toIntLinearMap, hfx] using hzero
  exact cyclicTensor_one_ne_zero p m hpm (hinj (hmap.trans (map_zero _).symm))

/-- The paper's prime-by-prime vanishing test for a torsion element. -/
theorem eq_zero_of_padic_tmul_eq_zero (x : M) (hfin : IsOfFinAddOrder x)
    (hzero : ∀ (p : ℕ) (_ : Fact p.Prime), (1 : PadicInt p) ⊗ₜ[ℤ] x = 0) : x = 0 := by
  by_contra hx
  obtain ⟨p, hp, hne⟩ := exists_prime_tmul_ne_zero x hx hfin
  exact hne (hzero p hp)

theorem torsion_subsingleton_of_padic_tensors_subsingleton
    (htorsion : ∀ x : M, IsOfFinAddOrder x)
    (hzero : ∀ (p : ℕ) (_ : Fact p.Prime), Subsingleton (PadicInt p ⊗[ℤ] M)) :
    Subsingleton M := by
  suffices h : ∀ x : M, x = 0 from ⟨fun x y => (h x).trans (h y).symm⟩
  intro x
  apply eq_zero_of_padic_tmul_eq_zero x (htorsion x)
  intro p hp
  have := hzero p hp
  exact Subsingleton.elim _ _

/-- Clearing each representative by some positive integer makes the additive
quotient torsion; no common annihilator is asserted. -/
theorem quotient_torsion_of_integer_clearing (T : AddSubgroup M)
    (hclear : ∀ x : M, ∃ n : ℕ, 0 < n ∧ n • x ∈ T) :
    ∀ q : M ⧸ T, IsOfFinAddOrder q := by
  intro q
  obtain ⟨x,rfl⟩ := QuotientAddGroup.mk'_surjective T q
  obtain ⟨n,hn,hnx⟩ := hclear x
  apply isOfFinAddOrder_iff_nsmul_eq_zero.mpr
  refine ⟨n,hn,?_⟩
  rw [← map_nsmul]
  exact (QuotientAddGroup.eq_zero_iff _).mpr hnx

/-- In particular, QT=B makes the manuscript's `(nD+T)/T` torsion: take
S=nD+T below. The more general subgroup S need not contain T. -/
theorem quotient_subgroup_torsion_of_hull_eq_top
    {B : Type*} [CommRing B] [Algebra ℚ B]
    (T : Subring B) (hT : RationalHull.hull T = ⊤) (S : AddSubgroup B) :
    ∀ q : S ⧸ T.toAddSubgroup.comap S.subtype, IsOfFinAddOrder q := by
  apply quotient_torsion_of_integer_clearing
  intro x
  obtain ⟨n,hn,hnx⟩ := RationalHull.exists_nat_mul_mem_of_hull_eq_top T hT (x : B)
  refine ⟨n,hn,?_⟩
  change (n • (x : B)) ∈ T
  simpa only [nsmul_eq_mul] using hnx

/-- Flat finite-cyclic detection gives membership directly from the actual
integral tensor images. This proof does not use the localization descent
criterion: it follows the manuscript's torsion argument. -/
theorem mem_of_padic_tensor_images (T : Submodule ℤ M)
    (hclear : ∀ x : M, ∃ n : ℕ, 0 < n ∧ n • x ∈ T) (x : M)
    (hlocal : ∀ (p : ℕ) (_ : Fact p.Prime),
      (1 : PadicInt p) ⊗ₜ[ℤ] x ∈ LinearMap.range (T.subtype.lTensor (PadicInt p))) :
    x ∈ T := by
  have hfin := quotient_torsion_of_integer_clearing T.toAddSubgroup hclear
    (QuotientAddGroup.mk' T.toAddSubgroup x)
  have hx : T.mkQ x = 0 := by
    apply eq_zero_of_padic_tmul_eq_zero (T.mkQ x) hfin
    intro p hp
    obtain ⟨y,hy⟩ := hlocal p hp
    have hmap := congrArg (T.mkQ.lTensor (PadicInt p)) hy
    rw [LinearMap.lTensor_tmul] at hmap
    have hz : T.mkQ.lTensor (PadicInt p) (T.subtype.lTensor (PadicInt p) y) = 0 := by
      have hc : T.mkQ.comp T.subtype = 0 := by
        ext t
        exact (Submodule.Quotient.mk_eq_zero T).mpr t.property
      rw [← LinearMap.lTensor_comp_apply, hc]
      simp
    exact hmap.symm.trans hz
  exact (Submodule.Quotient.mk_eq_zero T).mp hx

/-- Right-oriented version matching the maintained actual lattice images. -/
theorem mem_of_right_padic_tensor_images (T : Submodule ℤ M)
    (hclear : ∀ x : M, ∃ n : ℕ, 0 < n ∧ n • x ∈ T) (x : M)
    (hlocal : ∀ (p : ℕ) (_ : Fact p.Prime),
      x ⊗ₜ[ℤ] (1 : PadicInt p) ∈ LinearMap.range (T.subtype.rTensor (PadicInt p))) :
    x ∈ T := by
  apply mem_of_padic_tensor_images T hclear x
  intro p hp
  obtain ⟨y,hy⟩ := hlocal p hp
  refine ⟨TensorProduct.comm ℤ T (PadicInt p) y, ?_⟩
  have hc : T.subtype.lTensor (PadicInt p) (TensorProduct.comm ℤ T (PadicInt p) y) =
      TensorProduct.comm ℤ M (PadicInt p) (T.subtype.rTensor (PadicInt p) y) := by
    clear hy
    induction y using TensorProduct.inductionOn with
    | tmul t z => rfl
    | add y z hy hz => simp only [map_add, hy, hz]
  rw [hc, hy, TensorProduct.comm_tmul]

/-- The paper's integer conductor descent through the finite-cyclic tensor
test, applied to the actual integral tensor images in the rational ambient
algebra. The only additional input beyond the local inclusions is QT=B. -/
theorem integer_conductor_of_all_images
    {B : Type*} [CommRing B] [Algebra ℚ B]
    (T D : Subring B) (hT : RationalHull.hull T = ⊤) (n : ℤ)
    (hlocal : ∀ (p : ℕ) (_ : Fact p.Prime),
      ∀ x ∈ IntegralTensorImage.image p B D,
        (n : Padic p ⊗[ℚ] B) * x ∈ IntegralTensorImage.image p B T) :
    ∀ d ∈ D, (n : B) * d ∈ T := by
  intro d hd
  have hclear : ∀ b : B, ∃ k : ℕ, 0 < k ∧ k • b ∈ T.toAddSubgroup.toIntSubmodule := by
    intro b
    obtain ⟨k,hk,hkb⟩ := RationalHull.exists_nat_mul_mem_of_hull_eq_top T hT b
    refine ⟨k,hk,?_⟩
    change k • b ∈ T
    simpa only [nsmul_eq_mul] using hkb
  apply mem_of_right_padic_tensor_images T.toAddSubgroup.toIntSubmodule hclear ((n : B) * d)
  intro p hp
  apply (IntegralTensorImage.ambientEquiv_mem_image_iff p B T _).mp
  rw [IntegralTensorImage.ambientEquiv_tmul]
  have h := hlocal p hp ((1 : Padic p) ⊗ₜ[ℚ] d)
    (IntegralTensorImage.tmul_mem_image p B D ⟨d,hd⟩ 1)
  have heq : (1 : Padic p) ⊗ₜ[ℚ] ((n : B) * d) =
      (n : Padic p ⊗[ℚ] B) * ((1 : Padic p) ⊗ₜ[ℚ] d) := by
    change Algebra.TensorProduct.includeRight ((n : B) * d) = _
    rw [map_mul, map_intCast]
    rfl
  simpa only [PadicInt.coe_one, heq] using h

end
end UnconditionalCounterexample.LocalAlgebra.TorsionDescent
