import Mathlib.RingTheory.Nakayama
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-!
# Finite modules detected by their maximal fibres

A submodule of a finite module equals the whole module if it surjects onto every
maximal fibre. The algebra version uses the quotient by the extended maximal ideal.

No Noetherian hypothesis, finite generation of the source submodule, or
geometric separation assumption is used here. The curve argument must supply
module finiteness and surjectivity on all the indicated fibres separately.
-/

namespace UnconditionalCounterexample

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- A submodule of a finite module is the whole module if it generates every
maximal fibre. The proof applies the determinant form of Nakayama to the
quotient and a maximal ideal containing its annihilator. -/
theorem submodule_eq_top_of_all_maximal_fibres [Module.Finite R M]
    (N : Submodule R M)
    (h : ∀ m : Ideal R, m.IsMaximal → N ⊔ m • (⊤ : Submodule R M) = ⊤) :
    N = ⊤ := by
  by_contra hN
  let Q := M ⧸ N
  let : Nontrivial Q := Submodule.Quotient.nontrivial_iff.mpr hN
  have hann : Module.annihilator R Q ≠ ⊤ := by
    intro htop
    have : Subsingleton Q := Module.annihilator_eq_top_iff.mp htop
    exact not_subsingleton Q inferInstance
  obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal (Module.annihilator R Q) hann
  have hquot : (⊤ : Submodule R Q) ≤ m • (⊤ : Submodule R Q) := by
    have hh := congrArg (Submodule.map N.mkQ) (h m hm)
    simpa only [Submodule.map_sup, Submodule.map_smul'', Submodule.mkQ_map_self,
      Submodule.map_top, N.range_mkQ, bot_sup_eq] using hh.symm.le
  obtain ⟨r, hr, hzero⟩ :=
    Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul m
      (⊤ : Submodule R Q) Module.Finite.fg_top hquot
  have hrmem : r ∈ m := hle (Module.mem_annihilator.mpr (fun x => hzero x trivial))
  have hone : (1 : R) ∈ m := by
    simpa only [sub_sub_cancel] using m.sub_mem hrmem hr
  exact hm.ne_top (m.eq_top_iff_one.mpr hone)

/-- A map to a finite module is surjective if its composite with every
maximal-fibre quotient map is surjective. The source module need not be finite. -/
theorem linearMap_surjective_of_all_maximal_fibres
    {P : Type*} [AddCommGroup P] [Module R P] [Module.Finite R M]
    (f : P →ₗ[R] M)
    (h : ∀ m : Ideal R, m.IsMaximal →
      Function.Surjective ((m • (⊤ : Submodule R M)).mkQ ∘ₗ f)) :
    Function.Surjective f := by
  rw [← LinearMap.range_eq_top]
  apply submodule_eq_top_of_all_maximal_fibres
  intro m hm
  rw [sup_comm, ← Submodule.map_mkQ_eq_top, ← LinearMap.range_comp]
  exact LinearMap.range_eq_top_of_surjective _ (h m hm)

/-- A finite algebra is generated by its scalar image if every quotient by
an extended maximal ideal consists of scalar images. This is a statement
about the actual ring quotients `B / mB`, not only their spectra. -/
theorem algebraMap_surjective_of_all_maximal_fibres
    {B : Type*} [CommRing B] [Algebra R B] [Module.Finite R B]
    (h : ∀ m : Ideal R, m.IsMaximal →
      Function.Surjective (algebraMap R (B ⧸ m.map (algebraMap R B)))) :
    Function.Surjective (algebraMap R B) := by
  change Function.Surjective (Algebra.linearMap R B)
  rw [← LinearMap.range_eq_top]
  apply submodule_eq_top_of_all_maximal_fibres
  intro m hm
  apply top_unique
  intro b _
  obtain ⟨r, hr⟩ := h m hm (Ideal.Quotient.mk (m.map (algebraMap R B)) b)
  have hdiff : b - algebraMap R B r ∈ m • (⊤ : Submodule R B) := by
    rw [Ideal.smul_top_eq_map]
    change b - algebraMap R B r ∈ m.map (algebraMap R B)
    apply Ideal.Quotient.eq.mp
    exact hr.symm
  exact Submodule.mem_sup.mpr
    ⟨algebraMap R B r, ⟨r, rfl⟩, b - algebraMap R B r, hdiff, by abel⟩

/-- The subalgebra form of finite-module fibre detection, with its canonical
inclusion as the scalar map. No domain or field hypothesis is required. -/
theorem subalgebra_eq_top_of_all_maximal_fibres
    {S B : Type*} [CommRing S] [CommRing B] [Algebra S B]
    (A : Subalgebra S B) [Module.Finite A B]
    (h : ∀ m : Ideal A, m.IsMaximal →
      Function.Surjective (algebraMap A (B ⧸ m.map (algebraMap A B)))) :
    A = ⊤ := by
  have hs := algebraMap_surjective_of_all_maximal_fibres h
  apply top_unique
  intro b _
  obtain ⟨a, ha⟩ := hs b
  rw [← ha]
  exact a.property

end UnconditionalCounterexample
