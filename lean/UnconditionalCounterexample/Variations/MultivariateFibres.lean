import UnconditionalCounterexample.CurveFibres
import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.LinearAlgebra.Basis.VectorSpace
import Mathlib.RingTheory.Nullstellensatz

/-!
# Tangents in the multivariate generic fibre

For a finite localization extension over a subalgebra, separation of retained
points distinguishes maximal ideals in each fibre. Directional derivatives
of cleared numerators detect the cotangent space there. These are the
fibre and Nakayama steps in the recovery of the localized polynomial ring.
-/

namespace UnconditionalCounterexample.MultivariateFibres

open MvPolynomial

variable {k σ : Type*} [Field k]

/-- The polynomial ideal of an affine point. -/
noncomputable def pointIdeal (u : σ → k) : Ideal (MvPolynomial σ k) := RingHom.ker (eval u)

private theorem sub_eval_mem (u : σ → k) (p : MvPolynomial σ k) :
    p - C (eval u p) ∈ pointIdeal u := by
  change eval u _ = 0
  simp

/-- The evaluation kernel is generated by the translated coordinate variables. -/
theorem pointIdeal_eq_span (u : σ → k) :
    pointIdeal u = Ideal.span (Set.range fun i => X i - C (u i)) := by
  let I : Ideal (MvPolynomial σ k) := Ideal.span (Set.range fun i => X i - C (u i))
  have hgen (i : σ) : X i - C (u i) ∈ I := Ideal.subset_span ⟨i, rfl⟩
  have h (p : MvPolynomial σ k) : p - C (eval u p) ∈ I := by
    induction p using MvPolynomial.induction_on with
    | C c => simp
    | add p q hp hq => simpa [map_add, add_sub_add_comm] using I.add_mem hp hq
    | mul_X p i hp =>
      convert I.add_mem (I.mul_mem_right (X i) hp)
        (I.mul_mem_left (C (eval u p)) (hgen i)) using 1; simp; ring
  apply le_antisymm
  · intro p hp
    change eval u p = 0 at hp
    simpa [hp] using h p
  · apply Ideal.span_le.mpr
    rintro _ ⟨i,rfl⟩
    change eval u _ = 0
    simp

/-- Partial derivatives, evaluated at a point, as a coefficient vector. -/
noncomputable def gradient (u : σ → k) (p : MvPolynomial σ k) : σ → k :=
  fun i => eval u (pderiv i p)

variable [Fintype σ]

/-- A linear form in the coordinates translated to the point. -/
noncomputable def linearPart (u v : σ → k) : MvPolynomial σ k :=
  ∑ i, C (v i) * (X i - C (u i))

private theorem linearPart_add (u v w : σ → k) :
    linearPart u (v+w) = linearPart u v + linearPart u w := by
  simp [linearPart, add_mul, Finset.sum_add_distrib]

private theorem linearPart_smul (u v : σ → k) (c : k) :
    linearPart u (c • v) = C c * linearPart u v := by
  simp [linearPart, Finset.mul_sum, mul_assoc]

private theorem linearPart_single [DecidableEq σ] (u : σ → k) (i : σ) (c : k) :
    linearPart u (Pi.single i c) = C c * (X i - C (u i)) := by
  classical
  simp [linearPart, Pi.single_apply, ite_mul, apply_ite C]

/-- The first-order Taylor formula in the polynomial ring, modulo the
square of the actual point ideal. -/
theorem taylor_mem_pointIdeal_sq (u : σ → k) (p : MvPolynomial σ k) :
    p - C (eval u p) - linearPart u (gradient u p) ∈ pointIdeal u ^ 2 := by
  classical
  let J := pointIdeal u ^ 2
  induction p using MvPolynomial.induction_on with
  | C c => simp [gradient, linearPart]
  | add p q hp hq =>
    have hg : gradient u (p + q) = gradient u p + gradient u q := by ext i; simp [gradient]
    convert J.add_mem hp hq using 1; rw [hg, linearPart_add]; simp; ring
  | mul_X p i hp =>
    have hg : gradient u (p * X i) = u i • gradient u p + Pi.single i (eval u p) := by
      ext j
      by_cases h : j = i
      · subst j; simp [gradient, add_comm]
      · simp [gradient, Ne.symm h]
    have hx : X i - C (u i) ∈ pointIdeal u := by change eval u _ = 0; simp
    have hprod : (p - C (eval u p)) * (X i - C (u i)) ∈ J := by
      dsimp [J]; rw [pow_two]; exact Ideal.mul_mem_mul (sub_eval_mem u p) hx
    convert J.add_mem (J.mul_mem_left (C (u i)) hp) hprod using 1
    rw [hg, linearPart_add, linearPart_smul, linearPart_single]; simp; ring

/-- Testing every direction is equivalent to spanning all coefficient vectors. -/
theorem span_gradients_eq_top (u : σ → k) (S : Set (MvPolynomial σ k))
    (htest : ∀ v : σ → k, v ≠ 0 → ∃ p ∈ S, ∑ i, gradient u p i * v i ≠ 0) :
    Submodule.span k (gradient u '' S) = ⊤ := by
  classical
  by_contra h
  obtain ⟨l, hl, hker⟩ := (Submodule.span k (gradient u '' S)).exists_le_ker_of_lt_top
    (lt_top_iff_ne_top.mpr h)
  let v (i : σ) := l (Pi.single i 1)
  have hrepr (x : σ → k) : l x = ∑ i, x i * v i := by
    have heq : x = ∑ i, x i • Pi.single i (1 : k) := by
      ext j; simp [Finset.sum_apply, Pi.single_apply]
    conv_lhs => rw [heq]
    simp [v]
  have hv : v ≠ 0 := by
    intro heq
    apply hl
    ext x
    simp [hrepr, heq]
  obtain ⟨p, hp, hne⟩ := htest v hv
  exact hne ((hrepr _).symm.trans (hker (Submodule.subset_span ⟨p,hp,rfl⟩)))

section Fibre

variable {B : Type*} [CommRing B] (φ : MvPolynomial σ k →+* B)

/-- In any scalar extension, the mapped point ideal is generated modulo its
square by the images of vanishing polynomials detecting all directions. -/
theorem pointIdeal_le_sup_sq (u : σ → k) (I : Ideal B) (S : Set (MvPolynomial σ k))
    (hS : ∀ p ∈ S, eval u p = 0 ∧ φ p ∈ I)
    (htest : ∀ v : σ → k, v ≠ 0 → ∃ p ∈ S, ∑ i, gradient u p i * v i ≠ 0) :
    (pointIdeal u).map φ ≤ I ⊔ (pointIdeal u).map φ ^ 2 := by
  classical
  let J := I ⊔ (pointIdeal u).map φ ^ 2
  have hlin (w : σ → k) : φ (linearPart u w) ∈ J := by
    have hw : w ∈ Submodule.span k (gradient u '' S) := by rw [span_gradients_eq_top u S htest]; trivial
    induction hw using Submodule.span_induction with
    | mem _ hw =>
      obtain ⟨p, hp, rfl⟩ := hw
      obtain ⟨hz, hi⟩ := hS p hp
      have ht := Ideal.mem_map_of_mem φ (taylor_mem_pointIdeal_sq u p)
      rw [Ideal.map_pow, hz, map_zero, sub_zero, map_sub] at ht
      have ht' : φ p - φ (linearPart u (gradient u p)) ∈ J :=
        (show (pointIdeal u).map φ ^ 2 ≤ J from le_sup_right) ht
      simpa only [sub_sub_cancel] using J.sub_mem (le_sup_left (a := I) hi) ht'
    | zero => simp [linearPart]
    | add v w _ _ hv hw => simpa [linearPart_add] using J.add_mem hv hw
    | smul c v _ hv => simpa [linearPart_smul] using J.mul_mem_left (φ (C c)) hv
  change (pointIdeal u).map φ ≤ J
  rw [pointIdeal_eq_span, Ideal.map_span]
  apply Ideal.span_le.mpr
  rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
  simpa [linearPart_single] using hlin (Pi.single i 1)

/-- Nakayama identifies the fibre ideal with the point ideal if the latter
is the unique maximal ideal containing the fibre. -/
theorem fibre_eq_pointIdeal (u : σ → k) (I : Ideal B) (S : Set (MvPolynomial σ k))
    (hle : I ≤ (pointIdeal u).map φ)
    (hunique : ∀ m : Ideal B, I ≤ m → m.IsMaximal → m = (pointIdeal u).map φ)
    (hS : ∀ p ∈ S, eval u p = 0 ∧ φ p ∈ I)
    (htest : ∀ v : σ → k, v ≠ 0 → ∃ p ∈ S, ∑ i, gradient u p i * v i ≠ 0) :
    I = (pointIdeal u).map φ := by
  let n := (pointIdeal u).map φ
  have hfg : n.FG := by
    dsimp [n]; rw [pointIdeal_eq_span, Ideal.map_span]
    exact Submodule.fg_span ((Set.finite_range _).image _)
  have hjac : n ≤ I.jacobson := by
    apply le_sInf
    rintro m ⟨hm, hmax⟩
    exact (hunique m hm hmax).symm.le
  have htan : n ≤ I ⊔ n • n := by
    simpa only [n, Ideal.smul_eq_mul, pow_two] using pointIdeal_le_sup_sq φ u I S hS htest
  have hh := Submodule.sup_eq_sup_smul_of_le_smul_of_le_jacobson hfg hjac htan
  have hsmall : I • n ≤ I := by rw [Ideal.smul_eq_mul]; exact Ideal.mul_le_left
  exact le_antisymm hle ((show n ≤ I ⊔ n from le_sup_right).trans
    (hh.le.trans (sup_le le_rfl hsmall)))

end Fibre

section Localization

variable (M : Submonoid (MvPolynomial σ k)) (B : Type*) [CommRing B] [Algebra k B]
  [Algebra (MvPolynomial σ k) B] [IsScalarTower k (MvPolynomial σ k) B] [IsLocalization M B]

/-- A point survives the localization when every allowed denominator is nonzero there. -/
def Retained (u : σ → k) : Prop := ∀ f : M, eval u f.val ≠ 0

/-- Evaluate a fraction at a retained point. -/
noncomputable def pointEval (u : σ → k) (hu : Retained M u) : B →ₐ[k] k :=
  IsLocalization.liftAlgHom (f := aeval u) (fun f => isUnit_iff_ne_zero.mpr (hu f))

omit [Fintype σ] in
@[simp] theorem pointEval_polynomial (u : σ → k) (hu : Retained M u) (f : MvPolynomial σ k) :
    pointEval M B u hu (algebraMap (MvPolynomial σ k) B f) = eval u f := by
  simp only [pointEval, IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
  rfl

omit [Fintype σ] in
theorem pointEval_ker_eq_map (u : σ → k) (hu : Retained M u) :
    RingHom.ker (pointEval M B u hu).toRingHom = (pointIdeal u).map (algebraMap _ B) := by
  rw [← IsLocalization.map_under M B (RingHom.ker _)]
  congr 1
  ext p
  change pointEval M B u hu (algebraMap (MvPolynomial σ k) B p) = 0 ↔ eval u p = 0
  rw [pointEval_polynomial]

omit [Fintype σ] in
/-- A retained point on every prime locus disjoint from the denominators gives
all maximal ideals of the *localized* polynomial ring, even with infinitely
many denominators. -/
theorem maximal_eq_pointEval_ker
    (hpoints : ∀ P : Ideal (MvPolynomial σ k), P.IsPrime → Disjoint (M : Set (MvPolynomial σ k)) (P : Set (MvPolynomial σ k)) →
      ∃ u : σ → k, Retained M u ∧ P ≤ pointIdeal u)
    (n : Ideal B) (hn : n.IsMaximal) :
    ∃ u : σ → k, ∃ hu : Retained M u, n = RingHom.ker (pointEval M B u hu).toRingHom := by
  have hp := (IsLocalization.isPrime_iff_isPrime_disjoint M B n).mp hn.isPrime
  obtain ⟨u, hu, hle⟩ := hpoints _ hp.1 hp.2
  refine ⟨u, hu, hn.eq_of_le (RingHom.ker_ne_top _) ?_⟩
  rw [pointEval_ker_eq_map, ← IsLocalization.map_under M B n]
  exact Ideal.map_mono hle

/-- The geometric-fibre step in the recovery of the localized polynomial ring. Finite generation as a
module and existence of retained points on the surviving prime loci are the
two inputs from the preceding recovery arguments. A separating algebra
detecting every tangent direction through cleared numerators then equals
the actual polynomial localization. -/
theorem subalgebra_eq_top_of_separation_and_tangents (A : Subalgebra k B) [Module.Finite A B]
    (hpoints : ∀ P : Ideal (MvPolynomial σ k), P.IsPrime → Disjoint (M : Set (MvPolynomial σ k)) (P : Set (MvPolynomial σ k)) →
      ∃ u : σ → k, Retained M u ∧ P ≤ pointIdeal u)
    (hsep : ∀ u v : σ → k, ∀ hu : Retained M u, ∀ hv : Retained M v, u ≠ v →
      ∃ a : A, pointEval M B u hu a ≠ pointEval M B v hv a)
    (htangent : ∀ u : σ → k, ∀ hu : Retained M u, ∀ v : σ → k, v ≠ 0 →
      ∃ a : A, ∃ p q : MvPolynomial σ k,
        algebraMap (MvPolynomial σ k) B p = algebraMap (MvPolynomial σ k) B q *
          ((a : B) - algebraMap k B (pointEval M B u hu a)) ∧
        ∑ i, gradient u p i * v i ≠ 0) : A = ⊤ := by
  apply subalgebra_eq_top_of_all_maximal_fibres
  intro m hm
  let : m.IsMaximal := hm
  obtain ⟨n, hn, hunder⟩ := Ideal.exists_ideal_over_maximal_of_isIntegral m
    (show RingHom.ker (algebraMap A B) ≤ m from by
      rw [(RingHom.injective_iff_ker_eq_bot _).mp (show Function.Injective (algebraMap A B)
        from Subtype.val_injective)]; exact bot_le)
  obtain ⟨u, hu, rfl⟩ := maximal_eq_pointEval_ker M B hpoints n hn
  let e := pointEval M B u hu
  let I := m.map (algebraMap A B)
  have hle : I ≤ RingHom.ker e.toRingHom := Ideal.map_le_iff_le_comap.mpr hunder.symm.le
  have huniq (n' : Ideal B) (hI : I ≤ n') (hn' : n'.IsMaximal) : n' = RingHom.ker e.toRingHom := by
    obtain ⟨w, hw, hwker⟩ := maximal_eq_pointEval_ker M B hpoints n' hn'
    have hwunder : n'.under A = m := (hm.eq_of_le (Ideal.comap_ne_top _ hn'.ne_top)
      (Ideal.map_le_iff_le_comap.mp hI)).symm
    have he : (pointEval M B w hw).comp A.val = e.comp A.val :=
      CurveFibres.algHom_eq_of_ker_eq _ _ (by
        change (RingHom.ker (pointEval M B w hw).toRingHom).under A = (RingHom.ker e.toRingHom).under A
        rw [← hwker, hwunder]; exact hunder.symm)
    by_cases hw' : w = u
    · subst w; exact hwker
    obtain ⟨a, ha⟩ := hsep w u hw hu hw'
    exact (ha (DFunLike.congr_fun he a)).elim
  let S := {p : MvPolynomial σ k | eval u p = 0 ∧ algebraMap (MvPolynomial σ k) B p ∈ I}
  have htest (v : σ → k) (hv : v ≠ 0) : ∃ p ∈ S, ∑ i, gradient u p i * v i ≠ 0 := by
    obtain ⟨a, p, q, hp, hd⟩ := htangent u hu v hv
    have ha : a - algebraMap k A (e a) ∈ m := by
      rw [← hunder]
      change e ((a : B) - algebraMap k B (e a)) = 0
      simp
    have hI : algebraMap (MvPolynomial σ k) B p ∈ I := by
      rw [hp]
      exact I.mul_mem_left _ (Ideal.mem_map_of_mem _ ha)
    have hz := hle hI
    change pointEval M B u hu (algebraMap (MvPolynomial σ k) B p) = 0 at hz
    exact ⟨p, ⟨(pointEval_polynomial M B u hu p).symm.trans hz, hI⟩, hd⟩
  have hfibre : I = RingHom.ker e.toRingHom := by
    rw [show RingHom.ker e.toRingHom = _ from pointEval_ker_eq_map M B u hu]
    exact fibre_eq_pointIdeal _ u I S (hle.trans_eq (pointEval_ker_eq_map M B u hu))
      (fun n hI hn => (huniq n hI hn).trans (pointEval_ker_eq_map M B u hu))
      (fun _ h => h) htest
  intro z
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
  refine ⟨algebraMap k A (e b), Ideal.Quotient.eq.mpr ?_⟩
  change algebraMap k B (e b) - b ∈ I
  rw [hfibre]
  change e (algebraMap k B (e b) - b) = 0
  simp

/-- The retained-point condition in RECOVER only needs to be scheduled on
positive-dimensional irreducible loci. The Nullstellensatz supplies a
retained point automatically when the disjoint prime is already maximal. -/
theorem retainedPoint_of_prime [IsAlgClosed k]
    (hpoints : ∀ P : Ideal (MvPolynomial σ k), P.IsPrime → ¬ P.IsMaximal →
      Disjoint (M : Set (MvPolynomial σ k)) (P : Set (MvPolynomial σ k)) →
      ∃ u : σ → k, Retained M u ∧ P ≤ pointIdeal u)
    (P : Ideal (MvPolynomial σ k)) (hP : P.IsPrime)
    (hdisj : Disjoint (M : Set (MvPolynomial σ k)) (P : Set (MvPolynomial σ k))) :
    ∃ u : σ → k, Retained M u ∧ P ≤ pointIdeal u := by
  by_cases hm : P.IsMaximal
  · obtain ⟨u, hU⟩ := eq_vanishingIdeal_singleton_of_isMaximal k hm
    have hPu : P = pointIdeal u := by
      rw [hU]; ext p
      exact mem_vanishingIdeal_singleton_iff u p
    refine ⟨u, ?_, hPu.le⟩
    intro q hq
    exact Set.disjoint_left.mp hdisj q.property (hPu ▸ hq)
  · exact hpoints P hP hm hdisj

/-- The numerator of the quotient rule tested in direction `v`. All
occurrences of differentiation below are ordinary formal partials. -/
noncomputable def quotientDerivativeNumerator (u v : σ → k) (p q : MvPolynomial σ k) : k :=
  (∑ i, gradient u p i * v i) * eval u q - eval u p * (∑ i, gradient u q i * v i)

/-- A given fractional representation of a member of the subalgebra with a
nonzero quotient-rule derivative supplies the cleared tangent used in RECOVER. -/
theorem cleared_tangent (u : σ → k) (hu : Retained M u) (v : σ → k)
    (a : B) (p q : MvPolynomial σ k)
    (hfrac : algebraMap (MvPolynomial σ k) B p = a * algebraMap (MvPolynomial σ k) B q)
    (hd : quotientDerivativeNumerator u v p q ≠ 0) :
    ∃ f : MvPolynomial σ k,
      algebraMap (MvPolynomial σ k) B f = algebraMap (MvPolynomial σ k) B q *
        (a - algebraMap k B (pointEval M B u hu a)) ∧ ∑ i, gradient u f i * v i ≠ 0 := by
  let c := pointEval M B u hu a
  have hc : eval u p = c * eval u q := by
    simpa only [map_mul, pointEval_polynomial] using congrArg (pointEval M B u hu) hfrac
  refine ⟨p - C c * q, ?_, ?_⟩
  · rw [map_sub, map_mul, hfrac]
    rw [show algebraMap (MvPolynomial σ k) B (C c) = algebraMap k B c from
      (IsScalarTower.algebraMap_apply k (MvPolynomial σ k) B c).symm]
    dsimp [c]; ring
  · intro hz
    have hgrad (i : σ) : gradient u (p - C c * q) i = gradient u p i - c * gradient u q i := by
      simp [gradient]
    simp_rw [hgrad, sub_mul, mul_assoc] at hz
    rw [Finset.sum_sub_distrib, ← Finset.mul_sum, sub_eq_zero] at hz
    apply hd
    rw [quotientDerivativeNumerator, hc, hz]
    ring

end Localization

end UnconditionalCounterexample.MultivariateFibres
