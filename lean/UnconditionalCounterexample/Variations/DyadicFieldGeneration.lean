import UnconditionalCounterexample.Variations.DyadicLedgerCalendar
import UnconditionalCounterexample.Variations.DyadicIntersections
import UnconditionalCounterexample.PrincipalProfiles

/-! # Extending the calibrated mass equations to the full rational function field -/

noncomputable section
namespace UnconditionalCounterexample.Variations.DyadicLedger.FieldGeneration

open Polynomial GuardSupport Univariate FreezingCalendar PrincipalProfiles

def scalarUnit (q : ℚ) (hq : q ≠ 0) : (RatFunc ℚ)ˣ :=
  Units.mk0 (RatFunc.C q) ((_root_.map_ne_zero _).mpr hq)

def horizontalUnit (f : Horizontal) : (RatFunc ℚ)ˣ :=
  Units.mk0 (factor f) (factor_ne_zero f)

def generatorUnit (D : Driver) (i : ℕ) : (RatFunc ℚ)ˣ :=
  Units.mk0 ((chain D.requirements).generators i) ((chain D.requirements).generators_ne_zero i)

/-- The subgroup generated by scalars, retained horizontals and the actual
normalized generator sequence is the full multiplicative group. The
triangular normalization is inverted on the genuine recursive raws. -/
theorem subgroup_eq_top (D : Driver) (S : Subgroup (RatFunc ℚ)ˣ)
    (constants : ∀ q hq, scalarUnit q hq ∈ S)
    (retained : ∀ f : Horizontal, f.val ∉ Set.range (chain D.requirements).raw → horizontalUnit f ∈ S)
    (normalized : ∀ i, generatorUnit D i ∈ S) : S = ⊤ := by
  let C := chain D.requirements
  let raw (i : ℕ) : (RatFunc ℚ)ˣ := Units.mk0 (algebraMap ℚ[X] (RatFunc ℚ) (C.raw i))
    (RatFunc.algebraMap_ne_zero (C.raw_monic i).ne_zero)
  have hgen (i : ℕ) : generatorUnit D i = raw i / ∏ j ∈ Finset.range i, raw j ^ C.exponent i := by
    apply Units.ext
    simp only [Units.val_div_eq_div_val, Units.coe_prod, Units.val_pow_eq_pow_val, raw, Units.val_mk0]
    rfl
  have hc : Subgroup.closure (Set.range raw) ≤ S := by
    rw [← closure_normalized_eq raw C.exponent]
    apply (Subgroup.closure_le _).mpr
    rintro x ⟨i, rfl⟩
    change raw i / ∏ j ∈ Finset.range i, raw j ^ C.exponent i ∈ S
    rw [← hgen]
    exact normalized i
  have hall (f : Horizontal) : horizontalUnit f ∈ S := by
    by_cases h : f.val ∈ Set.range C.raw
    · obtain ⟨i,he⟩ := h
      have hu : horizontalUnit f = raw i := Units.ext (congrArg (algebraMap ℚ[X] (RatFunc ℚ)) he.symm)
      exact hu ▸ hc (Subgroup.subset_closure (Set.mem_range_self i))
    · exact retained f h
  apply top_unique
  intro u _
  obtain ⟨q,hq,e,he⟩ := exists_signed_factorization u.val u.ne_zero
  have hu : u = scalarUnit q hq * e.prod (fun f z => horizontalUnit f ^ z) := by
    apply Units.ext
    simpa only [scalarUnit, horizontalUnit, Units.val_mul, Finsupp.prod, Units.coe_prod,
      Units.val_zpow_eq_zpow_val, Units.val_mk0, word] using he
  rw [hu]
  exact S.mul_mem (constants q hq) (Submonoid.prod_mem _ fun i _ => S.zpow_mem (hall i) _)

end FieldGeneration
end UnconditionalCounterexample.Variations.DyadicLedger

namespace UnconditionalCounterexample.DyadicDeviations.Profile
open Variations.DyadicLedger.FieldGeneration
variable {J : Bool → Type*} {G H : Type*}

/-- Add all horizontal and vertical values of two profiles. -/
def addProfiles (p q : Profile J G H) : Profile J G H where
  height := p.height + q.height
  plusDeviation := p.plusDeviation + q.plusDeviation
  minusDeviation := p.minusDeviation + q.minusDeviation
  auxiliary := p.auxiliary + q.auxiliary
  guards := ⟨p.guards.plus + q.guards.plus, p.guards.minus + q.guards.minus,
    p.guards.auxiliary + q.guards.auxiliary, p.guards.lone + q.guards.lone⟩
  horizontal := p.horizontal + q.horizontal

theorem signedValues_addProfiles (p q : Profile J G H) (i) :
    (addProfiles p q).signedValues i = p.signedValues i + q.signedValues i := by
  cases i with
  | centre k => rfl
  | plus k n => simp [signedValues, addProfiles, plus]; abel
  | minus k n => simp [signedValues, addProfiles, minus]; abel
  | other i => cases i <;> rfl

theorem signedMass_addProfiles (p q : Profile J G H) (index : (k : Bool) → J k → ℕ)
    (sign : (k : Bool) → J k → ℤ) (k : Bool) :
    (addProfiles p q).signedMass index sign k = p.signedMass index sign k + q.signedMass index sign k := by
  simp only [signedMass, regularMass, addProfiles, Pi.add_apply, map_sub, map_add, Int.cast_add]
  abel

/-- The two mass relations cut out a subgroup whenever the coordinates
are additive valuations of the field units. -/
def massSubgroup {U : Type*} [Group U] (p : U → Profile J G H)
    (val_mul : ∀ x y i, (p (x*y)).signedValues i = (p x).signedValues i + (p y).signedValues i)
    (index : (k : Bool) → J k → ℕ) (sign : (k : Bool) → J k → ℤ) : Subgroup U := by
  let d (x : U) (k : Bool) := (p x).signedMass index sign k - ((p x).height k : ℚ)
  have hadd (x y : U) (k : Bool) : d (x*y) k = d x k + d y k := by
    have he : p (x*y) = addProfiles (p x) (p y) :=
      signedValues_injective (funext fun i => (val_mul x y i).trans (signedValues_addProfiles _ _ i).symm)
    simp only [d, he, signedMass_addProfiles]
    simp only [addProfiles, Pi.add_apply, Int.cast_add]
    abel
  have h1 (k : Bool) : d 1 k = 0 := by simpa using (hadd 1 1 k)
  refine {
    carrier := fun u => (p u).MassEquations index sign
    one_mem' := fun k => sub_eq_zero.mp (h1 k)
    mul_mem' := ?_
    inv_mem' := ?_ }
  · intro x y hx hy k
    apply sub_eq_zero.mp
    exact (hadd x y k).trans (by simp [d,hx k,hy k])
  · intro x hx k
    apply sub_eq_zero.mp
    have hh := hadd x x⁻¹ k
    rw [mul_inv_cancel, h1, show d x k = 0 from sub_eq_zero.mpr (hx k), zero_add] at hh
    exact hh.symm

open Variations.DyadicLedger Variations.FreezingCalendar Variations.Univariate

/-- It suffices to check the physical profiles of retained irreducibles,
scalar field units and the normalized columns of the same selection. -/
theorem mass_all (D : Driver) (p : (RatFunc ℚ)ˣ → Profile J G H)
    (val_mul : ∀ x y i, (p (x*y)).signedValues i = (p x).signedValues i + (p y).signedValues i)
    (index : (k : Bool) → J k → ℕ) (sign : (k : Bool) → J k → ℤ)
    (constants : ∀ q hq, (p (scalarUnit q hq)).MassEquations index sign)
    (retained : ∀ f : Horizontal, f.val ∉ Set.range (chain D.requirements).raw →
      (p (horizontalUnit f)).MassEquations index sign)
    (normalized : ∀ i, (p (generatorUnit D i)).MassEquations index sign)
    (u : (RatFunc ℚ)ˣ) : (p u).MassEquations index sign := by
  let S := massSubgroup p val_mul index sign
  have he := subgroup_eq_top D S constants retained normalized
  change u ∈ S
  rw [he]
  trivial

end UnconditionalCounterexample.DyadicDeviations.Profile
