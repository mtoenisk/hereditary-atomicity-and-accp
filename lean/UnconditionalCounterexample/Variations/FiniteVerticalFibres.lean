import UnconditionalCounterexample.Variations.MultiDomainVerticalResidues
import UnconditionalCounterexample.IntersectionSpectrum
import Mathlib.RingTheory.DiscreteValuationRing.TFAE
import Mathlib.RingTheory.Ideal.Height

/-!
# Vertical stalks with a finite fibre over each rational prime

The ideal generated by a rational prime is the intersection of its finitely
many positive-value centers. Distinct maximal centers in this fibre separate
one branch from all the others. This separation permits division by the
rational uniformizer in the stalk, even when a horizontal unit isolating an
individual branch is unavailable.
-/

noncomputable section

namespace UnconditionalCounterexample.Variations.FiniteVerticalFibres

open WithZero GuardSupport IntersectionStalks IntersectionDomain

variable {K ι : Type*} [Field K] [CharZero K] {B : Subring K} {v : ι → Valuation K ℤᵐ⁰}

/-- The residue characteristic and the finite set of places above each prime. -/
structure Fibres (B : Subring K) (v : ι → Valuation K ℤᵐ⁰) where
  prime : ι → PrimeIndex
  fibre : PrimeIndex → Finset ι
  mem : ∀ p i, i ∈ fibre p ↔ prime i = p
  normalized : ∀ i, v i ((prime i).val : K) = exp (-1)
  inv_mem : ∀ p : PrimeIndex, (p.val : K)⁻¹ ∈ B

namespace Fibres

variable (F : Fibres B v)

private theorem value_le_uniformizer (z : ℤᵐ⁰) (hz : z < 1) : z ≤ exp (-1) := by
  by_cases h : z = 0
  · simp [h]
  have hn : log z < 0 := by rwa [← exp_lt_exp, exp_log h, exp_zero]
  rw [← exp_log h, exp_le_exp]
  omega

omit [CharZero K] in
private theorem off_fibre (p : PrimeIndex) (i : ι) (h : i ∉ F.fibre p) :
    v i (p.val : K) = 1 :=
  MultiDomain.other_prime_value (v i) (F.prime i) p (F.normalized i) (fun he => h ((F.mem p i).mpr he))

/-- The scheme-theoretic fibre of the intersection is reduced at every rational prime. -/
theorem inf_centers_eq (p : PrimeIndex) :
    (F.fibre p).inf (center B v) = Ideal.span ({(p.val : intersection B v)} : Set _) := by
  classical
  apply le_antisymm
  · intro z hz
    rw [Submodule.mem_finsetInf] at hz
    have hp0 : (p.val : K) ≠ 0 := Nat.cast_ne_zero.mpr p.property.ne_zero
    have hquot : (z : K) / p.val ∈ intersection B v := by
      apply (mem_intersection _ _ _).mpr
      refine ⟨by rw [div_eq_mul_inv]; exact B.mul_mem ((mem_intersection _ _ _).mp z.property).1 (F.inv_mem p),?_⟩
      intro i
      rw [map_div₀,div_le_one₀ (pos_iff_ne_zero.mpr ((v i).ne_zero_iff.mpr hp0))]
      by_cases hi : i ∈ F.fibre p
      · rw [← (F.mem p i).mp hi, F.normalized i]
        exact value_le_uniformizer _ ((mem_center B v i z).mp (hz i hi))
      · rw [F.off_fibre p i hi]
        exact ((mem_intersection _ _ _).mp z.property).2 i
    rw [Ideal.mem_span_singleton]
    refine ⟨⟨_,hquot⟩,Subtype.ext ?_⟩
    change (z : K) = p.val * ((z : K) / p.val)
    field_simp
  · rw [Ideal.span_singleton_le_iff_mem,Submodule.mem_finsetInf]
    intro i hi
    rw [mem_center]
    change v i (p.val : K) < 1
    rw [← (F.mem p i).mp hi,F.normalized i,exp_lt_one_iff]
    decide

include F in
/-- A prime meeting the nonzero integers is one of the maximal vertical centers. -/
theorem prime_eq_center (hm : ∀ i, (center B v i).IsMaximal)
    (P : Ideal (intersection B v)) [P.IsPrime]
    (ht : ¬ Disjoint (integerDenominators (intersection B v) : Set (intersection B v)) (P : Set (intersection B v))) :
    ∃ i, P = center B v i := by
  obtain ⟨p,hp,hpP⟩ := IntersectionSpectrum.exists_prime_natCast_mem _ P ht
  let q : PrimeIndex := ⟨p,hp⟩
  have hle : (F.fibre q).inf (center B v) ≤ P := by
    rw [F.inf_centers_eq,Ideal.span_singleton_le_iff_mem]
    exact hpP
  obtain ⟨i,_,hi⟩ := (inferInstance : P.IsPrime).inf_le'.mp hle
  exact ⟨i,((hm i).eq_of_le (inferInstance : P.IsPrime).ne_top hi).symm⟩

omit [CharZero K] in
private theorem separator (hm : ∀ j, (center B v j).IsMaximal) (i : ι)
    (hd : ∀ j, F.prime j = F.prime i → center B v j = center B v i → j = i) :
    ∃ h : intersection B v, v i h = 1 ∧
      ∀ j, F.prime j = F.prime i → j ≠ i → v j h ≤ exp (-1) := by
  classical
  let S := (F.fibre (F.prime i)).erase i
  have hnot : ¬ S.inf (center B v) ≤ center B v i := by
    intro e
    obtain ⟨j,hj,hji⟩ := (center_isPrime B v i).inf_le'.mp e
    obtain ⟨hne,hmem⟩ := Finset.mem_erase.mp hj
    exact hne (hd j ((F.mem _ _).mp hmem) ((hm j).eq_of_le (hm i).ne_top hji))
  obtain ⟨h,hh,hi⟩ := SetLike.not_le_iff_exists.mp hnot
  rw [Submodule.mem_finsetInf] at hh
  rw [mem_center,not_lt] at hi
  refine ⟨h,le_antisymm (((mem_intersection _ _ _).mp h.property).2 i) hi,?_⟩
  intro j hj hne
  exact value_le_uniformizer _ ((mem_center _ _ _ h).mp (hh j (Finset.mem_erase.mpr ⟨hne,(F.mem _ _).mpr hj⟩)))

private theorem clear_at_others (i : ι) (h : intersection B v)
    (hh : ∀ j, F.prime j = F.prime i → j ≠ i → v j h ≤ exp (-1))
    (y : intersection B v) (m : ℕ)
    (hi : v i ((y : K) * ((h : K) / (F.prime i).val)^m) ≤ 1) :
    (y : K) * ((h : K) / (F.prime i).val)^m ∈ intersection B v := by
  apply (mem_intersection _ _ _).mpr
  have hy := (mem_intersection _ _ _).mp y.property
  have hhB := (mem_intersection _ _ _).mp h.property
  refine ⟨B.mul_mem hy.1 (B.pow_mem (by rw [div_eq_mul_inv]; exact B.mul_mem hhB.1 (F.inv_mem _)) _),?_⟩
  intro j
  by_cases hj : j = i
  · simpa [hj] using hi
  have hqp : v j ((F.prime i).val : K) ≠ 0 :=
    (v j).ne_zero_iff.mpr (Nat.cast_ne_zero.mpr (F.prime i).property.ne_zero)
  have hfrac : v j ((h : K) / (F.prime i).val) ≤ 1 := by
    rw [map_div₀, div_le_one₀ (pos_iff_ne_zero.mpr hqp)]
    by_cases he : F.prime j = F.prime i
    · rw [← he,F.normalized]
      exact hh j he hj
    · rw [F.off_fibre _ _ (fun e => he ((F.mem _ _).mp e))]
      exact hhB.2 _
  rw [map_mul,map_pow]
  simpa only [one_mul] using mul_le_mul' (hy.2 j) (pow_le_one₀ zero_le hfrac)

/-- Localization at a separated vertical center is the entire valuation ring. -/
theorem valuation_isLocalization [IsFractionRing (intersection B v) K]
    (hm : ∀ j, (center B v j).IsMaximal) (i : ι)
    (hd : ∀ j, F.prime j = F.prime i → center B v j = center B v i → j = i) :
    IsLocalization (center B v i).primeCompl (v i).valuationSubring := by
  obtain ⟨h,hi,hj⟩ := F.separator hm i hd
  apply (isLocalization_iff _ _).mpr
  refine ⟨?_,?_,?_⟩
  · intro s
    have hs : ¬ v i (s.val : K) < 1 := by
      simpa only [Ideal.mem_primeCompl_iff,mem_center] using s.property
    exact of_not_not fun hu => hs (Valuation.Integer.not_isUnit_iff_valuation_lt_one.mp hu)
  · intro x
    obtain ⟨a,b,hb,he⟩ := IsFractionRing.div_surjective (intersection B v) (x : K)
    have hb0 : (b : K) ≠ 0 := fun e => mem_nonZeroDivisors_iff_ne_zero.mp hb (Subtype.ext e)
    have heq : (x : K) * b = a := by
      rw [← he]
      exact div_mul_cancel₀ _ hb0
    obtain ⟨m,hm⟩ := exists_nat_value (v i) b hb0 (((mem_intersection _ _ _).mp b.property).2 _)
    let t : K := ((h : K) / (F.prime i).val)^m
    have hbt : v i ((b : K) * t) = 1 := by
      dsimp [t]
      rw [map_mul,map_pow,map_div₀,hi,F.normalized,hm,← exp_zero,← exp_sub,← exp_nsmul,← exp_add]
      congr 1
      simp
    have hat : (a : K) * t = (x : K) * ((b : K) * t) := by rw [← heq,mul_assoc]
    let s : intersection B v := ⟨_,F.clear_at_others i h hj b m hbt.le⟩
    have hs : s ∈ (center B v i).primeCompl := by
      rw [Ideal.mem_primeCompl_iff,mem_center]
      change ¬ v i ((b : K) * t) < 1
      simp [hbt]
    have hatv : v i ((a : K) * t) ≤ 1 := by
      rw [hat,map_mul,hbt,mul_one]
      exact x.property
    refine ⟨⟨⟨_,F.clear_at_others i h hj a m hatv⟩,⟨s,hs⟩⟩,Subtype.ext ?_⟩
    exact hat.symm
  · intro a b e
    refine ⟨1,?_⟩
    have he : a = b := Subtype.ext (congrArg (fun z : (v i).valuationSubring => (z : K)) e)
    simp [he]

/-- In the finite separated fibres all primes meeting the integers have height one. -/
theorem vertical_height_one [IsFractionRing (intersection B v) K]
    (hm : ∀ j, (center B v j).IsMaximal)
    (hd : ∀ i j, F.prime j = F.prime i → center B v j = center B v i → j = i)
    (t : PrimeSpectrum (intersection B v))
    (ht : ¬ Disjoint (integerDenominators (intersection B v) : Set (intersection B v)) (t.asIdeal : Set (intersection B v))) :
    Order.height t = 1 := by
  obtain ⟨i,hi⟩ := F.prime_eq_center hm t.asIdeal ht
  let := F.valuation_isLocalization hm i (hd i)
  let := MultiDomain.isDVR_of_prime_value _ (F.normalized i)
  let := IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing
    (IsLocalization.algEquiv (center B v i).primeCompl (v i).valuationSubring
      (Localization.AtPrime (center B v i)))
  have he := (IsLocalization.AtPrime.ringKrullDim_eq_height (center B v i)
    (Localization.AtPrime (center B v i))).symm.trans (IsDiscreteValuationRing.ringKrullDim_eq_one _)
  exact t.height_eq_orderHeight.symm.trans ((congrArg Ideal.height hi).trans (WithBot.coe_injective he))

end Fibres

end UnconditionalCounterexample.Variations.FiniteVerticalFibres
