import UnconditionalCounterexample.Variations.PrivateGuardsDimension
import Mathlib.RingTheory.Polynomial.UniqueFactorization
import Mathlib.Data.Finsupp.Encodable
import Mathlib.Data.Rat.Encodable

/-!
# A countable puncture family with the prescribed generic dimension

For a finite-variable rational polynomial ring, enumerate the height-(d+1)
primes. At each stage the new irreducible avoids the retained prime, all
earlier punctures and the growing list of polynomial tests. Localizing at
this actual sequence, together with any main factors avoiding the retained
prime, has dimension exactly d.
-/

noncomputable section

namespace UnconditionalCounterexample.Variations.PrivateGuards

open MvPolynomial

/-- Each stage can avoid every earlier auxiliary factor as well as the finite
polynomial tests for that stage. The targets may occur with repetition. -/
theorem exists_schedule {A : Type*} [CommRing A] [IsDomain A] [UniqueFactorizationMonoid A]
    [IsNoetherianRing A] [NormalizationMonoid A] (Q : PrimeSpectrum A) (P : ℕ → PrimeSpectrum A)
    (hsmall : ∀ n, Q.asIdeal.height < (P n).asIdeal.height)
    (hlarge : ∀ n, 1 < (P n).asIdeal.height)
    (test : ℕ → A) (ht : ∀ n, test n ≠ 0) :
    ∃ G : ℕ → A, (∀ n, Irreducible (G n) ∧ G n ∈ (P n).asIdeal ∧ G n ∉ Q.asIdeal ∧
      ∀ j ≤ n, ¬ G n ∣ test j) ∧ (∀ n j, j < n → ¬ G n ∣ G j) := by
  classical
  let N := {x : A // x ≠ 0}
  let ok (n : ℕ) (old : (j : ℕ) → j < n → N) (x : N) : Prop :=
    Irreducible x.val ∧ x.val ∈ (P n).asIdeal ∧ x.val ∉ Q.asIdeal ∧
      (∀ j ≤ n, ¬ x.val ∣ test j) ∧ ∀ j (hj : j < n), ¬ x.val ∣ (old j hj).val
  have chooseNext (n : ℕ) (old : (j : ℕ) → j < n → N) : ∃ x, ok n old x := by
    let checked := (Finset.range (n+1)).image test
    let used := Finset.univ.image (fun j : Fin n => (old j j.isLt).val)
    have hn : (P n).asIdeal ≠ ⊥ := by
      intro hb
      simpa [hb] using hlarge n
    obtain ⟨g, hg, hP, hQ, hav⟩ := exists_puncture_avoiding_tests (P n).asIdeal Q.asIdeal
      hn (hsmall n) (hlarge n) (checked ∪ used) (by
        intro f hf
        rcases Finset.mem_union.mp hf with hf | hf
        · obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hf
          exact ht j
        · obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hf
          exact (old j j.isLt).property)
    refine ⟨⟨g, hg.ne_zero⟩, hg, hP, hQ, ?_, ?_⟩
    · exact fun j hj => hav _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _
        (Finset.mem_range.mpr (by omega))))
    · intro j hj
      exact hav _ (Finset.mem_union_right _ (Finset.mem_image.mpr ⟨⟨j,hj⟩,Finset.mem_univ _,rfl⟩))
  choose step hstep using chooseNext
  let G (n : ℕ) : N := Nat.strongRecOn n step
  have hall (n : ℕ) : ok n (fun j _ => G j) (G n) := by
    have heq : G n = step n (fun j _ => G j) := Nat.strongRecOn_eq step n
    exact heq.symm ▸ hstep n (fun j _ => G j)
  exact ⟨fun n => (G n).val, fun n =>
    ⟨(hall n).1, (hall n).2.1, (hall n).2.2.1, (hall n).2.2.2.1⟩, fun n => (hall n).2.2.2.2⟩

private theorem countable_ideals (A : Type*) [CommRing A] [IsNoetherianRing A] [Countable A] :
    Countable (Ideal A) := by
  let f (S : Finset A) := Ideal.span (S : Set A)
  have h : Function.Surjective f := fun I => I.fg_of_isNoetherianRing
  exact h.countable

abbrev PolynomialRing (r : ℕ) := MvPolynomial (Fin r) ℚ

/-- The actual set of poles generated by the main and auxiliary lists. -/
def inverted {A : Type*} [CommMonoid A] (main : Set A) (G : ℕ → A) : Submonoid A :=
  Submonoid.closure (main ∪ Set.range G)

/-- The punctured rational generic fibre exists with all the required
avoidance properties. The proof enumerates the primes of the target height
and constructs the punctures in their chronological order. -/
theorem exists_punctured_fibre {r d : ℕ} (hd : 1 ≤ d) (hr : d < r)
    (c : Fin r → ℚ) (test : ℕ → PolynomialRing r) (ht : ∀ n, test n ≠ 0)
    (main : Set (PolynomialRing r)) (hmain : ∀ f ∈ main, f ∉ (coordinatePrime c d).asIdeal) :
    ∃ G : ℕ → PolynomialRing r,
      (∀ n, Irreducible (G n) ∧ G n ∉ (coordinatePrime c d).asIdeal ∧
        ∀ j ≤ n, ¬ G n ∣ test j) ∧
      (∀ n j, j < n → ¬ G n ∣ G j) ∧
      (∀ P : PrimeSpectrum (PolynomialRing r), P.asIdeal.height = (d+1 : ℕ) →
        ∃ n, G n ∈ P.asIdeal) ∧
      ringKrullDim (Localization (inverted main G)) = d := by
  classical
  let A := PolynomialRing r
  let Q := coordinatePrime c d
  let target := {P : PrimeSpectrum A // P.asIdeal.height = (d+1 : ℕ)}
  let : Nonempty target := ⟨⟨coordinatePrime c (d+1), coordinate_height c _ hr⟩⟩
  let : Countable A := Function.Injective.countable
    (f := fun f : A => AddMonoidAlgebra.coeff f) (fun _ _ h => congrArg AddMonoidAlgebra.ofCoeff h)
  let : Countable (Ideal A) := countable_ideals A
  let : Countable (PrimeSpectrum A) := Function.Injective.countable
    (f := PrimeSpectrum.asIdeal) (fun _ _ h => PrimeSpectrum.ext h)
  obtain ⟨T,hT⟩ := exists_surjective_nat target
  have hQ : Q.asIdeal.height = d := coordinate_height c d hr.le
  let : StrongNormalizationMonoid A := UniqueFactorizationMonoid.strongNormalizationMonoid
  obtain ⟨G, hg, hprev⟩ := exists_schedule Q (fun n => (T n).val)
    (fun n => by rw [(T n).property, hQ]; exact_mod_cast Nat.lt_succ_self d)
    (fun n => by rw [(T n).property]; exact_mod_cast (show 1 < d+1 by omega)) test ht
  have hmeet (P : PrimeSpectrum A) (hP : P.asIdeal.height = (d+1 : ℕ)) : ∃ n, G n ∈ P.asIdeal := by
    obtain ⟨n,hn⟩ := hT ⟨P,hP⟩
    exact ⟨n, by simpa only [hn] using (hg n).2.1⟩
  refine ⟨G, fun n => ⟨(hg n).1, (hg n).2.2⟩, hprev, hmeet, ?_⟩
  let M := inverted main G
  have hret : M ≤ Q.asIdeal.primeCompl := by
    apply Submonoid.closure_le.mpr
    rintro f (hf | ⟨n, rfl⟩)
    · exact hmain _ hf
    · exact (hg n).2.2.1
  apply dimension_eq_of_punctured c d hr.le M (Localization M)
    (Set.disjoint_left.mpr fun _ hx => hret hx)
  intro P hP
  obtain ⟨n,hn⟩ := hmeet P hP
  exact ⟨⟨G n, Submonoid.subset_closure (Or.inr ⟨n,rfl⟩)⟩, hn⟩

end UnconditionalCounterexample.Variations.PrivateGuards
