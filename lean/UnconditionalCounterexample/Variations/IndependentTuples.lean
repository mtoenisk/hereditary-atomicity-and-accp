import Mathlib.RingTheory.AlgebraicIndependent.Adjoin
import Mathlib.RingTheory.AlgebraicIndependent.Transcendental
import UnconditionalCounterexample.EvaluationChoices

/-!
# Independent tuples in prescribed local neighbourhoods

For the primary and guard evaluations, the coordinates must be
algebraically independent over the rationals even after their residues and
finitely many higher digits have been fixed. Each new coordinate avoids all
roots of polynomials over the countable algebra generated by its predecessors.
-/

noncomputable section

namespace UnconditionalCounterexample.Variations.IndependentTuples

/-- The algebraic locus over a countable subring of a field is countable. -/
theorem countable_algebraic {A L : Type*} [CommRing A] [Field L] [Algebra A L]
    [IsDomain A] [FaithfulSMul A L] [Countable A] : (Set.ofPred (IsAlgebraic A : L → Prop)).Countable := by
  have : Countable (Polynomial A) := (Polynomial.toFinsuppIso A).injective.countable
  have heq : Set.ofPred (IsAlgebraic A : L → Prop) = ⋃ f : Polynomial A, f.rootSet L := by
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Polynomial.mem_rootSet]
    rfl
  rw [heq]
  exact Set.countable_iUnion fun f => (f.rootSet_finite L).countable

/-- Prescribing a nonempty open set independently for each coordinate still
allows algebraically independent evaluations in any finite local extension. -/
theorem exists_in_open_boxes (K L : Type*) [NontriviallyNormedField K] [CompleteSpace K]
    [Field L] [Algebra ℚ L] [Module K L] [TopologicalSpace L] [ContinuousAdd L]
    [ContinuousSMul K L] (n : ℕ) (U : Fin n → Set L) (hop : ∀ i, IsOpen (U i))
    (hne : ∀ i, (U i).Nonempty) :
    ∃ x : Fin n → L, AlgebraicIndependent ℚ x ∧ ∀ i, x i ∈ U i := by
  induction n with
  | zero =>
    exact ⟨Fin.elim0, algebraicIndependent_empty_type_iff.mpr (algebraMap ℚ L).injective, fun i => i.elim0⟩
  | succ n ih =>
    obtain ⟨y, hI, hy⟩ := ih (fun i => U i.succ) (fun i => hop i.succ) (fun i => hne i.succ)
    let A := Algebra.adjoin ℚ (Set.range y)
    have : Countable A := hI.aevalEquiv.surjective.countable
    have hd : Dense (Set.ofPred (Transcendental A : L → Prop)) :=
      (countable_algebraic (A := A) (L := L)).dense_compl K
    obtain ⟨a, hUa, ha⟩ := hd.inter_open_nonempty (U 0) (hop 0) (hne 0)
    have hnew := (hI.option_iff_transcendental a).mpr ha
    refine ⟨_, hnew.comp (finSuccEquiv n) (finSuccEquiv n).injective, ?_⟩
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa using hUa
    · simpa using hy j

/-- The whole rational function field embeds at the chosen tuple. -/
def evaluation {n : ℕ} {L : Type*} [Field L] [Algebra ℚ L] (x : Fin n → L)
    (hx : AlgebraicIndependent ℚ x) : FractionRing (MvPolynomial (Fin n) ℚ) →+* L :=
  IsFractionRing.lift (g := (MvPolynomial.aeval x : MvPolynomial (Fin n) ℚ →ₐ[ℚ] L).toRingHom) hx

@[simp] theorem evaluation_variable {n : ℕ} {L : Type*} [Field L] [Algebra ℚ L]
    (x : Fin n → L) (hx : AlgebraicIndependent ℚ x) (i : Fin n) :
    evaluation x hx (algebraMap (MvPolynomial (Fin n) ℚ) _ (MvPolynomial.X i)) = x i := by
  exact (IsFractionRing.lift_algebraMap (K := FractionRing (MvPolynomial (Fin n) ℚ))
    (g := (MvPolynomial.aeval x : MvPolynomial (Fin n) ℚ →ₐ[ℚ] L).toRingHom)
    hx (MvPolynomial.X i)).trans (MvPolynomial.aeval_X _ _)

/-- Independent integral lifts with prescribed residues and arbitrary
coordinatewise precision, also when the number of coordinates is zero. -/
theorem exists_padic_lifts (p n : ℕ) [Fact p.Prime] (c : Fin n → ℤ_[p]) (ε : Fin n → ℝ)
    (hε : ∀ i, 0 < ε i) :
    ∃ a : Fin n → ℤ_[p], AlgebraicIndependent ℚ (fun i => (a i).val) ∧
      ∀ i, PadicInt.toZMod (a i) = PadicInt.toZMod (c i) ∧ ‖(a i).val - (c i).val‖ < ε i := by
  let U (i : Fin n) := Metric.ball (c i).val (min (ε i) 1)
  obtain ⟨x, hx, hclose⟩ := exists_in_open_boxes ℚ_[p] ℚ_[p] n U
    (fun _ => Metric.isOpen_ball) (fun i => ⟨_, Metric.mem_ball_self (lt_min (hε i) zero_lt_one)⟩)
  have hc (i : Fin n) : ‖x i - (c i).val‖ < min (ε i) 1 := by
    simpa only [U, Metric.mem_ball, dist_eq_norm] using hclose i
  have hint (i : Fin n) : ‖x i‖ ≤ 1 := by
    calc
      ‖x i‖ = ‖(x i - (c i).val) + (c i).val‖ := by rw [sub_add_cancel]
      _ ≤ _ := (Padic.nonarchimedean _ _).trans
        (max_le ((hc i).le.trans (min_le_right _ _)) (c i).property)
  refine ⟨fun i => ⟨x i, hint i⟩, hx, fun i => ⟨?_, (hc i).trans_le (min_le_left _ _)⟩⟩
  exact EvaluationChoices.toZMod_eq_of_norm_sub_lt_one p ((hc i).trans_le (min_le_right _ _))

end UnconditionalCounterexample.Variations.IndependentTuples
