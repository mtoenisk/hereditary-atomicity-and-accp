import Mathlib.FieldTheory.RatFunc.IntermediateField

/-!
# Subrings containing the rational-function variable

A unital subring of ℚ(t) containing t contains the embedded integer polynomial ring.
Its fraction field inside ℚ(t) contains ℚ and t and therefore equals ℚ(t).
-/

noncomputable section
namespace UnconditionalCounterexample.RationalFunctionSubring
open Polynomial

variable {R : Type*} [CommRing R] (D : Subring R) {x : R}

/-- Every subring containing an element contains all integer-polynomial values at it. -/
theorem eval₂_int_mem (hx : x ∈ D) (f : ℤ[X]) :
    f.eval₂ (Int.castRingHom R) x ∈ D := by
  induction f using Polynomial.induction_on' with
  | add f g hf hg =>
    simpa only [eval₂_add] using D.add_mem hf hg
  | monomial n z =>
    simpa only [eval₂_monomial, Int.coe_castRingHom] using
      D.mul_mem (intCast_mem D z) (D.pow_mem hx n)

/-- The canonical integer-polynomial embedding obtained by evaluating at the variable. -/
def integerPolynomialMap : ℤ[X] →+* RatFunc ℚ :=
  Polynomial.eval₂RingHom (Int.castRingHom _) RatFunc.X

/-- A subring of `ℚ(t)` containing the variable contains every integer polynomial. -/
theorem integerPolynomialMap_mem (D : Subring (RatFunc ℚ))
    (hX : RatFunc.X ∈ D) (f : ℤ[X]) : integerPolynomialMap f ∈ D :=
  eval₂_int_mem D hX f

/-- The embedded copy of `ℤ[t]` lies in every subring containing `t`. -/
theorem integerPolynomialRange_le (D : Subring (RatFunc ℚ))
    (hX : RatFunc.X ∈ D) : integerPolynomialMap.range ≤ D := by
  rintro _ ⟨f, rfl⟩
  exact integerPolynomialMap_mem D hX f

/-- Integer-polynomial evaluation is the canonical coefficient-extension map. -/
theorem integerPolynomialMap_eq : integerPolynomialMap =
    (algebraMap ℚ[X] (RatFunc ℚ)).comp (Polynomial.mapRingHom (Int.castRingHom ℚ)) := by
  apply Polynomial.ringHom_ext
  · intro z
    simp [integerPolynomialMap]
  · simp [integerPolynomialMap]

/-- The integer-polynomial map is an embedding. -/
theorem integerPolynomialMap_injective : Function.Injective integerPolynomialMap := by
  rw [integerPolynomialMap_eq]
  exact (RatFunc.algebraMap_injective ℚ).comp
    (Polynomial.map_injective (Int.castRingHom ℚ) Int.cast_injective)

/-- The image of `ℤ[t]` is exactly the subring generated by the variable. -/
theorem integerPolynomialRange_eq_closure :
    integerPolynomialMap.range = Subring.closure {RatFunc.X} := by
  apply le_antisymm
  · exact integerPolynomialRange_le _ (Subring.subset_closure (Set.mem_singleton _))
  · apply Subring.closure_le.mpr
    intro x hx
    obtain rfl := Set.mem_singleton_iff.mp hx
    exact ⟨Polynomial.X, by simp [integerPolynomialMap]⟩

/-- The variable and all constants generate the full rational-function field. -/
theorem fieldClosure_eq_top_of_constants {K : Type*} [Field K]
    (D : Subring (RatFunc K)) (hX : RatFunc.X ∈ D)
    (hK : ∀ k : K, algebraMap K (RatFunc K) k ∈ Subfield.closure (D : Set (RatFunc K))) :
    Subfield.closure (D : Set (RatFunc K)) = ⊤ := by
  let F := Subfield.closure (D : Set (RatFunc K))
  let E : IntermediateField K (RatFunc K) := F.toIntermediateField hK
  have hXE : RatFunc.X ∈ E := Subfield.subset_closure hX
  have hle : IntermediateField.adjoin K {RatFunc.X} ≤ E :=
    IntermediateField.adjoin_simple_le_iff.mpr hXE
  have htop : E = ⊤ := top_le_iff.mp
    (by simpa only [RatFunc.adjoin_X (K := K)] using hle)
  apply top_unique
  intro x _hx
  change x ∈ E
  rw [htop]
  trivial

/-- Over `ℚ`, every subring containing the variable generates the full subfield. -/
theorem fieldClosure_eq_top (D : Subring (RatFunc ℚ)) (hX : RatFunc.X ∈ D) :
    Subfield.closure (D : Set (RatFunc ℚ)) = ⊤ := by
  apply fieldClosure_eq_top_of_constants D hX
  intro q
  simp

/-- The canonical inclusion of any subring containing `t` has fraction field `ℚ(t)`. -/
theorem isFractionRing_of_X_mem (D : Subring (RatFunc ℚ)) (hX : RatFunc.X ∈ D) :
    IsFractionRing D (RatFunc ℚ) := by
  apply IsFractionRing.of_field
  intro f
  have hf : f ∈ Subfield.closure (D : Set (RatFunc ℚ)) := by
    rw [fieldClosure_eq_top D hX]
    trivial
  obtain ⟨a, ha, b, hb, hab⟩ := Subfield.mem_closure_iff.mp hf
  rw [Subring.closure_eq] at ha hb
  exact ⟨⟨a, ha⟩, ⟨b, hb⟩, hab.symm⟩

end UnconditionalCounterexample.RationalFunctionSubring
