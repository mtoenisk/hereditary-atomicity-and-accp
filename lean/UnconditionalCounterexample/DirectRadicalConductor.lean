import UnconditionalCounterexample.DirectConductor
import UnconditionalCounterexample.PairedRadicalConductor

/-!
# The paired local conductor by direct Taylor cancellation

Lemma 6.2 computes the conductor at a paired prime.
The polynomial preimage of the actual conductor is generated by powers of the
two surviving linear factors. Integral values force both exponents positive;
the direct Taylor-cancellation theorem excludes every repeated factor. Extending
the polynomial preimage ideal recovers the exact conductor in the localization.

Only the elementary polynomial ideal-factorization helper is reused from the
earlier paired module. This proof does not invoke its CRT/socle conductor theorem,
a localized PID classification, or an identification with the rational-function
field. Scalar clearing, exact initial ideal containment and unbounded actual
first derivatives remain the source theorem's explicit construction inputs.
-/

namespace UnconditionalCounterexample.DirectConductor

open Polynomial LocalizedPolynomialJets RadicalConductor

variable {K A : Type*} [NontriviallyNormedField K] [CommRing A]
  [Algebra K A] [Algebra K[X] A] [IsScalarTower K K[X] A]
  (M : Submonoid K[X]) [IsLocalization M A]

theorem localized_conductor_value_eq_zero
    (a : K) (ha : ∀ m : M, (m : K[X]).eval a ≠ 0)
    (T : Subring A)
    (hvalue : ∀ z ∈ T, ‖(localizedFirstJet M A a ha z).fst‖ ≤ 1)
    (z : A) (hz : z ∈ conductorIdeal T) :
    (localizedFirstJet M A a ha z).fst = 0 := by
  let v : A →ₐ[K] K :=
    { toRingHom := (TrivSqZeroExt.fstHom K K K).toRingHom.comp (localizedFirstJet M A a ha)
      commutes' c := by
        change (localizedFirstJet M A a ha (algebraMap K A c)).fst = c
        rw [localizedFirstJet_scalar]
        rfl }
  exact conductor_le_ker_of_integral_values T v hvalue hz

/-- The direct Taylor cancellation forbids repeated factors in the polynomial
preimage of an actual localized conductor. -/
theorem left_exponent_le_one_direct
    (a b : K) (ha : ∀ m : M, (m : K[X]).eval a ≠ 0)
    (O : Subring K) (hO : ∀ u : K, u ∈ O ↔ ‖u‖ ≤ 1)
    (T : Subring A) (hscalar : ∀ u ∈ O, algebraMap K A u ∈ T)
    (hclear : ∀ y : A, ∃ c : K, c ≠ 0 ∧ algebraMap K A c * y ∈ T)
    (hvalue : ∀ z ∈ T, ‖(localizedFirstJet M A a ha z).fst‖ ≤ 1)
    (hderivative : ∀ N : ℝ, ∃ z ∈ T, N < ‖(localizedFirstJet M A a ha z).snd‖)
    (e d : ℕ)
    (hI : (conductorIdeal T).comap (algebraMap K[X] A) =
      Ideal.span {(X - C a) ^ e * (X - C b) ^ d}) : e ≤ 1 := by
  by_contra he
  have he2 : 2 ≤ e := by omega
  obtain ⟨n, hn⟩ := Nat.exists_eq_add_of_le he2
  have heN : e = n + 2 := by omega
  clear hn
  subst e
  let q : K[X] := (X - C a) ^ n * (X - C b) ^ d
  have hq : q ≠ 0 := mul_ne_zero
    (pow_ne_zero n (Polynomial.prime_X_sub_C a).ne_zero)
    (pow_ne_zero d (Polynomial.prime_X_sub_C b).ne_zero)
  have hpol : q * (X - C a) ^ 2 = (X - C a) ^ (n + 2) * (X - C b) ^ d := by
    dsimp [q]
    rw [pow_add]
    ring
  have hspan : conductorIdeal T =
      Ideal.span {algebraMap K[X] A q * algebraMap K[X] A (X - C a) ^ 2} := by
    rw [← IsLocalization.map_under M A (conductorIdeal T), Ideal.under, hI,
      Ideal.map_span, Set.image_singleton, ← hpol, map_mul, map_pow]
  have hcancel := cancel_localized_square_into_conductor M a ha O hO T hscalar
    (algebraMap K[X] A q) hclear (by
      intro y hy
      exact conductorIdeal_subset T y (hspan.symm ▸ hy)) hvalue hderivative
  have hcancelPoly : q * (X - C a) ∈
      (conductorIdeal T).comap (algebraMap K[X] A) := by
    change algebraMap K[X] A (q * (X - C a)) ∈ conductorIdeal T
    simpa only [map_mul] using hcancel
  have hneq := not_square_generator_of_cancelled_mem
    ((conductorIdeal T).comap (algebraMap K[X] A)) q (X - C a) hq
    (Polynomial.prime_X_sub_C a).ne_zero
    (Polynomial.prime_X_sub_C a).irreducible.not_isUnit hcancelPoly
  apply hneq
  rw [hpol]
  exact hI

/-- Exact paired local conductor equality proved by direct repeated-factor
cancellation. All value and derivative maps are the actual localized jets. -/
theorem localized_conductor_eq_pair_direct
    (O : Subring K) (hO : ∀ u : K, u ∈ O ↔ ‖u‖ ≤ 1)
    (T : Subring A) (a b : K) (hab : a ≠ b)
    (ha : ∀ m : M, (m : K[X]).eval a ≠ 0)
    (hb : ∀ m : M, (m : K[X]).eval b ≠ 0)
    (hscalar : ∀ u ∈ O, algebraMap K A u ∈ T)
    (hclear : ∀ y : A, ∃ c : K, c ≠ 0 ∧ algebraMap K A c * y ∈ T)
    (hvalueA : ∀ z ∈ T, ‖(localizedFirstJet M A a ha z).fst‖ ≤ 1)
    (hvalueB : ∀ z ∈ T, ‖(localizedFirstJet M A b hb z).fst‖ ≤ 1)
    (hderivativeA : ∀ N : ℝ, ∃ z ∈ T, N < ‖(localizedFirstJet M A a ha z).snd‖)
    (hderivativeB : ∀ N : ℝ, ∃ z ∈ T, N < ‖(localizedFirstJet M A b hb z).snd‖)
    (k : ℕ)
    (hpower : ∀ z ∈ Ideal.span
      {algebraMap K[X] A (((X - C a) * (X - C b)) ^ k)}, z ∈ T) :
    conductorIdeal T = Ideal.span {algebraMap K[X] A ((X - C a) * (X - C b))} := by
  let I : Ideal K[X] := (conductorIdeal T).comap (algebraMap K[X] A)
  have hpowermem : ((X - C a) * (X - C b)) ^ k ∈ I := by
    change algebraMap K[X] A (((X - C a) * (X - C b)) ^ k) ∈ conductorIdeal T
    exact (le_conductorIdeal_iff T _).mpr hpower (Ideal.subset_span (by simp))
  obtain ⟨e, _, d, _, hI⟩ := ideal_above_pair_pow_eq I a b k hpowermem
  have he_le := left_exponent_le_one_direct M a b ha O hO T hscalar hclear
    hvalueA hderivativeA e d hI
  have hd_le := left_exponent_le_one_direct M b a hb O hO T hscalar hclear
    hvalueB hderivativeB d e (by simpa only [mul_comm] using hI)
  have hgen : algebraMap K[X] A ((X - C a) ^ e * (X - C b) ^ d) ∈
      conductorIdeal T := by
    change (X - C a) ^ e * (X - C b) ^ d ∈ I
    rw [hI]
    exact Ideal.subset_span (by simp)
  have hzA : ((X - C a) ^ e * (X - C b) ^ d).eval a = 0 := by
    simpa only [localizedFirstJet_algebraMap_fst] using
      localized_conductor_value_eq_zero M a ha T hvalueA _ hgen
  have hzB : ((X - C a) ^ e * (X - C b) ^ d).eval b = 0 := by
    simpa only [localizedFirstJet_algebraMap_fst] using
      localized_conductor_value_eq_zero M b hb T hvalueB _ hgen
  have he_ne : e ≠ 0 := by
    intro he
    simp only [he, pow_zero, one_mul, eval_pow, eval_sub, eval_X, eval_C] at hzA
    exact pow_ne_zero d (sub_ne_zero.mpr hab) hzA
  have hd_ne : d ≠ 0 := by
    intro hd
    simp only [hd, pow_zero, mul_one, eval_pow, eval_sub, eval_X, eval_C] at hzB
    exact pow_ne_zero e (sub_ne_zero.mpr hab.symm) hzB
  have he1 : e = 1 := by omega
  have hd1 : d = 1 := by omega
  simp only [he1, hd1, pow_one] at hI
  rw [← IsLocalization.map_under M A (conductorIdeal T), Ideal.under]
  change I.map (algebraMap K[X] A) = _
  rw [hI, Ideal.map_span, Set.image_singleton]

end UnconditionalCounterexample.DirectConductor
