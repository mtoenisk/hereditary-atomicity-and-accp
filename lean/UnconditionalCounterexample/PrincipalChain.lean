import Factorization.PrincipalIdeals

/-!
# Actual principal chains from nonunit recurrences

The endpoints and ratios must be elements of the ring in question. These
lemmas do not assert that a sequence of rational functions belongs to the
constructed domain; that membership is a separate construction obligation.
-/

namespace UnconditionalCounterexample

universe u

variable {R : Type u} [CommSemiring R] [IsDomain R]

/-- A nonzero recurrence with nonunit ratios gives a strict chain of the
principal ideals generated by the specified endpoints. -/
theorem strictMono_principalIdeals_of_nonunit_recurrence
    (x b : ℕ → R) (hx : ∀ n, x n ≠ 0)
    (hb : ∀ n, ¬ IsUnit (b n))
    (hrec : ∀ n, x n = x (n + 1) * b n) :
    StrictMono (fun n => Ideal.span ({x n} : Set R)) := by
  apply strictMono_nat_of_lt_succ
  intro n
  exact Ideal.span_singleton_lt_span_singleton.mpr
    ⟨hx (n + 1), b n, hb n, hrec n⟩

omit [IsDomain R] in
/-- The same specified recurrence witnesses failure of ACCP. -/
theorem not_wfDvdMonoid_of_nonunit_recurrence
    (x b : ℕ → R) (hx : ∀ n, x n ≠ 0)
    (hb : ∀ n, ¬ IsUnit (b n))
    (hrec : ∀ n, x n = x (n + 1) * b n) :
    ¬ WfDvdMonoid R :=
  Factorization.not_wfDvdMonoid_iff_exists_nonunit_chain.mpr
    ⟨x, b, hx, hb, hrec⟩

omit [IsDomain R] in
/-- Every prefix product of ratios divides the same initial endpoint. -/
theorem initial_eq_endpoint_mul_prefix
    (x b : ℕ → R) (hrec : ∀ n, x n = x (n + 1) * b n) (n : ℕ) :
    x 0 = x n * ∏ i ∈ Finset.range n, b i := by
  induction n with
  | zero => simp
  | succ n ih =>
    calc
      x 0 = x n * ∏ i ∈ Finset.range n, b i := ih
      _ = (x (n + 1) * b n) * ∏ i ∈ Finset.range n, b i := by rw [hrec n]
      _ = x (n + 1) * ((∏ i ∈ Finset.range n, b i) * b n) := by ac_rfl
      _ = x (n + 1) * ∏ i ∈ Finset.range (n + 1), b i := by
        rw [Finset.prod_range_succ]

end UnconditionalCounterexample
