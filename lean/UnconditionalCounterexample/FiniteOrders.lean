import UnconditionalCounterexample.PaperTargets
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.GroupTheory.Index
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Data.ZMod.Basic

/-!
# Finite-index subrings from a diagonal residue quotient

The order ℤ + nD is the inverse image of the diagonal under the residue map D →
(ℤ/nℤ)². Its additive quotient is cyclic, generated by a pair with unit coordinate
difference. Its conductor is the kernel of the residue map. Every subring of index n
contains this order, and equality follows by comparing indices.
-/

namespace UnconditionalCounterexample.FiniteOrders
noncomputable section

section Generic
variable {R : Type*} [CommRing R]

/-- The actual diagonal subring of a product ring. -/
def diagonal : Subring (R × R) where
  carrier := {x | x.1 = x.2}
  zero_mem' := rfl
  one_mem' := rfl
  add_mem' ha hb := congrArg₂ (· + ·) ha hb
  mul_mem' ha hb := congrArg₂ (· * ·) ha hb
  neg_mem' ha := congrArg Neg.neg ha

@[simp] theorem mem_diagonal (x : R × R) : x ∈ diagonal ↔ x.1 = x.2 := Iff.rfl

def difference : R × R →+ R := (AddMonoidHom.snd R R) - (AddMonoidHom.fst R R)

@[simp] theorem difference_apply (x : R × R) : difference x = x.2 - x.1 := rfl

theorem difference_surjective : Function.Surjective (difference (R := R)) :=
  fun x => ⟨(0,x), sub_zero x⟩

theorem difference_ker : (difference (R := R)).ker = (diagonal (R := R)).toAddSubgroup := by
  ext x
  change x.2 - x.1 = 0 ↔ x.1 = x.2
  exact sub_eq_zero.trans eq_comm

/-- The quotient here is additive: the diagonal is usually not an ideal. -/
def diagonalQuotientEquiv : ((R × R) ⧸ (diagonal (R := R)).toAddSubgroup) ≃+ R :=
  (QuotientAddGroup.quotientAddEquivOfEq (difference_ker (R := R)).symm).trans
    (QuotientAddGroup.quotientKerEquivOfSurjective (difference (R := R))
      (difference_surjective (R := R)))

@[simp] theorem diagonalQuotientEquiv_mk (x : R × R) :
    diagonalQuotientEquiv (QuotientAddGroup.mk' (diagonal (R := R)).toAddSubgroup x) =
      difference x := rfl

/-- No nonzero ambient ideal is contained in the diagonal. -/
theorem conductor_diagonal : RadicalConductor.conductorIdeal (diagonal (R := R)) = ⊥ := by
  ext x
  change (∀ y : R × R, (x * y).1 = (x * y).2) ↔ x = 0
  constructor
  · intro h
    have hx := h (1,0)
    have hy := h (0,1)
    apply Prod.ext
    · simpa using hx
    · simpa using hy.symm
  · rintro rfl y
    simp

/-- Reuse the literal integer order in the manuscript acceptance contract. -/
abbrev integerOrder (n : ℕ) : Subring R := PaperTargets.integerOrder R n

@[simp] theorem mem_integerOrder (n : ℕ) (x : R) :
    x ∈ integerOrder n ↔ ∃ z : ℤ, ∃ y : R, x = (z : R) + n * y := Iff.rfl

@[simp] theorem integerOrder_one : integerOrder (R := R) 1 = ⊤ := by
  apply top_unique
  intro x _
  exact ⟨0,x,by simp⟩


theorem index_integerOrder_one : (integerOrder (R := R) 1).toAddSubgroup.index = 1 := by
  rw [integerOrder_one]
  exact AddSubgroup.index_top

theorem integerOrder_one_quotient_subsingleton :
    Subsingleton (R ⧸ (integerOrder (R := R) 1).toAddSubgroup) := by
  rw [integerOrder_one]
  exact QuotientAddGroup.subsingleton_quotient_top

theorem conductor_integerOrder_one :
    RadicalConductor.conductorIdeal (integerOrder (R := R) 1) = ⊤ := by
  rw [integerOrder_one]
  apply top_unique
  intro x _ y
  trivial

/-- Lagrange's theorem kills the additive quotient by its index. -/
theorem integerOrder_le_of_index (T : Subring R) (n : ℕ)
    (hindex : T.toAddSubgroup.index = n) : integerOrder n ≤ T := by
  rintro x ⟨z,y,rfl⟩
  apply T.add_mem (intCast_mem T z)
  have h := T.toAddSubgroup.nsmul_index_mem y
  change (n : R) * y ∈ T.toAddSubgroup
  simpa only [hindex, nsmul_eq_mul] using h

/-- Inclusion and equal positive finite index give equality. -/
theorem subring_eq_of_le_of_index_eq (S T : Subring R) (hST : S ≤ T)
    (hne : S.toAddSubgroup.index ≠ 0)
    (hindex : S.toAddSubgroup.index = T.toAddSubgroup.index) : S = T := by
  have : S.toAddSubgroup.FiniteIndex := ⟨hne⟩
  by_contra hneST
  have hlt : S.toAddSubgroup < T.toAddSubgroup := by
    apply lt_of_le_of_ne hST
    intro heq
    exact hneST (by ext x; exact SetLike.ext_iff.mp heq x)
  have hi := AddSubgroup.index_strictAnti hlt
  omega

theorem eq_integerOrder_of_index_eq (T : Subring R) (n : ℕ) (hn : 0 < n)
    (horder : (integerOrder (R := R) n).toAddSubgroup.index = n)
    (hindex : T.toAddSubgroup.index = n) : T = integerOrder n := by
  exact (subring_eq_of_le_of_index_eq _ _ (integerOrder_le_of_index T n hindex)
    (by omega) (horder.trans hindex.symm)).symm

end Generic

section Residue
variable {A R : Type*} [CommRing A] [CommRing R]

/-- The preimage of the diagonal under a specified residue map. -/
def residueOrder (f : A →+* R × R) : Subring A := diagonal.comap f

def residueDifference (f : A →+* R × R) : A →+ R := difference.comp f.toAddMonoidHom

@[simp] theorem residueDifference_apply (f : A →+* R × R) (x : A) :
    residueDifference f x = (f x).2 - (f x).1 := rfl

theorem residueDifference_ker (f : A →+* R × R) :
    (residueDifference f).ker = (residueOrder f).toAddSubgroup := by
  ext x
  change (f x).2 - (f x).1 = 0 ↔ (f x).1 = (f x).2
  exact sub_eq_zero.trans eq_comm

theorem residueDifference_surjective (f : A →+* R × R) (hf : Function.Surjective f) :
    Function.Surjective (residueDifference f) := difference_surjective.comp hf

def residueQuotientEquiv (f : A →+* R × R) (hf : Function.Surjective f) :
    (A ⧸ (residueOrder f).toAddSubgroup) ≃+ R :=
  (QuotientAddGroup.quotientAddEquivOfEq (residueDifference_ker f).symm).trans
    (QuotientAddGroup.quotientKerEquivOfSurjective (residueDifference f)
      (residueDifference_surjective f hf))

@[simp] theorem residueQuotientEquiv_mk (f : A →+* R × R) (hf : Function.Surjective f) (x : A) :
    residueQuotientEquiv f hf (QuotientAddGroup.mk' (residueOrder f).toAddSubgroup x) =
      residueDifference f x := rfl

theorem conductor_residueOrder (f : A →+* R × R) (hf : Function.Surjective f) :
    RadicalConductor.conductorIdeal (residueOrder f) = RingHom.ker f := by
  ext x
  change (∀ y : A, (f (x*y)).1 = (f (x*y)).2) ↔ f x = 0
  constructor
  · intro h
    have hd : f x ∈ RadicalConductor.conductorIdeal diagonal := by
      intro y
      obtain ⟨z,rfl⟩ := hf y
      change (f x * f z).1 = (f x * f z).2
      simpa only [map_mul] using h z
    rwa [conductor_diagonal, Ideal.mem_bot] at hd
  · intro hx y
    simp [hx]

end Residue

section ZMod
variable {A : Type*} [CommRing A] (n : ℕ)

theorem index_diagonal :
    (diagonal (R := ZMod n)).toAddSubgroup.index = n := by
  rw [AddSubgroup.index_eq_card, Nat.card_congr (diagonalQuotientEquiv (R := ZMod n)).toEquiv, Nat.card_zmod]

theorem index_residueOrder (f : A →+* ZMod n × ZMod n) (hf : Function.Surjective f) :
    (residueOrder f).toAddSubgroup.index = n := by
  rw [AddSubgroup.index_eq_card, Nat.card_congr (residueQuotientEquiv f hf).toEquiv,
    Nat.card_zmod]

/-- A pair with unit difference generates the additive residue quotient. -/
theorem residueQuotient_generated_by_unit_difference
    (f : A →+* ZMod n × ZMod n) (hf : Function.Surjective f) (t : A)
    (ht : IsUnit ((f t).2 - (f t).1)) :
    ∀ x : A ⧸ (residueOrder f).toAddSubgroup,
      ∃ z : ℤ, z • QuotientAddGroup.mk' (residueOrder f).toAddSubgroup t = x := by
  obtain ⟨u,hu⟩ := ht
  intro x
  obtain ⟨z,hz⟩ := ZMod.intCast_surjective (residueQuotientEquiv f hf x * (↑u⁻¹ : ZMod n))
  refine ⟨z,(residueQuotientEquiv f hf).injective ?_⟩
  rw [map_zsmul, residueQuotientEquiv_mk, residueDifference_apply, ← hu, zsmul_eq_mul, hz]
  simp [mul_assoc]

/-- The actual kernel condition identifies Z+nA with the diagonal preimage. -/
theorem integerOrder_eq_residueOrder (f : A →+* ZMod n × ZMod n)
    (hker : RingHom.ker f = Ideal.span {(n : A)}) : integerOrder n = residueOrder f := by
  ext x
  change (∃ z : ℤ, ∃ y : A, x = (z:A) + n*y) ↔ (f x).1 = (f x).2
  constructor
  · rintro ⟨z,y,rfl⟩
    simp
  · intro hx
    obtain ⟨z,hz⟩ := ZMod.intCast_surjective (f x).1
    have hk : x - (z:A) ∈ RingHom.ker f := by
      rw [RingHom.mem_ker, map_sub, sub_eq_zero, map_intCast]
      exact Prod.ext hz.symm (hx.symm.trans hz.symm)
    rw [hker, Ideal.mem_span_singleton] at hk
    obtain ⟨y,hy⟩ := hk
    exact ⟨z,y,by rw [← hy]; ring⟩


/-- The additive quotient of Z+nA for the specified actual residue map. -/
def integerOrderQuotientEquiv (f : A →+* ZMod n × ZMod n) (hf : Function.Surjective f)
    (hker : RingHom.ker f = Ideal.span {(n : A)}) :
    (A ⧸ (integerOrder (R := A) n).toAddSubgroup) ≃+ ZMod n :=
  (QuotientAddGroup.quotientAddEquivOfEq
    (congrArg Subring.toAddSubgroup (integerOrder_eq_residueOrder n f hker))).trans
    (residueQuotientEquiv f hf)

@[simp] theorem integerOrderQuotientEquiv_mk
    (f : A →+* ZMod n × ZMod n) (hf : Function.Surjective f)
    (hker : RingHom.ker f = Ideal.span {(n : A)}) (x : A) :
    integerOrderQuotientEquiv n f hf hker
      (QuotientAddGroup.mk' (integerOrder (R := A) n).toAddSubgroup x) =
      (f x).2 - (f x).1 := rfl

theorem integerOrderQuotient_generated_by_unit_difference
    (f : A →+* ZMod n × ZMod n) (hf : Function.Surjective f)
    (hker : RingHom.ker f = Ideal.span {(n : A)}) (t : A)
    (ht : IsUnit ((f t).2 - (f t).1)) :
    ∀ x : A ⧸ (integerOrder (R := A) n).toAddSubgroup,
      ∃ z : ℤ, z • QuotientAddGroup.mk' (integerOrder (R := A) n).toAddSubgroup t = x := by
  rw [integerOrder_eq_residueOrder n f hker]
  exact residueQuotient_generated_by_unit_difference n f hf t ht

theorem index_integerOrder (f : A →+* ZMod n × ZMod n) (hf : Function.Surjective f)
    (hker : RingHom.ker f = Ideal.span {(n : A)}) :
    (integerOrder (R := A) n).toAddSubgroup.index = n := by
  rw [integerOrder_eq_residueOrder n f hker]
  exact index_residueOrder n f hf

theorem conductor_integerOrder (f : A →+* ZMod n × ZMod n) (hf : Function.Surjective f)
    (hker : RingHom.ker f = Ideal.span {(n : A)}) :
    RadicalConductor.conductorIdeal (integerOrder (R := A) n) = Ideal.span {(n : A)} := by
  rw [integerOrder_eq_residueOrder n f hker, conductor_residueOrder f hf, hker]

/-- The only subring of index n is Z+nA, once the actual residue quotient is supplied. -/
theorem finite_index_subring_eq_integerOrder (hn : 0 < n)
    (f : A →+* ZMod n × ZMod n) (hf : Function.Surjective f)
    (hker : RingHom.ker f = Ideal.span {(n : A)})
    (T : Subring A) (hindex : T.toAddSubgroup.index = n) : T = integerOrder n :=
  eq_integerOrder_of_index_eq T n hn (index_integerOrder n f hf hker) hindex

end ZMod
end
end UnconditionalCounterexample.FiniteOrders
