import Mathlib.Algebra.Order.Group.Basic
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
import Mathlib.Algebra.BigOperators.Group.Multiset.Basic

/-!
# Positive factorizations in arbitrary ordered groups

An ordered subgroup whose positive elements factor into positive
indecomposables is trivial or generated by one positive element. No rank or
Archimedean condition is imposed on the ambient ordered group.
-/

namespace Factorization

universe u

variable {G : Type u} [CommGroup G] [LinearOrder G] [IsOrderedMonoid G]

/-- A positive element of a subgroup that cannot split into two positive
elements of that same subgroup. -/
def PositiveIndecomposable (H : Subgroup G) (g : G) : Prop :=
  g ∈ H ∧ 1 < g ∧
    ∀ a b, a ∈ H → b ∈ H → 1 < a → 1 < b → g ≠ a * b

/-- Every positive element is an exact finite product of positive
indecomposables from the subgroup. -/
def PositiveFactorization (H : Subgroup G) : Prop :=
  ∀ x, x ∈ H → 1 < x → ∃ s : Multiset G,
    (∀ g ∈ s, PositiveIndecomposable H g) ∧ s.prod = x

variable {H : Subgroup G} {g h : G}

/-- Any positive indecomposable is the least positive element of the subgroup. -/
theorem PositiveIndecomposable.le (hg : PositiveIndecomposable H g)
    (hh : h ∈ H) (hpos : 1 < h) : g ≤ h := by
  by_contra hnot
  have hlt : h < g := lt_of_not_ge hnot
  apply hg.2.2 h (g / h) hh (H.div_mem hg.1 hh) hpos (one_lt_div'.mpr hlt)
  simp [div_eq_mul_inv, mul_left_comm]

/-- A subgroup has at most one positive indecomposable. -/
theorem PositiveIndecomposable.eq (hg : PositiveIndecomposable H g)
    (hh : PositiveIndecomposable H h) : g = h :=
  le_antisymm (hg.le hh.1 hh.2.1) (hh.le hg.1 hg.2.1)

/-- Under positive factorization, every positive element is a positive natural
power of any positive indecomposable. The factorization premise is essential:
a least positive element alone need not generate an arbitrary ordered group. -/
theorem PositiveFactorization.exists_pos_pow_eq (hH : PositiveFactorization H)
    (hg : PositiveIndecomposable H g) {x : G} (hx : x ∈ H) (hpos : 1 < x) :
    ∃ n : ℕ, 0 < n ∧ g ^ n = x := by
  obtain ⟨s, hs, hprod⟩ := hH x hx hpos
  have heq : s = Multiset.replicate s.card g :=
    Multiset.eq_replicate_of_mem fun a ha => (hs a ha).eq hg
  refine ⟨s.card, ?_, ?_⟩
  · by_contra hn
    have hzero : s = 0 := Multiset.card_eq_zero.mp (Nat.eq_zero_of_not_pos hn)
    rw [hzero, Multiset.prod_zero] at hprod
    exact (ne_of_gt hpos) hprod.symm
  · rw [heq, Multiset.prod_replicate] at hprod
    exact hprod

omit [IsOrderedMonoid G] in
/-- A positive element supplies a positive indecomposable in any subgroup
with positive factorizations. -/
theorem PositiveFactorization.exists_positiveIndecomposable
    (hH : PositiveFactorization H) {x : G} (hx : x ∈ H) (hpos : 1 < x) :
    ∃ g, PositiveIndecomposable H g := by
  obtain ⟨s, hs, hprod⟩ := hH x hx hpos
  have hnonempty : s ≠ 0 := by
    intro hzero
    rw [hzero, Multiset.prod_zero] at hprod
    exact (ne_of_gt hpos) hprod.symm
  obtain ⟨g, hg⟩ := Multiset.exists_mem_of_ne_zero hnonempty
  exact ⟨g, hs g hg⟩

/-- A positive indecomposable generates the entire subgroup when every
positive element factors into positive indecomposables. -/
theorem PositiveFactorization.eq_zpowers (hH : PositiveFactorization H)
    (hg : PositiveIndecomposable H g) : H = Subgroup.zpowers g := by
  apply le_antisymm
  · intro x hx
    rcases lt_trichotomy x 1 with hlt | rfl | hgt
    · obtain ⟨n, _, hn⟩ :=
        hH.exists_pos_pow_eq hg (H.inv_mem hx) (one_lt_inv'.mpr hlt)
      have hinv : x⁻¹ ∈ Subgroup.zpowers g := by
        rw [← hn]
        exact Subgroup.npow_mem_zpowers g n
      exact (Subgroup.inv_mem_iff (Subgroup.zpowers g)).mp hinv
    · exact (Subgroup.zpowers g).one_mem
    · obtain ⟨n, _, hn⟩ := hH.exists_pos_pow_eq hg hx hgt
      rw [← hn]
      exact Subgroup.npow_mem_zpowers g n
  · exact Subgroup.zpowers_le.mpr hg.1

/-- An ordered subgroup with finite positive factorizations is trivial or
generated by one positive element, without an Archimedean or rank assumption. -/
theorem eq_bot_or_eq_zpowers_of_positiveFactorization
    (hH : PositiveFactorization H) :
    H = ⊥ ∨ ∃ g, 1 < g ∧ H = Subgroup.zpowers g := by
  by_cases hex : ∃ x : G, x ∈ H ∧ 1 < x
  · obtain ⟨x, hx, hpos⟩ := hex
    obtain ⟨g, hg⟩ := hH.exists_positiveIndecomposable hx hpos
    exact Or.inr ⟨g, hg.2.1, hH.eq_zpowers hg⟩
  · left
    apply (Subgroup.eq_bot_iff_forall H).mpr
    intro x hx
    rcases lt_trichotomy x 1 with hlt | heq | hgt
    · exact False.elim (hex ⟨x⁻¹, H.inv_mem hx, one_lt_inv'.mpr hlt⟩)
    · exact heq
    · exact False.elim (hex ⟨x, hx, hgt⟩)

end Factorization
