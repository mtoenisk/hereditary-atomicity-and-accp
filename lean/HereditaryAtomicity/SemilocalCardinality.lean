import HereditaryAtomicity.FieldCardinality
import HereditaryAtomicity.SemilocalArithmetic
import Mathlib.Algebra.CharP.Algebra

/-!
# Countability of semilocal hereditarily atomic fraction fields

The CGH obstruction makes the actual fraction field algebraic over a subfield
generated by one nonintegral unit. Semilocality supplies such a unit by an
inverted prime in characteristic zero or by a nonzero Jacobson element in
positive characteristic.
-/

namespace HereditaryAtomicity

universe u v

/-- A nonintegral unit in an HA domain makes its actual fraction field countable. -/
theorem countable_fractionField_of_nonintegral_unit
    {R : Type u} [CommRing R] [IsDomain R]
    (hR : Factorization.IsHereditarilyAtomic R) (u : Rˣ)
    (hu : ¬ IsIntegral ℤ (u : R))
    (K : Type v) [Field K] [Algebra R K] [IsFractionRing R K] : Countable K := by
  let F : Subfield K := Subfield.closure ({algebraMap R K (u : R)} : Set K)
  have huF : algebraMap R K (u : R) ∈ F :=
    Subfield.subset_closure (Set.mem_singleton _)
  let : Countable F := countable_subfieldClosure_singleton (algebraMap R K (u : R))
  let : Algebra.IsAlgebraic F K := isAlgebraic_fractionField_of_images F K
    (fun x => isAlgebraic_over_subfield_of_nonintegral_unit hR (algebraMap R K)
      (IsFractionRing.injective R K) u hu F huF x)
  exact countable_of_algebraic F K

/-- The actual fraction field of a nonfield semilocal HA domain is countable,
in every characteristic and without a finite-degree hypothesis. -/
theorem countable_fractionField_of_semilocal_hereditarilyAtomic_nonfield
    {R : Type u} [CommRing R] [IsDomain R] [Finite (MaximalSpectrum R)]
    (hR : Factorization.IsHereditarilyAtomic R) (hfield : ¬ IsField R)
    (K : Type v) [Field K] [Algebra R K] [IsFractionRing R K] : Countable K := by
  rcases CharP.exists' R with hchar | ⟨p, hp, hchar⟩
  · let := hchar
    let : CharZero K := charZero_of_injective_algebraMap (IsFractionRing.injective R K)
    obtain ⟨q, hq, hqunit⟩ := exists_prime_isUnit_of_finite_maximalSpectrum R
    exact countable_fractionField_of_nonintegral_unit hR hqunit.unit⁻¹
      (not_isIntegral_inv_prime_unit K hq hqunit) K
  · let := hp
    let := hchar
    let : Algebra (ZMod p) R := ZMod.algebra R p
    obtain ⟨c, hc0, hc⟩ := exists_nonzero_mem_jacobson_of_semilocal_nonfield R hfield
    let u : Rˣ := (isUnit_one_add_of_mem_jacobson hc).unit
    have hu : ¬ IsIntegral ℤ (u : R) := by
      rw [show (u : R) = 1 + c from (isUnit_one_add_of_mem_jacobson hc).unit_spec]
      exact not_isIntegral_int_one_add_of_nonzero_mem_jacobson (ZMod p) hc0 hc
    exact countable_fractionField_of_nonintegral_unit hR u hu K

end HereditaryAtomicity
