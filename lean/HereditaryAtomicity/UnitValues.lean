import HereditaryAtomicity.ValuationUnitSubring
import Mathlib.RingTheory.Localization.FractionRing

/-!
# Valuations of units of a hereditarily atomic domain

Factorizations in the pulled-back valuation ring constrain the subgroup generated by
the values of ambient units. Inversion gives positive indecomposable values, so the
subgroup is trivial or generated by one positive element.
-/

namespace HereditaryAtomicity

universe u v w

variable {R : Type u} {K : Type v} {Γ₀ : Type w}
  [CommRing R] [IsDomain R] [Field K] [LinearOrderedCommGroupWithZero Γ₀]

/-- Atomicity of the actual valuation intersection gives finite positive
factorizations in the image subgroup of all ambient units. -/
theorem valuationUnitSubgroup_positiveFactorization
    (hR : Factorization.IsHereditarilyAtomic R)
    (f : R →+* K) (v : Valuation K Γ₀) :
    Factorization.PositiveFactorization (valuationUnitSubgroup f v) := by
  classical
  intro γ hγ hpos
  obtain ⟨u, rfl⟩ := hγ
  have hinv : valuationUnitMap f v u⁻¹ ≤ 1 := by
    rw [map_inv]
    exact (inv_lt_one'.mpr hpos).le
  let x : valuationSubring f v := ⟨↑u⁻¹, hinv⟩
  have hxu : IsUnit (x : R) := (u⁻¹).isUnit
  have hx0 : x ≠ 0 := by
    intro hx
    exact hxu.ne_zero (congrArg (valuationSubring f v).subtype hx)
  obtain ⟨s, hs, hprod⟩ := hR (valuationSubring f v) x hx0
  have hunit (a : valuationSubring f v) (ha : a ∈ s) : IsUnit (a : R) :=
    ambient_isUnit_of_mem_factorization f v hprod hxu ha
  let lift : {a // a ∈ s} → Rˣ := fun a => (hunit a a.property).unit
  let values : {a // a ∈ s} → Γ₀ˣ := fun a => valuationUnitMap f v (lift a)
  have hlift (a : {a // a ∈ s}) : (lift a : R) = (a.val : R) :=
    (hunit a a.property).unit_spec
  have hvalues : (s.attach.map values).prod = valuationUnitMap f v u⁻¹ := by
    apply Units.ext
    change (Units.coeHom Γ₀) ((s.attach.map values).prod) = v (f (↑u⁻¹ : R))
    rw [map_multiset_prod, Multiset.map_map]
    have hmap : s.attach.map ((Units.coeHom Γ₀) ∘ values) =
        s.map (fun a : valuationSubring f v => v (f a)) := by
      calc
        _ = s.attach.map (fun a => v (f (a.val : R))) := by
          apply Multiset.map_congr rfl
          intro a _
          change v (f (lift a)) = v (f (a.val : R))
          rw [hlift]
        _ = _ := by
          simpa only [Multiset.map_map, Function.comp_apply] using
            congrArg (Multiset.map (fun a : valuationSubring f v => v (f a)))
              (Multiset.attach_map_val s)
    rw [hmap]
    let measurement : valuationSubring f v →* Γ₀ :=
      v.toMonoidHom.comp (f.toMonoidHom.comp (valuationSubring f v).subtype.toMonoidHom)
    change (s.map measurement).prod = v (f (↑u⁻¹ : R))
    rw [Multiset.prod_hom]
    exact valuation_eq_of_associated f v hprod
  refine ⟨s.attach.map (fun a => (values a)⁻¹), ?_, ?_⟩
  · intro a ha
    obtain ⟨b, _, rfl⟩ := Multiset.mem_map.mp ha
    exact atom_inverse_value_indecomposable f v (hs b b.property) (lift b) (hlift b)
  · rw [Multiset.prod_map_inv, hvalues, map_inv, inv_inv]

/-- Every valuation, of any rank, sends the full unit group of a hereditarily
atomic domain to a trivial or positive cyclic subgroup. -/
theorem valuationUnitSubgroup_eq_bot_or_eq_zpowers
    (hR : Factorization.IsHereditarilyAtomic R)
    (f : R →+* K) (v : Valuation K Γ₀) :
    valuationUnitSubgroup f v = ⊥ ∨
      ∃ g : Γ₀ˣ, 1 < g ∧ valuationUnitSubgroup f v = Subgroup.zpowers g :=
  Factorization.eq_bot_or_eq_zpowers_of_positiveFactorization
    (valuationUnitSubgroup_positiveFactorization hR f v)

/-- The subgroup of unit values in a valuation of the fraction field, with arbitrary rank
and center. -/
theorem unit_values_trivial_or_cyclic [Algebra R K] [IsFractionRing R K]
    (hR : Factorization.IsHereditarilyAtomic R) (v : Valuation K Γ₀) :
    (Units.map (v.toMonoidHom.comp (algebraMap R K).toMonoidHom)).range = ⊥ ∨
      ∃ g : Γ₀ˣ, 1 < g ∧
        (Units.map (v.toMonoidHom.comp (algebraMap R K).toMonoidHom)).range =
          Subgroup.zpowers g :=
  valuationUnitSubgroup_eq_bot_or_eq_zpowers hR (algebraMap R K) v

end HereditaryAtomicity
