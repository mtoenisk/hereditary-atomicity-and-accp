import HereditaryAtomicity.SparseRelevantTerms
import HereditaryAtomicity.EmbeddedLocalSubring
import HereditaryAtomicity.SparseProfileSelection

/-!
# Actual conductor cuts generated by high relevant monomials

Taking every uniformly high relevant monomial avoids a synchronized enumeration
of tail generators. A fresh sufficiently small generator divides any finite
selection and keeps every Laurent exponent at least minus one.
-/

open scoped NNReal
noncomputable section
namespace HereditaryAtomicity

variable {K : Type*} [Field K]

namespace SparseLaurentKey

def variableKey (n : ℕ) : SparseLaurentKey := (Finsupp.single n 1,0,0)
def endpoint : SparseLaurentKey := (0,1,0)
def unitIncrement : SparseLaurentKey := (0,0,1)

theorem pure_variable (n : ℕ) : (variableKey n).Pure := by
  classical
  refine ⟨rfl,rfl,?_⟩
  intro j
  by_cases h : n=j <;> simp [variableKey,h]

theorem relevant_endpoint : endpoint.Relevant := by simp [endpoint,Relevant]
theorem relevant_unitIncrement : unitIncrement.Relevant := by simp [unitIncrement,Relevant]

end SparseLaurentKey

@[simp] theorem sparseLaurentMonomial_variable (a : ℕ → Kˣ) (x y : Kˣ) (n : ℕ) :
    sparseLaurentMonomial a x y (.ofAdd (SparseLaurentKey.variableKey n)) = a n := by
  simp [sparseLaurentMonomial,SparseLaurentKey.variableKey]

@[simp] theorem sparseLaurentMonomial_endpoint (a : ℕ → Kˣ) (x y : Kˣ) :
    sparseLaurentMonomial a x y (.ofAdd SparseLaurentKey.endpoint) = x := by
  simp [sparseLaurentMonomial,SparseLaurentKey.endpoint]

@[simp] theorem sparseLaurentMonomial_unitIncrement (a : ℕ → Kˣ) (x y : Kˣ) :
    sparseLaurentMonomial a x y (.ofAdd SparseLaurentKey.unitIncrement) = y := by
  simp [sparseLaurentMonomial,SparseLaurentKey.unitIncrement]

/-- Actual high generators, including all scalar powers with a relevant key. -/
def sparseHighGenerators {ι : Type*} (v : ι → Valuation K ℝ≥0)
    (a : ℕ → Kˣ) (x y : Kˣ) (π : K) (c : ℝ) : Set K :=
  {z | ∃ r:ℕ, ∃ w:SparseLaurentKey, w.Relevant ∧
    z=π^r*sparseLaurentMonomial a x y (.ofAdd w) ∧ ∀ i, c<realValuationOrder (v i) z}

def sparseConductorBase {ι : Type*} (v : ι → Valuation K ℝ≥0)
    (A : Subring K) (a : ℕ → Kˣ) (x y : Kˣ) (π : K) (c : ℝ) : Subring K :=
  Subring.closure ((A : Set K) ∪ Set.range (fun n => (a n : K)) ∪ sparseHighGenerators v a x y π c)

theorem sparseConductorBase_le {ι : Type*} (v : ι → Valuation K ℝ≥0)
    (R A : Subring K) (hA : A ≤ R) (a : ℕ → Kˣ) (ha : ∀ n, (a n:K)∈R)
    (x y : Kˣ) (π : K) (hπ : π≠0) (c : ℝ)
    (hreturn : ∀ z:K, z≠0 → (∀ i, c<realValuationOrder (v i) z) → z∈R) :
    sparseConductorBase v A a x y π c ≤ R := by
  apply Subring.closure_le.mpr
  rintro z ((hz | ⟨n,rfl⟩) | ⟨r,w,_,rfl,hhigh⟩)
  · exact hA hz
  · exact ha n
  · exact hreturn _ (mul_ne_zero (pow_ne_zero _ hπ) (sparseLaurentMonomial_ne_zero a x y w)) hhigh

theorem sparseConductorBase_coefficient {ι : Type*} (v : ι → Valuation K ℝ≥0)
    (A : Subring K) (a : ℕ → Kˣ) (x y : Kˣ) (π : K) (c : ℝ) :
    A ≤ sparseConductorBase v A a x y π c :=
  fun _ h => Subring.subset_closure (Or.inl (Or.inl h))

theorem sparseConductorBase_variable {ι : Type*} (v : ι → Valuation K ℝ≥0)
    (A : Subring K) (a : ℕ → Kˣ) (x y : Kˣ) (π : K) (c : ℝ) (n : ℕ) :
    (a n:K) ∈ sparseConductorBase v A a x y π c :=
  Subring.subset_closure (Or.inl (Or.inr ⟨n,rfl⟩))

theorem sparseConductorBase_high {ι : Type*} (v : ι → Valuation K ℝ≥0)
    (A : Subring K) (a : ℕ → Kˣ) (x y : Kˣ) (π : K) (c : ℝ)
    {z:K} (hz : z∈sparseHighGenerators v a x y π c) :
    z∈sparseConductorBase v A a x y π c :=
  Subring.subset_closure (Or.inr hz)

theorem sparseConductorBase_endpoint {ι : Type*} (v : ι → Valuation K ℝ≥0)
    (A : Subring K) (a : ℕ → Kˣ) (x y : Kˣ) (π : K) (c : ℝ)
    (hx : ∀ i, c<realValuationOrder (v i) x) :
    (x:K)∈sparseConductorBase v A a x y π c := by
  apply sparseConductorBase_high
  exact ⟨0,.endpoint,SparseLaurentKey.relevant_endpoint,by simp,hx⟩

theorem sparseConductorBase_unitIncrement {ι : Type*} (v : ι → Valuation K ℝ≥0)
    (A : Subring K) (a : ℕ → Kˣ) (x y : Kˣ) (π : K) (c : ℝ)
    (hy : ∀ i, c<realValuationOrder (v i) y) :
    (y:K)∈sparseConductorBase v A a x y π c := by
  apply sparseConductorBase_high
  exact ⟨0,.unitIncrement,SparseLaurentKey.relevant_unitIncrement,by simp,hy⟩

/-- Every element has a genuinely collected Laurent polynomial representative
with both high-term conditions. -/
theorem sparseConductorBase_representation {ι : Type*} (v : ι → Valuation K ℝ≥0)
    (R A : Subring K) (hA : A ≤ R)
    (hR : ∀ z∈R, z≠0 → ∀ i, 0≤realValuationOrder (v i) z)
    (a : ℕ → Kˣ) (ha : ∀ n, (a n:K)∈R)
    (x y : Kˣ) (π : A) (hπ : π≠0) (c : ℝ)
    (hreturn : ∀ z:K, z≠0 → (∀ i, c<realValuationOrder (v i) z) → z∈R)
    {z:K} (hz : z∈sparseConductorBase v A a x y π c) :
    ∃ p:AddMonoidAlgebra A SparseLaurentKey,
      SparseCollected v R A a x y c p ∧ sparseLaurentEval A a x y p=z := by
  let Q := sparseCollectedSubring v R A hR a x y c
  let e : Q →+* K := (sparseLaurentEval A a x y).comp Q.subtype
  have H : sparseConductorBase v A a x y π c ≤ e.range := by
    apply Subring.closure_le.mpr
    rintro z ((hz | ⟨n,rfl⟩) | ⟨r,w,hw,rfl,hhigh⟩)
    · let b:A := ⟨z,hz⟩
      have hp : SparseCollected v R A a x y c (AddMonoidAlgebra.single 0 b) := by
        apply SparseCollected.single
        · simpa using hA hz
        · exact fun h => (h SparseLaurentKey.pure_zero).elim
        · exact fun h => (h SparseLaurentKey.pure_zero.relevant).elim
      refine ⟨⟨_,hp⟩,?_⟩
      simp [e,sparseLaurentEval,b]
    · have hp : SparseCollected v R A a x y c
          (AddMonoidAlgebra.single (SparseLaurentKey.variableKey n) 1) := by
        apply SparseCollected.single
        · simpa using ha n
        · exact fun h => (h (SparseLaurentKey.pure_variable n)).elim
        · exact fun h => (h (SparseLaurentKey.pure_variable n).relevant).elim
      refine ⟨⟨_,hp⟩,?_⟩
      simp [e,sparseLaurentEval]
    · have hvalue0 : (π:K)^r*sparseLaurentMonomial a x y (.ofAdd w)≠0 :=
        mul_ne_zero (pow_ne_zero _ (Subtype.coe_ne_coe.mpr hπ)) (sparseLaurentMonomial_ne_zero a x y w)
      have hp : SparseCollected v R A a x y c (AddMonoidAlgebra.single w (π^r)) := by
        apply SparseCollected.single
        · simpa only [Subring.coe_pow] using hreturn _ hvalue0 hhigh
        · intro _
          exact Or.inr (by simpa only [Subring.coe_pow] using hhigh)
        · exact fun h => (h hw).elim
      refine ⟨⟨_,hp⟩,?_⟩
      simp [e,sparseLaurentEval]
  obtain ⟨p,hp⟩ := H hz
  exact ⟨p,p.property,hp⟩

end HereditaryAtomicity
