import HereditaryAtomicity.ArithmeticPruefer
import HereditaryAtomicity.SemilocalArithmetic
import HereditaryAtomicity.IntegralDimension
import HereditaryAtomicity.LocalFiniteGeneration
import Mathlib.Algebra.Algebra.ZMod
import Mathlib.Algebra.Field.ZMod
import Mathlib.Algebra.CharP.Algebra
import Mathlib.RingTheory.KrullDimension.Zero

/-!
# Dimension and Prüfer structure of semilocal hereditarily atomic domains

The arithmetic bases are the integers in characteristic zero, and the actual
polynomial subring generated by a nonzero Jacobson element in positive
characteristic. The normalization need not be finite.
-/

noncomputable section

namespace HereditaryAtomicity

universe u v w

open scoped IntermediateField.algebraAdjoinAdjoin

/-- An actual integral closure in the fraction field still has that fraction field. -/
theorem normalization_isFractionRing
    (R : Type u) [CommRing R] [IsDomain R] (K : Type v) [Field K]
    [Algebra R K] [IsFractionRing R K] : IsFractionRing (integralClosure R K) K := by
  let : Algebra.IsAlgebraic R K := IsLocalization.isAlgebraic K (nonZeroDivisors R)
  exact integralClosure.isFractionRing_of_algebraic
    (fun x hx => (IsFractionRing.injective R K) (by simpa using hx))

/-- In characteristic zero every integrally closed overring of a semilocal HA
domain is Prüfer and has dimension at most one. -/
theorem semilocal_charZero_integrallyClosed_overring_structure
    {R : Type u} [CommRing R] [IsDomain R] [CharZero R]
    [Finite (MaximalSpectrum R)] (hR : Factorization.IsHereditarilyAtomic R)
    (K : Type v) [Field K] [CharZero K] [Algebra R K] [IsFractionRing R K]
    [Algebra ℚ K] (U : Subring K) [IsFractionRing U K] [IsIntegrallyClosed U] :
    IsPrueferDomain U ∧ Ring.KrullDimLE 1 U := by
  let : Algebra.IsAlgebraic ℚ K := semilocal_fractionField_isAlgebraic_rat hR K
  have hZU : ∀ a : ℤ, algebraMap ℤ K a ∈ U := by
    intro a
    simp
  exact ⟨isPrueferDomain_of_integrallyClosed_arithmetic ℤ ℚ K U hZU,
    integrallyClosed_overring_dimensionLEOne_of_arithmetic ℤ ℚ K U hZU⟩

/-- The actual polynomial subring generated by a Jacobson element lies in any
overring of the original coefficient-field algebra. -/
theorem adjoin_jacobson_le_overring
    (k : Type w) [Field k] {R : Type u} [CommRing R] [Algebra k R]
    (K : Type v) [Field K] [Algebra R K] [Algebra k K] [IsScalarTower k R K]
    (U : Subring K) (hRU : ∀ r : R, algebraMap R K r ∈ U) (c : R) :
    (Algebra.adjoin k {algebraMap R K c}).toSubring ≤ U := by
  let B : Subalgebra k K := { U with
    algebraMap_mem' := fun a => by
      rw [IsScalarTower.algebraMap_apply k R K]
      exact hRU (algebraMap k R a) }
  exact (Algebra.adjoin_le (S := B) (Set.singleton_subset_iff.mpr (hRU c)))

/-- A nonzero Jacobson element gives Prüfer structure and dimension at most one
for every integrally closed overring containing the original domain. -/
theorem jacobson_integrallyClosed_overring_structure
    (k : Type w) [Field k] {R : Type u} [CommRing R] [IsDomain R] [Algebra k R]
    (hR : Factorization.IsHereditarilyAtomic R)
    (K : Type v) [Field K] [Algebra R K] [IsFractionRing R K]
    [Algebra k K] [IsScalarTower k R K] {c : R}
    (hc0 : c ≠ 0) (hc : c ∈ Ideal.jacobson (⊥ : Ideal R))
    (U : Subring K) [IsFractionRing U K] [IsIntegrallyClosed U]
    (hRU : ∀ r : R, algebraMap R K r ∈ U) :
    IsPrueferDomain U ∧ Ring.KrullDimLE 1 U := by
  let A := Algebra.adjoin k {algebraMap R K c}
  let F := IntermediateField.adjoin k {algebraMap R K c}
  let : IsPrincipalIdealRing A := adjoin_transcendental_isPrincipalIdealRing k _
    (transcendental_fractionField_jacobson k K hc0 hc)
  let : IsFractionRing A F :=
    IntermediateField.algebraAdjoinAdjoin.instIsFractionRingSubtypeMemSubalgebraAdjoinAdjoin
      k {algebraMap R K c}
  let : Algebra.IsAlgebraic F K := fractionField_isAlgebraic_adjoin_jacobson k hR K hc0 hc
  have hAU : ∀ a : A, algebraMap A K a ∈ U :=
    fun a => adjoin_jacobson_le_overring k K U hRU c a.property
  exact ⟨isPrueferDomain_of_integrallyClosed_arithmetic A F K U hAU,
    integrallyClosed_overring_dimensionLEOne_of_arithmetic A F K U hAU⟩

/-- In characteristic zero a semilocal HA domain has dimension at most one. -/
theorem semilocal_charZero_dimensionLE_one
    {R : Type u} [CommRing R] [IsDomain R] [CharZero R]
    [Finite (MaximalSpectrum R)] (hR : Factorization.IsHereditarilyAtomic R)
    (K : Type v) [Field K] [CharZero K] [Algebra R K] [IsFractionRing R K]
    [Algebra ℚ K] : Ring.KrullDimLE 1 R := by
  let : IsFractionRing (integralClosure R K).toSubring K := normalization_isFractionRing R K
  let : IsIntegrallyClosed (integralClosure R K).toSubring :=
    (isIntegrallyClosed_iff_isIntegrallyClosedIn K).mpr inferInstance
  let : Ring.KrullDimLE 1 (integralClosure R K) :=
    (semilocal_charZero_integrallyClosed_overring_structure hR K
      (integralClosure R K).toSubring).2
  exact krullDimLE_one_of_integralClosure R K (IsFractionRing.injective R K)

/-- A nonzero Jacobson element in a coefficient-field HA algebra forces dimension
at most one, by descent from its entire normalization. -/
theorem jacobson_dimensionLE_one
    (k : Type w) [Field k] {R : Type u} [CommRing R] [IsDomain R] [Algebra k R]
    (hR : Factorization.IsHereditarilyAtomic R)
    (K : Type v) [Field K] [Algebra R K] [IsFractionRing R K]
    [Algebra k K] [IsScalarTower k R K] {c : R}
    (hc0 : c ≠ 0) (hc : c ∈ Ideal.jacobson (⊥ : Ideal R)) : Ring.KrullDimLE 1 R := by
  let : IsFractionRing (integralClosure R K).toSubring K := normalization_isFractionRing R K
  let : IsIntegrallyClosed (integralClosure R K).toSubring :=
    (isIntegrallyClosed_iff_isIntegrallyClosedIn K).mpr inferInstance
  let : Ring.KrullDimLE 1 (integralClosure R K) :=
    (jacobson_integrallyClosed_overring_structure k hR K hc0 hc
      (integralClosure R K).toSubring (integralClosure R K).algebraMap_mem).2
  exact krullDimLE_one_of_integralClosure R K (IsFractionRing.injective R K)

/-- In every characteristic, every integrally closed overring of a semilocal
hereditarily atomic domain is Prüfer and has dimension at most one. -/
theorem semilocal_integrallyClosed_overring_structure
    {R : Type u} [CommRing R] [IsDomain R] [Finite (MaximalSpectrum R)]
    (hR : Factorization.IsHereditarilyAtomic R)
    (K : Type v) [Field K] [Algebra R K] [IsFractionRing R K]
    (U : Subring K) [IsIntegrallyClosed U]
    (hRU : ∀ r : R, algebraMap R K r ∈ U) :
    IsPrueferDomain U ∧ Ring.KrullDimLE 1 U := by
  let : IsFractionRing U K := by
    apply IsFractionRing.of_field
    intro z
    obtain ⟨a, b, _, hz⟩ := IsFractionRing.div_surjective R z
    exact ⟨⟨algebraMap R K a, hRU a⟩, ⟨algebraMap R K b, hRU b⟩, hz.symm⟩
  by_cases hfield : IsField R
  · have hKU : ∀ x : K, algebraMap K K x ∈ U := by
      intro x
      obtain ⟨r, rfl⟩ := (IsFractionRing.surjective_iff_isField (R := R) (K := K)).mpr hfield x
      exact hRU r
    exact ⟨isPrueferDomain_of_integrallyClosed_arithmetic K K K U hKU,
      integrallyClosed_overring_dimensionLEOne_of_arithmetic K K K U hKU⟩
  · rcases CharP.char_is_prime_or_zero R (ringChar R) with hp | hp
    · let : Fact (Nat.Prime (ringChar R)) := ⟨hp⟩
      let : CharP K (ringChar R) := IsFractionRing.charP_of_isFractionRing R (ringChar R)
      let : Algebra (ZMod (ringChar R)) R := ZMod.algebra R (ringChar R)
      let : Algebra (ZMod (ringChar R)) K := ZMod.algebra K (ringChar R)
      obtain ⟨c, hc0, hc⟩ := exists_nonzero_mem_jacobson_of_semilocal_nonfield R hfield
      exact jacobson_integrallyClosed_overring_structure (ZMod (ringChar R)) hR K hc0 hc U hRU
    · let : CharP R 0 := hp ▸ inferInstance
      let : CharZero R := CharP.charP_to_charZero R
      let : CharZero K := IsFractionRing.charZero_of_isFractionRing R
      exact semilocal_charZero_integrallyClosed_overring_structure hR K U

/-- The entire normalization of a semilocal HA domain is a Prüfer domain of
dimension at most one, without finite normalization or degree assumptions. -/
theorem semilocal_normalization_structure
    {R : Type u} [CommRing R] [IsDomain R] [Finite (MaximalSpectrum R)]
    (hR : Factorization.IsHereditarilyAtomic R)
    (K : Type v) [Field K] [Algebra R K] [IsFractionRing R K] :
    IsPrueferDomain (integralClosure R K) ∧ Ring.KrullDimLE 1 (integralClosure R K) := by
  let U := (integralClosure R K).toSubring
  let : IsFractionRing U K := normalization_isFractionRing R K
  let : IsIntegrallyClosed U :=
    (isIntegrallyClosed_iff_isIntegrallyClosedIn K).mpr inferInstance
  exact semilocal_integrallyClosed_overring_structure hR K U
    (integralClosure R K).algebraMap_mem

/-- Every semilocal hereditarily atomic domain has Krull dimension at most one. -/
theorem semilocal_dimensionLE_one
    {R : Type u} [CommRing R] [IsDomain R] [Finite (MaximalSpectrum R)]
    (hR : Factorization.IsHereditarilyAtomic R) : Ring.KrullDimLE 1 R := by
  let : Ring.KrullDimLE 1 (integralClosure R (FractionRing R)) :=
    (semilocal_normalization_structure hR (FractionRing R)).2
  exact krullDimLE_one_of_integralClosure R (FractionRing R)
    (IsFractionRing.injective R (FractionRing R))

/-- A nonfield semilocal hereditarily atomic domain has Krull dimension exactly one. -/
theorem semilocal_dimension_eq_one
    {R : Type u} [CommRing R] [IsDomain R] [Finite (MaximalSpectrum R)]
    (hR : Factorization.IsHereditarilyAtomic R) (hfield : ¬ IsField R) :
    ringKrullDim R = 1 := by
  apply le_antisymm (Ring.krullDimLE_iff.mp (semilocal_dimensionLE_one hR))
  apply (WithBot.one_le_iff_pos _).mpr
  apply lt_of_le_of_ne ringKrullDim_nonneg_of_nontrivial
  intro hzero
  let : Ring.KrullDimLE 0 R := ringKrullDimZero_iff_ringKrullDim_eq_zero.mpr hzero.symm
  exact hfield Ring.KrullDimLE.isField_of_isDomain

/-- A local HA domain with finitely generated maximal ideal is Noetherian. -/
theorem local_ha_isNoetherianRing_of_fg_maximalIdeal
    {R : Type u} [CommRing R] [IsDomain R] [IsLocalRing R]
    (hR : Factorization.IsHereditarilyAtomic R)
    (hfg : (IsLocalRing.maximalIdeal R).FG) : IsNoetherianRing R := by
  let : Ring.KrullDimLE 1 R := semilocal_dimensionLE_one hR
  exact local_isNoetherianRing_of_fg_maximalIdeal hfg

/-- A local HA domain with finitely generated maximal ideal satisfies ACCP. -/
theorem local_ha_wfDvdMonoid_of_fg_maximalIdeal
    {R : Type u} [CommRing R] [IsDomain R] [IsLocalRing R]
    (hR : Factorization.IsHereditarilyAtomic R)
    (hfg : (IsLocalRing.maximalIdeal R).FG) : WfDvdMonoid R := by
  let : Ring.KrullDimLE 1 R := semilocal_dimensionLE_one hR
  exact local_wfDvdMonoid_of_fg_maximalIdeal hfg

end HereditaryAtomicity
