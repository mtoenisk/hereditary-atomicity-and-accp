import HereditaryAtomicity.DVRBase.ModelObstruction
import HereditaryAtomicity.DVRBase.GaussBounds

/-!
# The finite Laurent polynomial model

The statements follow §6 of *Hereditary atomicity and hereditary ACCP in
semilocal domains*. Coordinates are indexed from zero. The Gauss valuation
is written multiplicatively, so an additive lower bound `a` corresponds to
a multiplicative upper bound `exp (-a)`.
-/

noncomputable section
namespace HereditaryAtomicity.Manuscript

open DVRBase
open AddMonoidAlgebra (single)
open scoped BigOperators NNReal

variable {K : Type*} [Field K] {n : ℕ} (v : Valuation K ℝ≥0)

-- Manuscript: lem:V
/-- Lemma 6.2. The function obtained by maximizing the weighted terms is a valuation. -/
theorem gaussValue_isValuation (u : Fin n → ℝ) :
    ∃ w : Valuation (Laurent K n) ℝ≥0, ∀ f, w f = laurentGaussValue v u f :=
  ⟨laurentGaussValuation v u, fun _ => rfl⟩

/-- The initial exponents and coefficient orders add for every subproduct
of a product with a unique initial term. -/
theorem gaussInitial_subproducts (u : Fin n → ℝ) {ι : Type*} (s : Finset ι)
    (f : ι → Laurent K n) (δ : Fin n → ℤ) (h : IsInitialTerm v u (∏ i ∈ s, f i) δ) :
    ∃ β : ι → Fin n → ℤ, (∀ i ∈ s, IsInitialTerm v u (f i) (β i)) ∧
      (∑ i ∈ s, β i) = δ ∧ ∀ t ⊆ s,
        IsInitialTerm v u (∏ i ∈ t, f i) (∑ i ∈ t, β i) ∧
        realValuationOrder v ((∏ i ∈ t, f i).coeff (∑ i ∈ t, β i)) =
          ∑ i ∈ t, realValuationOrder v ((f i).coeff (β i)) := by
  obtain ⟨β, hβ, hsum, _⟩ := h.finset_factor_data s f
  refine ⟨β, hβ, hsum, fun t ht => ?_⟩
  have h' := fun i hi => hβ i (ht hi)
  exact ⟨IsInitialTerm.finset_prod t f β h', IsInitialTerm.finset_coefficientOrder t f β h'⟩

-- Manuscript: lem:MC
/-- An upward-closed class specified on actual nonzero coefficients has an
order-class presentation, even when some real orders do not occur. -/
theorem monomialClass_of_coefficients (C : (Fin n → ℤ) → K → Prop)
    (upward : ∀ β c d, c ≠ 0 → d ≠ 0 → realValuationOrder v c ≤ realValuationOrder v d →
      C β c → C β d) :
    ∃ M : MonomialClass n, ∀ β c, c ≠ 0 → (M.contains β (realValuationOrder v c) ↔ C β c) := by
  let M : MonomialClass n := {
    contains := fun β r => ∃ d, d ≠ 0 ∧ C β d ∧ realValuationOrder v d ≤ r
    upward := by
      rintro β a b hab ⟨d, hd, hC, hle⟩
      exact ⟨d, hd, hC, hle.trans hab⟩
  }
  refine ⟨M, fun β c hc => ⟨?_, fun hC => ⟨c, hc, hC, le_rfl⟩⟩⟩
  rintro ⟨d, hd, hC, hle⟩
  exact upward β d c hd hc hle hC

/-- The additive subgroup generated by the nonzero monomials of a coefficient class. -/
def monomialSpan (M : MonomialClass n) : AddSubgroup (Laurent K n) :=
  AddSubgroup.closure {t | ∃ β c, c ≠ 0 ∧ M.contains β (realValuationOrder v c) ∧
    t = single β c}

/-- Lemma 6.4. The additive span consists exactly of polynomials supported on the class. -/
theorem monomialSpan_eq_supported (M : MonomialClass n) :
    monomialSpan v M = M.supported v := by
  apply le_antisymm
  · apply (AddSubgroup.closure_le _).mpr
    rintro _ ⟨β, c, _, h, rfl⟩
    exact (M.single_mem_supported v β c).mpr (Or.inr h)
  · intro f hf
    rw [← AddMonoidAlgebra.sum_coeff_single f, Finsupp.sum]
    apply AddSubgroup.sum_mem
    intro β hβ
    have hne := Finsupp.mem_support_iff.mp hβ
    exact AddSubgroup.subset_closure ⟨β, f.coeff β, hne, (M.mem_supported v).mp hf β hne, rfl⟩

theorem monomialSpan_iff (M : MonomialClass n) (f : Laurent K n) :
    f ∈ monomialSpan v M ↔ ∀ β, f.coeff β ≠ 0 →
      M.contains β (realValuationOrder v (f.coeff β)) := by
  rw [monomialSpan_eq_supported, MonomialClass.mem_supported]

theorem monomialSpan_union (M N : MonomialClass n) :
    monomialSpan v (M.union N) = monomialSpan v M ⊔ monomialSpan v N := by
  simpa only [monomialSpan_eq_supported] using M.supported_union v N

theorem monomialSpan_translate (M : MonomialClass n) (β : Fin n → ℤ)
    {c : K} (hc : c ≠ 0) (f : Laurent K n) :
    f ∈ monomialSpan v (M.translate β (realValuationOrder v c)) ↔
      ∃ g ∈ monomialSpan v M, single β c * g = f := by
  simpa only [monomialSpan_eq_supported] using M.mem_translate_iff_exists v β hc f

variable (π : K) (hπ0 : π ≠ 0) (hπ : realValuationOrder v π = 1)
variable (P : ModelParameters n)

-- Manuscript: lem:G1
/-- Lemma 6.5(a). The final level equals total order, levels increase, and
level order is superadditive under multiplication of monomials. -/
theorem levels_of_monomials (β γ : Fin n → ℤ) (e e' : ℝ) :
    levelValue P.weights P.kappa e β n = e + ∑ i, (β i : ℝ) * P.weights i ∧
    (∀ k l, k ≤ l → l ≤ n →
      levelValue P.weights P.kappa e β k ≤ levelValue P.weights P.kappa e β l) ∧
    ∀ k ≤ n, levelValue P.weights P.kappa e β k + levelValue P.weights P.kappa e' γ k ≤
      levelValue P.weights P.kappa (e + e') (β + γ) k :=
  ⟨levelValue_top _ _ _ _, fun _ _ hkl hl => levelValue_mono _ _ _ _
    (fun i => (P.weights_pos i).le) (fun k hk => (P.remaining_pos k hk).le) hkl hl,
    fun k hk => levelValue_add_ge _ _ _ _ _ _ _ (P.remaining_pos k hk).le⟩

include hπ0 hπ

/-- Lemma 6.5(b). Test every collected nonzero coefficient at a passing level. -/
theorem modelRing_termwise_levels (f : Laurent K n) :
    f ∈ modelRing v π P ↔ ∀ β, f.coeff β ≠ 0 → ∃ k ≤ n,
      P.thresholds k ≤ levelValue P.weights P.kappa (realValuationOrder v (f.coeff β)) β k := by
  rw [modelRing_eq_supported v π hπ0 hπ, MonomialClass.mem_supportedSubring,
    MonomialClass.mem_supported]
  rfl

/-- Factorization at each prescribed passing level. The head uses only the
first k variables. Its coefficient is integral at k = 0, and its order
meets the high threshold at every positive k. -/
theorem factor_at_passing_level (k : ℕ) (hkn : k ≤ n) (β : Fin n → ℤ) (c : K) (hc : c ≠ 0)
    (hlevel : P.thresholds k ≤ levelValue P.weights P.kappa (realValuationOrder v c) β k) :
    ∃ a : K, a ≠ 0 ∧ SupportedBefore (modelHeadExponent β k) k ∧
      (k = 0 → modelHeadExponent β k = 0 ∧ v a ≤ 1) ∧
      (0 < k → P.thresholds k ≤ termOrder v P.weights (modelHeadExponent β k) a) ∧
      (∀ i, 0 ≤ modelTailExponent β k i) ∧
      (single β c : Laurent K n) = single (modelHeadExponent β k) a *
        terminalMonomial π P.kappa ^ (poleTail β k).toNat * single (modelTailExponent β k) 1 := by
  let d := (poleTail β k).toNat
  let b := (π ^ P.kappa) ^ d
  have hd : (d : ℤ) = poleTail β k := Int.toNat_of_nonneg (poleTail_nonneg β k)
  have hdr : (d : ℝ) = (poleTail β k : ℝ) := by exact_mod_cast hd
  have hb : b ≠ 0 := pow_ne_zero _ (pow_ne_zero _ hπ0)
  have hcb := div_ne_zero hc hb
  have hhead : termOrder v P.weights (modelHeadExponent β k) (c / b) =
      levelValue P.weights P.kappa (realValuationOrder v c) β k := by
    rw [termOrder, realValuationOrder_div v hc hb]
    simp only [b, realValuationOrder_pow, hπ, mul_one, hdr]
    convert modelHeadExponent_order P.weights P.kappa (realValuationOrder v c) β k using 1
    ring
  refine ⟨c / b, hcb, modelHeadExponent_tail β k, ?_, fun _ => hlevel.trans_eq hhead.symm,
    modelTailExponent_nonneg β k, ?_⟩
  · rintro rfl
    refine ⟨modelHeadExponent_zero β, (realValuationOrder_nonneg_iff v hcb).mp ?_⟩
    have h := hlevel.trans_eq hhead.symm
    simpa [termOrder, P.threshold_zero, modelHeadExponent_zero] using h
  · have hpow : (terminalMonomial π P.kappa : Laurent K n) ^ d =
        single (fun _ => -poleTail β k) b := by
      simp only [terminalMonomial, AddMonoidAlgebra.single_pow]
      congr 1
      funext i
      simp [Pi.smul_apply, hd]
    change single β c = single _ (c / b) * terminalMonomial π P.kappa ^ d * single _ 1
    rw [hpow, AddMonoidAlgebra.single_mul_single, AddMonoidAlgebra.single_mul_single,
      modelExponent_decomposition, div_mul_cancel₀ _ hb, mul_one]

omit hπ0 in
theorem modelRing_value_and_endpoints :
    (∀ f ∈ modelRing v π P, (laurentGaussValue v P.weights f : ℝ) ≤ 1) ∧
    ∀ k, endpointMonomial π P.kappa k ∈ modelRing v π P := by
  refine ⟨fun f hf => ?_, fun k => modelJunk_le_modelRing v π P
    (endpointMonomial_mem_modelJunk v π P k)⟩
  simpa using (laurentGaussValue_le_exp_iff v P.weights f 0).mpr
    (modelRing_termOrder_nonneg v π hπ P hf)

-- Manuscript: lem:G2
/-- Lemma 6.6(a). The principal ideal is termwise. Dividing a monomial by
the terminal endpoint subtracts its coefficient and exponent shifts. -/
theorem modelIdeal_terms_and_quotients (f : Laurent K n) (β : Fin n → ℤ) (c : K) (hc : c ≠ 0) :
    (f ∈ modelJunk v π P ↔ ∀ γ, single γ (f.coeff γ) ∈ modelJunk v π P) ∧
    (single β c ∈ modelJunk v π P ↔ single (fun i => β i + 1) (c / π ^ P.kappa) ∈ modelRing v π P) ∧
    (f ∈ modelJunk v π P → (laurentGaussValue v P.weights f : ℝ) ≤
      Real.exp (-remainingValue P.weights P.kappa n)) ∧
    ∀ k, f ∈ modelRing v π P → endpointMonomial π P.kappa k * f ∈ modelJunk v π P := by
  refine ⟨?_, modelJunk_single_div_iff v π hπ0 hπ P β c hc, fun hf =>
    (laurentGaussValue_le_exp_iff _ _ _ _).mpr (modelJunk_termOrder_lower v π hπ0 hπ P hf),
    fun k hf => endpointMonomial_mul_mem_modelJunk v π P k hf⟩
  rw [modelJunk_eq_supported v π hπ0 hπ P]
  exact MonomialClass.mem_supported_iff_single v _ f

theorem nonnegative_monomial_in_ideal (β : Fin n → ℤ) (hβ : ∀ i, 0 ≤ β i)
    (c : K) (hc : c ≠ 0) :
    single β c ∈ modelJunk v π P ↔ ∃ k ≤ n,
      P.thresholds k + remainingValue P.weights P.kappa k ≤
        partialValue P.weights (realValuationOrder v c) β k :=
  modelJunk_single_dead_iff v π hπ0 hπ P β hβ c hc

theorem modelSource_terms (Λ : Finset (Fin n)) (f : Laurent K n) :
    (f ∈ modelSourceRing v π P Λ ↔ ∀ β, single β (f.coeff β) ∈ modelSourceRing v π P Λ) ∧
    (f ∈ modelSourceRing v π P Λ → ∀ β, f.coeff β ≠ 0 →
      single β (f.coeff β) ∈ modelJunk v π P ∨
        (single β (f.coeff β) ∈ modelPolynomialRing v Λ ∧
          ∀ k ≤ n, partialValue P.weights (realValuationOrder v (f.coeff β)) β k <
            P.thresholds k + remainingValue P.weights P.kappa k)) := by
  constructor
  · change f ∈ (modelSourceRing v π P Λ).toAddSubgroup ↔
      ∀ β, single β (f.coeff β) ∈ (modelSourceRing v π P Λ).toAddSubgroup
    rw [modelSourceRing_eq_supported v π hπ0 hπ P]
    exact MonomialClass.mem_supported_iff_single v _ _
  · intro hf β hβ
    by_cases hj : single β (f.coeff β) ∈ modelJunk v π P
    · exact Or.inl hj
    · exact Or.inr ⟨(modelPolynomialRing_single_iff v Λ β _ hβ).mpr
        (modelSourceRing_nonjunk_term v π hπ0 hπ P Λ hf β hβ hj),
        modelSourceRing_nonjunk_term_not_dead v π hπ0 hπ P Λ hf β hβ hj⟩

theorem low_ideal_monomial_shape (β : Fin n → ℤ) (c : K) (hc : c ≠ 0)
    (hm : single β c ∈ modelJunk v π P) (hv : termOrder v P.weights β c < 2 * (P.kappa : ℝ)) :
    (P.kappa : ℝ) ≤ realValuationOrder v c ∧
    (realValuationOrder v c = P.kappa → ∃ a : K, a ≠ 0 ∧ realValuationOrder v a = 0 ∧
      ∃ γ : Fin n → ℤ, (∀ i, 0 ≤ γ i) ∧
        single β c = single 0 a * terminalMonomial π P.kappa * single γ 1) :=
  ⟨modelJunk_low_coefficient v π hπ0 hπ P β c hc hm hv,
   fun he => modelJunk_low_shape v π hπ0 hπ P β c hc hm he hv⟩

-- Manuscript: rem:membership
/-- Corollary 6.7. A change of nonzero coefficient preserving its valuation
preserves membership at the same exponent in all three model objects. -/
theorem modelMembership_of_equal_order (Λ : Finset (Fin n)) (β : Fin n → ℤ)
    {c d : K} (hc : c ≠ 0) (hd : d ≠ 0) (he : realValuationOrder v c = realValuationOrder v d) :
    (single β c ∈ modelRing v π P ↔ single β d ∈ modelRing v π P) ∧
    (single β c ∈ modelJunk v π P ↔ single β d ∈ modelJunk v π P) ∧
    (single β c ∈ modelSourceRing v π P Λ ↔ single β d ∈ modelSourceRing v π P Λ) := by
  refine ⟨?_, ?_, ?_⟩
  · rw [modelRing_single_iff v π hπ0 hπ P β c hc, modelRing_single_iff v π hπ0 hπ P β d hd, he]
  · rw [modelJunk_single_iff v π hπ0 hπ P β c hc, modelJunk_single_iff v π hπ0 hπ P β d hd, he]
  · change single β c ∈ (modelSourceRing v π P Λ).toAddSubgroup ↔
      single β d ∈ (modelSourceRing v π P Λ).toAddSubgroup
    rw [modelSourceRing_eq_supported v π hπ0 hπ P, MonomialClass.single_mem_supported,
      MonomialClass.single_mem_supported, or_iff_right hc, or_iff_right hd, he]

-- Manuscript: lem:G3
/-- Lemma 6.8(a). The sharp ring and the translated-test ring both extend the
model ring, and the specified monomial takes the latter into the model ring. -/
theorem model_translation_rings (B : Finset (Fin n)) :
    modelRing v π P ≤ modelSharpRing v π hπ0 hπ P ∧
    modelRing v π P ≤ modelNearJunkRing v π hπ0 hπ P B ∧
    ∀ f ∈ modelNearJunkRing v π hπ0 hπ P B, maskMonomial B * f ∈ modelRing v π P :=
  ⟨fun _ hf => AddSubgroup.mem_sup_left hf, modelRing_le_modelNearJunkRing v π hπ0 hπ P B,
    fun _ hf => modelNearJunk_mul_mem_modelRing v π hπ0 hπ P B hf⟩

/-- The square of the actual high-generator ideal survives division by the
square of the scalar π^κ. -/
theorem square_high_ideal_after_scaling (f : modelRing v π P)
    (hf : f ∈ modelHighIdeal v π P ^ 2) :
    (single 0 (π ^ P.kappa)⁻¹ : Laurent K n) ^ 2 * f.val ∈ modelHighPart v π P := by
  rw [pow_two] at hf
  let a : Laurent K n := single 0 (π ^ P.kappa)⁻¹
  change a ^ 2 * f.val ∈ _
  refine Submodule.mul_induction_on (C := fun x : modelRing v π P =>
    a ^ 2 * x.val ∈ modelHighPart v π P) hf ?_ ?_
  · intro x hx y hy
    have hs (z : modelRing v π P) (hz : z ∈ modelHighIdeal v π P) :
        a * z.val ∈ modelScaledHigh v π P := ⟨z.val, ⟨z, hz, rfl⟩, rfl⟩
    have hp := modelScaledHigh_mul_mem_high v π hπ0 hπ P (hs x hx) (hs y hy)
    convert hp using 1
    push_cast
    ring
  · intro x y hx hy
    simpa only [Subring.coe_add, mul_add] using (modelHighPart v π P).add_mem hx hy

theorem disjoint_translated_tests (A B : Finset (Fin n)) (hab : Disjoint A B)
    (hn : 0 < n) (ha : (⟨0, hn⟩ : Fin n) ∉ A) (hb : (⟨0, hn⟩ : Fin n) ∉ B)
    {f : Laurent K n} (hA : maskMonomial A * f ∈ modelRing v π P)
    (hB : maskMonomial B * f ∈ modelRing v π P) :
    f ∈ modelNearJunkRing v π hπ0 hπ P B :=
  modelNearJunk_of_disjoint_masks v π hπ0 hπ P A B hab hn ha hb hA hB

-- Manuscript: thm:F
/-- Theorem 6.9. An actual factor in the model ideal occurs in each
factorization of Z₁(1+h) with h in that ideal. -/
theorem factor_in_model_ideal (hn : 0 < n) (Λ : Finset (Fin n))
    (hΛ : 2 * ∑ i ∈ Λ.filter (fun i => 0 < i.val), P.weights i ≤ remainingValue P.weights P.kappa 1)
    {ι : Type*} (s : Finset ι) (f : ι → Laurent K n)
    (hf : ∀ i ∈ s, f i ∈ modelSourceRing v π P Λ) {h : Laurent K n} (hh : h ∈ modelJunk v π P)
    (heq : (∏ i ∈ s, f i) = endpointMonomial π P.kappa 1 * (1 + h)) :
    ∃ i ∈ s, f i ∈ modelJunk v π P := by
  classical
  by_contra! hnone
  exact model_factorization_obstruction v π hπ0 hπ P hn Λ hΛ s f hf hnone hh heq

end HereditaryAtomicity.Manuscript
