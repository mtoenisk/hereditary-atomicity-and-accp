/-!
# Evaluation on the selected blocks and descent to all subrings

Statements of §§7 and 9–11 of *Hereditary atomicity and hereditary ACCP in
semilocal domains*. Each fraction field of a subring in a field is identified
with the subfield generated by the subring.
-/

noncomputable section
namespace HereditaryAtomicity.Manuscript

open DVRBase
open scoped NNReal

variable {K : Type*} [Field K]

-- Manuscript: lem:Rclaim
/-- The source ring lies in both ambient rings, its endpoint union is an
ideal, and the selected subring contains the prescribed coefficients. -/
theorem source_rings_and_endpoint_ideal {A : Subring K} (D : SourceBlockData A)
    (O : Subring K) (hOA : O ≤ A) (hO : ∀ a : O, D.valuation (a : K) ≤ 1)
    (Λ : Set ℕ) :
    D.sourceRing O ≤ A ⊓ D.valuation.valuationSubring.toSubring ∧
    (∀ x : D.sourceRing O, x ∈ D.sourceIdeal O ↔
      ∃ n : ℕ, 1 ≤ n ∧ ∃ q : D.sourceRing O, x = D.ringEndpoint O n * q) ∧
    O ≤ D.sourceSubring O Λ ∧
    D.sourceSubring O Λ ≤ A ⊓ D.valuation.valuationSubring.toSubring := by
  have hR : D.sourceRing O ≤ A ⊓ D.valuation.valuationSubring.toSubring :=
    le_inf (D.sourceRing_le O hOA) (fun x hx => D.sourceRing_bounded O hO ⟨x, hx⟩)
  exact ⟨hR, fun x => mem_chainIdeal_iff_exists_ge _ _ (D.ring_step O) x 1,
    D.coefficient_le_sourceSubring O Λ, (D.sourceSubring_le_sourceRing O Λ).trans hR⟩

-- Manuscript: lem:N
/-- An ordinary polynomial in the model ideal evaluates into the actual
endpoint ideal. The two coefficient/support conditions express membership in
the polynomial ring over the given DVR inside the Laurent polynomial ring. -/
theorem evaluation_of_polynomial_in_model_ideal {A : Subring K} (D : SourceBlockData A)
    (O : Subring K) [IsDiscreteValuationRing O] (π : O) (hπirr : Irreducible π)
    (hπ : (π : K) = (D.uniformizer : K)) (hO : ∀ a : O, D.valuation (a : K) ≤ 1)
    {n : ℕ} (p : Laurent (FractionRing O) n)
    (hcoeff : ∀ β, p.coeff β ≠ 0 → ∃ c : O, algebraMap O (FractionRing O) c = p.coeff β)
    (hdegree : ∀ β, p.coeff β ≠ 0 → ∀ i, 0 ≤ β i)
    (hp : let f := algebraMap (FractionRing O) (D.CanonicalCoefficientField O)
      laurentMap f n p ∈ modelJunk (completionValuation (coefficientFractionValuation O D.valuation))
        (f (algebraMap O (FractionRing O) π)) (D.modelParameters n)) :
    D.evaluation O n p ∈ (D.sourceIdeal O).toAddSubgroup.map
      (D.sourceRing O).subtype.toAddMonoidHom := by
  let v := coefficientFractionValuation O D.valuation
  let f := algebraMap (FractionRing O) (D.CanonicalCoefficientField O)
  have hmem := (laurentMap_mem_modelJunk_iff f v (completionValuation v)
    (completionValuation_algebraMap v) _ (D.coefficientUniformizer_ne_zero O π hπ)
    (D.coefficientUniformizer_order O π hπ) (D.modelParameters n) p).mp hp
  obtain ⟨x, hx, hxe⟩ :=
    D.exists_sourceIdeal_evaluation_of_mem_modelJunk O π hπirr hπ hO p hcoeff hdegree hmem
  exact ⟨x, hx, hxe⟩

-- Manuscript: lem:X
/-- For the blocks with the basis bounds and degree growth of §§4–5, the finite
representative ring lies in the model ring and its evaluation kernel lies in
the first endpoint times the model ideal. -/
theorem finite_model_and_evaluation_kernel {A : Subring K} (D : SourceBlockData A)
    (O : Subring K) [Algebra.IsAlgebraic O K] (π : O)
    (hπ : (π : K) = (D.uniformizer : K)) (hO : ∀ a : O, D.valuation (a : K) ≤ 1)
    (hgrowth : D.CanonicalGrowth O) (n : ℕ) (hn : 0 < n) :
    let v := coefficientFractionValuation O D.valuation
    let f := algebraMap (FractionRing O) (D.CanonicalCoefficientField O)
    let t := f (algebraMap O (FractionRing O) π)
    ∀ p ∈ D.formalRing O π n,
      laurentMap f n p ∈ modelRing (completionValuation v) t (D.modelParameters n) ∧
      (D.evaluation O n p = 0 →
        laurentMap f n p ∈ modelKernelJunk (completionValuation v) t (D.modelParameters n)) := by
  let v := coefficientFractionValuation O D.valuation
  let f := algebraMap (FractionRing O) (D.CanonicalCoefficientField O)
  dsimp only
  intro p hp
  have hπ0 := D.coefficientUniformizer_ne_zero O π hπ
  have hord := D.coefficientUniformizer_order O π hπ
  exact ⟨(laurentMap_mem_modelRing_iff f v _ (completionValuation_algebraMap v)
      _ hπ0 hord _ p).mpr (D.formalRing_le_modelRing O π hπ hO n hp),
    fun hz => (laurentMap_mem_modelKernelJunk_iff f v _ (completionValuation_algebraMap v)
      _ hπ0 hord _ p).mpr (D.source_kernel_mem_of_canonicalGrowth O π hπ hO hgrowth n hn p hp hz)⟩

-- Manuscript: prop:semilocal-witness
attribute [local instance] FractionRing.liftAlgebra in
/-- A chain in a maximal localization with a DVR base gives a nonatomic
subring of the original semilocal domain. -/
theorem exists_nonatomic_subring_of_stalk_chain
    (D : Subring K) [IsFractionRing D K] [Finite (MaximalSpectrum D)]
    (M : MaximalSpectrum D) (O : Subring K) [IsDiscreteValuationRing O]
    (_hOM : O ≤ sourceMaximalStalk D M) (_halg : Algebra.IsAlgebraic (FractionRing O) K)
    (_hunif : ∃ π : O, Irreducible π ∧ (π : K) ∈ D)
    (hfail : ¬ WfDvdMonoid (Localization.AtPrime M.asIdeal)) :
    ∃ S : Subring D, ¬ Factorization.IsAtomicDomain S := by
  by_contra! h
  exact hfail (semilocal_ha_wfDvdMonoid_atPrime h M)

private theorem rational_base_fraction_field [CharZero K] (p : ℕ) [Fact p.Prime] :
    Subfield.closure (rationalCoefficientRing p K : Set K) = (Rat.castHom K).fieldRange := by
  let f := rationalCoefficientMap p ℚ
  have he : (Rat.castHom K).comp f = rationalCoefficientMap p K := by
    apply IsLocalization.ringHom_ext (rationalPrimeIdeal p).primeCompl
    ext n
    simp [f]
  apply le_antisymm
  · apply Subfield.closure_le.mpr
    rintro _ ⟨x, rfl⟩
    exact ⟨f x, RingHom.congr_fun he x⟩
  · rintro _ ⟨q, rfl⟩
    exact SubfieldClass.ratCast_mem _ q

private theorem coordinate_base_fraction_field {k : Type*} [Field k] [Algebra k K]
    (π : K) (hπ : Transcendental k π) :
    Subfield.closure (arithmeticCoefficientRing π hπ : Set K) =
      (IntermediateField.adjoin k {π}).toSubfield := by
  let := CharP.FunctionField.rationalAlgebra π hπ
  let B := (CharP.arithmeticBase k).toSubring
  let : IsFractionRing B (RatFunc k) := CharP.arithmeticBaseRing_isFractionRing k
  have hB : Subfield.closure (B : Set (RatFunc k)) = ⊤ := by
    have hr : Set.range (algebraMap B (RatFunc k)) = (B : Set (RatFunc k)) :=
      by ext x; exact ⟨fun ⟨a, ha⟩ => ha ▸ a.property, fun hx => ⟨⟨x, hx⟩, rfl⟩⟩
    rw [← hr, IsFractionRing.closure_range_algebraMap]
  change Subfield.closure (algebraMap (RatFunc k) K '' (B : Set (RatFunc k))) = _
  rw [← RingHom.map_field_closure, hB, ← RingHom.fieldRange_eq_map]
  ext x
  change (∃ y : RatFunc k, ↑(RatFunc.algEquivOfTranscendental π hπ y) = x) ↔ _
  constructor
  · rintro ⟨y, rfl⟩
    exact (RatFunc.algEquivOfTranscendental π hπ y).property
  · intro hx
    exact ⟨(RatFunc.algEquivOfTranscendental π hπ).symm ⟨x, hx⟩, by simp⟩

-- Manuscript: lem:semilocal-base
/-- In characteristic zero the ambient field is algebraic over the rationals.
Each maximal stalk contains a DVR generating precisely the rational subfield
and having a uniformizer in the original domain. -/
theorem semilocal_base_char_zero [CharZero K] (D : Subring K) [IsFractionRing D K]
    [Finite (MaximalSpectrum D)] (hD : Factorization.IsHereditarilyAtomic D)
    (hfield : ¬ IsField D) :
    Algebra.IsAlgebraic ℚ K ∧ ∀ M : MaximalSpectrum D, ∃ O : Subring K,
      O ≤ sourceMaximalStalk D M ∧ IsDiscreteValuationRing O ∧
      Subfield.closure (O : Set K) = (Rat.castHom K).fieldRange ∧
      ∃ π : O, Irreducible π ∧ (π : K) ∈ D := by
  let : Algebra.IsAlgebraic ℚ K := semilocal_fractionField_isAlgebraic_rat hD K
  refine ⟨inferInstance, fun M => ?_⟩
  let p := arithmeticResiduePrime D M
  let : Fact p.Prime := ⟨arithmeticResiduePrime_prime_of_not_isField D hfield M⟩
  refine ⟨rationalCoefficientRing p K,
    rationalCoefficientRing_le_sourceMaximalStalk p D M (arithmeticResiduePrime_mem D M),
    inferInstance, rational_base_fraction_field p, rationalCoefficientUniformizer p K,
    rationalCoefficientUniformizer_irreducible p K, ?_⟩
  rw [rationalCoefficientUniformizer_coe]
  exact (p : D).property

/-- In positive characteristic a single transcendental coordinate in the domain
gives an algebraic extension of its rational-function field. The coordinate
DVR has exactly that fraction field and lies in every maximal stalk. -/
theorem semilocal_base_char_prime (p : ℕ) [Fact p.Prime] [_root_.CharP K p]
    (D : Subring K) [IsFractionRing D K] [Finite (MaximalSpectrum D)]
    (hD : Factorization.IsHereditarilyAtomic D) (hfield : ¬ IsField D) :
    let := ZMod.algebra K p
    ∃ π : D, Transcendental (ZMod p) (π : K) ∧
      Algebra.IsAlgebraic (IntermediateField.adjoin (ZMod p) {(π : K)}) K ∧
      ∃ O : Subring K, IsDiscreteValuationRing O ∧
        Subfield.closure (O : Set K) = (IntermediateField.adjoin (ZMod p) {(π : K)}).toSubfield ∧
        (∃ u : O, Irreducible u ∧ (u : K) = (π : K)) ∧
        ∀ M : MaximalSpectrum D, O ≤ (LocalSubring.ofPrime D M.asIdeal).toSubring := by
  let := ZMod.algebra K p
  let : _root_.CharP D p := D.subtype.charP D.subtype_injective p
  let := ZMod.algebra D p
  let : SMul (ZMod p) D := (inferInstance : Algebra (ZMod p) D).toSMul
  let : IsScalarTower (ZMod p) D K := IsScalarTower.of_algebraMap_eq fun a =>
    RingHom.congr_fun (Subsingleton.elim (algebraMap (ZMod p) K)
      ((algebraMap D K).comp (algebraMap (ZMod p) D))) a
  obtain ⟨π, _, hJ, _, htr, halg⟩ :=
    exists_jacobson_transcendental_fractionField_isAlgebraic (ZMod p) hD hfield K
  refine ⟨π, htr, halg, arithmeticCoefficientRing (π : K) htr, arithmeticCoefficientRing_dvr (π : K) htr,
    coordinate_base_fraction_field _ htr, ⟨arithmeticCoefficientUniformizer _ htr,
    arithmeticCoefficientUniformizer_irreducible _ htr, arithmeticCoefficientUniformizer_coe _ htr⟩,
    fun M => arithmeticCoefficientRing_le_ofPrime D π htr M.asIdeal ?_⟩
  exact (show Ideal.jacobson (⊥ : Ideal D) ≤ M.asIdeal from sInf_le ⟨bot_le, M.isMaximal⟩) hJ

-- Manuscript: prop:semilocal-accp
theorem semilocal_accp_and_maximal_localizations
    (D : Type*) [CommRing D] [IsDomain D] [Finite (MaximalSpectrum D)]
    (hD : Factorization.IsHereditarilyAtomic D) :
    WfDvdMonoid D ∧ ∀ M : MaximalSpectrum D, WfDvdMonoid (Localization.AtPrime M.asIdeal) :=
  ⟨semilocal_ha_wfDvdMonoid hD, semilocal_ha_wfDvdMonoid_atPrime hD⟩

-- Manuscript: lem:simultaneous-units
/-- One source unit realizes arbitrary attained values at a finite family
of pairwise inequivalent outside valuations. -/
theorem simultaneous_outside_unit {ι : Type*} [Finite ι] {Γ : ι → Type*}
    [∀ i, LinearOrderedCommGroupWithZero (Γ i)]
    (D : Subring K) [IsFractionRing D K] [Finite (MaximalSpectrum D)]
    (hD : Factorization.IsHereditarilyAtomic D) (hfield : ¬ IsField D)
    (v : ∀ i, Valuation K (Γ i)) (hdistinct : Function.Injective fun i => (v i).valuationSubring)
    (hout : ∀ i, ¬ D ≤ (v i).valuationSubring.toSubring)
    (γ : ∀ i, Γ i) (hγ : ∀ i, ∃ x : Kˣ, v i x = γ i) :
    ∃ u : Dˣ, ∀ i, v i ((u : D) : K) = γ i := by
  classical
  let := Fintype.ofFinite ι
  choose a ha using hγ
  let W := fun i => (v i).valuationSubring
  let w := fun i => (W i).valuation
  let (i : ι) : (w i).RankOne :=
    Classical.choice (valuationSubring_rankOne_of_semilocal_hereditarilyAtomic hD hfield K (W i)
      (fun h => hout i (show D ≤ (W i).toSubring by rw [h]; exact le_top)))
  have hinj : Function.Injective fun i => (w i).valuationSubring := by
    simpa only [w, ValuationSubring.valuationSubring_valuation] using hdistinct
  obtain ⟨x, hx, he⟩ := ValuationApproximation.exists_same_values_rankOne w hinj
    (fun i => (a i : K)) (fun i => (a i).ne_zero)
  obtain ⟨j, hj0, hj⟩ := exists_nonzero_mem_jacobson_of_semilocal_nonfield D hfield
  have ho (i : ι) : ∃ d : D, 1 < w i (algebraMap D K d) := by
    obtain ⟨d, hd, hnot⟩ := SetLike.not_le_iff_exists.mp (hout i)
    exact ⟨⟨d, hd⟩, lt_of_not_ge (fun h => hnot ((W i).valuation_le_one_iff d |>.mp h))⟩
  obtain ⟨u, hu⟩ := exists_unit_same_values w hj hj0 ho x hx
  refine ⟨u, fun i => ?_⟩
  rw [← ha i]
  exact ((Valuation.isEquiv_valuation_valuationSubring (v i)).eq_iff).mpr
    ((hu i).trans (he i))

-- Manuscript: prop:outside
theorem outside_dvr_and_finite_support
    (D : Subring K) [IsFractionRing D K] [Finite (MaximalSpectrum D)]
    (hD : Factorization.IsHereditarilyAtomic D) (hfield : ¬ IsField D) :
    (∀ W : ValuationSubring K, ¬ D ≤ W.toSubring → IsDiscreteValuationRing W) ∧
    ∀ z : Kˣ, Set.Finite {W : ValuationSubring K | ¬ D ≤ W.toSubring ∧ W.valuation (z : K) ≠ 1} :=
  ⟨semilocal_outside_isDiscreteValuationRing D hD hfield,
    fun z => semilocal_finite_outside_value_support D hD hfield z.ne_zero⟩

-- Manuscript: lem:unit-bound
/-- The same bound applies to all subrings and accommodates a cofactor of
either unit status. -/
theorem uniform_bound_for_ambient_unit_factors (D : Subring K) [IsFractionRing D K]
    [Finite (MaximalSpectrum D)] (hD : Factorization.IsHereditarilyAtomic D)
    (hfield : ¬ IsField D) (z : D) (hz : z ≠ 0) :
    ∃ B : ℕ, ∀ (S : Subring K) (hSD : S ≤ D) (b : S) (t : Multiset S),
      (∀ a ∈ t, ¬ IsUnit a) → (z : K) = ((b * t.prod : S) : K) →
      Factorization.ambientUnitFactorCount (Subring.inclusion hSD).toMonoidHom t ≤ B := by
  classical
  obtain ⟨B, hB⟩ := semilocal_uniform_ambientUnitFactorBound D hD hfield (z : K)
    (Subtype.coe_ne_coe.mpr hz)
  refine ⟨B, fun S hSD b t ht he => ?_⟩
  by_cases hb : IsUnit b
  · exact hB S hSD (b * t.prod) he.symm t ht ((associated_unit_mul_left t.prod b hb).symm)
  · have hx := hB S hSD (b * t.prod) he.symm (b ::ₘ t)
      (by simpa using And.intro hb ht) (by simp)
    exact le_trans (by
      unfold Factorization.ambientUnitFactorCount
      by_cases hu : IsUnit (Subring.inclusion hSD b) <;> simp [hu]) hx

