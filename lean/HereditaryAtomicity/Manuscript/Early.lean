-- Manuscript: thm:local
/-- Theorem A. Failure of ACCP in a local domain gives a nonatomic unital subring. -/
theorem local_nonatomic_subring {R : Type*} [CommRing R] [IsDomain R] [IsLocalRing R]
    (h : ¬ WfDvdMonoid R) : ∃ S : Subring R, ¬ Factorization.IsAtomicDomain S := by
  by_contra! ha
  exact h (semilocal_ha_wfDvdMonoid ha)

-- Manuscript: thm:dvr
attribute [local instance] FractionRing.liftAlgebra in
/-- Theorem B. The witness contains the given DVR. -/
theorem local_nonatomic_subring_over_dvr {R : Type*} [CommRing R] [IsDomain R]
    [IsLocalRing R] (O : Subring R) [IsDiscreteValuationRing O]
    (hK : Algebra.IsAlgebraic (FractionRing O) (FractionRing R)) (h : ¬ WfDvdMonoid R) :
    ∃ S : Subring R, O ≤ S ∧ ¬ Factorization.IsAtomicDomain S :=
  exists_nonatomic_subring_containing_dvr O hK h

-- Manuscript: thm:hereditary
/-- Theorem C. The hereditary equivalence includes ACCP at every maximal localization. -/
theorem semilocal_hereditary_equivalence (R : Type*) [CommRing R] [IsDomain R]
    [Finite (MaximalSpectrum R)] :
    (Factorization.IsHereditarilyAtomic R ↔ Factorization.IsHereditarilyACCP R) ∧
    (Factorization.IsHereditarilyAtomic R → ∀ M : MaximalSpectrum R,
      WfDvdMonoid (Localization.AtPrime M.asIdeal)) :=
  ⟨⟨semilocal_ha_hereditarilyACCP, Factorization.IsHereditarilyACCP.isHereditarilyAtomic⟩,
    fun h M => semilocal_ha_wfDvdMonoid_atPrime h M⟩

section PolynomialWitness

open Polynomial
attribute [local instance] FractionRing.liftAlgebra

/-- The subring of the coefficient fraction field generated by the coefficients
and the inverse of a single nonzero element. -/
def coefficientsAway {A : Type*} [CommRing A] [IsDomain A] (q : A) : Subring (FractionRing A) :=
  (algebraMap A (FractionRing A)).range ⊔ Subring.closure {(algebraMap A (FractionRing A) q)⁻¹}

-- Manuscript: lem:transcendental-witness
/-- Lemma 2.1. Evaluation identifies the nonatomic ring with exactly
the elements a + x g(x) for g with coefficients in A[1/q]. -/
theorem transcendental_nonatomic_witness {K : Type*} [Field K] (A R : Subring K)
    (hAR : A ≤ R) (q : A) (hq : ¬ IsUnit q) (hqR : IsUnit (Subring.inclusion hAR q))
    (x : R) (hx : Transcendental (FractionRing A) (x : K)) :
    ∃ S : Subring K, S ≤ R ∧ ¬ Factorization.IsAtomicDomain S ∧
      ∀ z : K, z ∈ S ↔ ∃ a : A, ∃ g : (coefficientsAway q)[X],
        z = (a : K) + (x : K) * g.eval₂
          ((algebraMap (FractionRing A) K).comp (coefficientsAway q).subtype) (x : K) := by
  let F := FractionRing A
  let B := coefficientsAway q
  let j := algebraMap F K
  let k : A →+* B := (algebraMap A F).codRestrict B
    (fun a => (show (algebraMap A F).range ≤ B from le_sup_left) (show algebraMap A F a ∈ (algebraMap A F).range from ⟨a, rfl⟩))
  have hk : Function.Injective k := fun _ _ h => IsFractionRing.injective A F (congrArg Subtype.val h)
  let e : A ≃+* k.range := RingEquiv.ofBijective k.rangeRestrict
    ⟨fun _ _ h => hk (congrArg Subtype.val h), k.rangeRestrict_surjective⟩
  have hq0 : q ≠ 0 := by
    intro h
    exact hqR.ne_zero (by rw [h, map_zero])
  have inv_mem : (algebraMap A F q)⁻¹ ∈ B :=
    (show Subring.closure {(algebraMap A F q)⁻¹} ≤ B from le_sup_right)
      (Subring.subset_closure (Set.mem_singleton _))
  have hunit : IsUnit (k q) := by
    refine IsUnit.of_mul_eq_one (⟨_, inv_mem⟩ : B) (Subtype.ext ?_)
    change algebraMap A F q * (algebraMap A F q)⁻¹ = 1
    apply mul_inv_cancel₀
    simpa only [map_zero] using (IsFractionRing.injective A F).ne hq0
  have hnon : ¬ IsUnit (e q) := fun h => hq (by simpa using h.map e.symm)
  have hmodel := not_isAtomicDomain_constantCoefficientSubring k.range (e q) hnon hunit
  let ev : B[X] →+* K := Polynomial.eval₂RingHom (j.comp B.subtype) (x : K)
  have hinj : Function.Injective ev := by
    intro p r h
    apply Polynomial.map_injective B.subtype Subtype.val_injective
    apply (transcendental_iff_injective.mp hx)
    simpa only [Polynomial.aeval_def, Polynomial.eval₂_map] using (show p.eval₂ (j.comp B.subtype) (x : K) = r.eval₂ (j.comp B.subtype) (x : K) from h)
  let S := (constantCoefficientSubring k.range).map ev
  have hj (a : A) : j (k a : B) = (a : K) :=
    IsScalarTower.algebraMap_apply A F K a |>.symm
  have hcoeff : B ≤ R.comap j := by
    apply sup_le
    · rintro _ ⟨a, rfl⟩
      exact (show j (k a : B) ∈ R from hj a ▸ hAR a.property)
    · apply Subring.closure_le.mpr
      intro b hb
      obtain rfl := Set.mem_singleton_iff.mp hb
      change j ((algebraMap A F q)⁻¹) ∈ R
      rw [map_inv₀ j, show j (algebraMap A F q) = (q : K) from hj q]
      exact Submonoid.inv_mem_of_isUnit hqR
  have hev (p : B[X]) : ev p ∈ R := by
    induction p using Polynomial.induction_on with
    | C b => simpa [ev] using hcoeff b.property
    | add p r hp hr => simpa using R.add_mem hp hr
    | monomial n b ih =>
      simpa [pow_succ, ← mul_assoc, ev] using R.mul_mem ih x.property
  refine ⟨S, ?_, fun h => hmodel ((Factorization.subring_map_isAtomicDomain_iff _ _ hinj).mp h), ?_⟩
  · rintro _ ⟨p, _, rfl⟩
    exact hev p
  · intro z
    constructor
    · rintro ⟨p, hp, rfl⟩
      obtain ⟨a, ha⟩ : ∃ a, k a = p.coeff 0 := hp
      refine ⟨a, p.divX, ?_⟩
      have heq := congrArg ev (p.X_mul_divX_add)
      simpa [ev, ← ha, hj, add_comm] using heq.symm
    · rintro ⟨a, g, rfl⟩
      refine ⟨C (k a) + X * g, ?_, ?_⟩
      · change (C (k a) + X * g).coeff 0 ∈ k.range
        simp
      · change ev (C (k a) + X * g) = (a : K) + (x : K) * ev g
        simp [ev, hj]

end PolynomialWitness

section Normalization

private theorem valuation_restricts_to_coefficient_dvr {K : Type*} [Field K]
    (O : Subring K) [IsDiscreteValuationRing O] (π : O) (hπ : Irreducible π)
    (v : Valuation K ℝ≥0) (hO : ∀ a : O, v (a : K) ≤ 1)
    (hnorm : realValuationOrder v (π : K) = 1) (y : FractionRing O) :
    v (coefficientFractionEmbedding O y) ≤ 1 ↔ coefficientFractionEmbedding O y ∈ O := by
  constructor
  · intro h
    by_cases hy : y = 0
    · simp [hy]
    obtain ⟨e, u, hu⟩ := IsDiscreteValuationRing.exists_units_eq_smul_zpow_of_irreducible hπ hy
    have hyu : coefficientFractionEmbedding O y = ((u : O) : K) * (π : K) ^ e := by
      rw [hu]
      simp only [Units.smul_def, Algebra.smul_def, map_mul, map_zpow₀,
        coefficientFractionEmbedding_algebraMap]
    have hval := (realValuationOrder_nonneg_iff v ((map_ne_zero _).mpr hy)).mpr h
    rw [hyu, realValuationOrder_mul v (Subtype.coe_ne_coe.mpr u.ne_zero)
      (zpow_ne_zero _ (Subtype.coe_ne_coe.mpr hπ.ne_zero)), realValuationOrder_zpow,
      coefficient_unit_order O v hO u, hnorm, mul_one, zero_add] at hval
    have he : 0 ≤ e := by exact_mod_cast hval
    lift e to ℕ using he
    rw [hyu, zpow_natCast]
    exact O.mul_mem (u : O).property (O.pow_mem π.property _)
  · exact fun h => hO ⟨_, h⟩

attribute [local instance] FractionRing.liftAlgebra

-- Manuscript: lem:normalize
/-- A fixed strict principal chain has one nonzero scaling, inside the given
local domain, and a normalized valuation restricting to its base DVR. -/
theorem normalize_principal_chain {K : Type*} [Field K]
    (O R : Subring K) [IsDiscreteValuationRing O] [IsLocalRing R] [IsFractionRing R K]
    (halg : Algebra.IsAlgebraic (FractionRing O) K) (hOR : O ≤ R)
    (π : O) (hπ : Irreducible π) (x : ℕ → R) (hx : ∀ n, x n ≠ 0)
    (hchain : StrictMono (fun n => Ideal.span ({x n} : Set R))) :
    ∃ (s : R) (t : ℕ → R) (C : UniformizerChainData (Subring.inclusion hOR π) t)
      (v : Valuation K ℝ≥0),
      s ≠ 0 ∧ (∀ n, C.endpoint n = s * x n) ∧
      (∀ n, x n = x (n + 1) * t n) ∧
      realValuationOrder v (π : K) = 1 ∧
      (∀ y : FractionRing O,
        v (coefficientFractionEmbedding O y) ≤ 1 ↔ coefficientFractionEmbedding O y ∈ O) ∧
      (∀ n, 1 ≤ realValuationOrder v (C.endpoint n : K)) ∧
      (∀ n, 0 < realValuationOrder v (t n : K)) := by
  classical
  let : Algebra.IsAlgebraic O K := IsFractionRing.comap_isAlgebraic_iff.mpr halg
  have hstep (n : ℕ) : ∃ a : R, ¬ IsUnit a ∧ x n = x (n+1) * a :=
    (Ideal.span_singleton_lt_span_singleton.mp (hchain (Nat.lt_succ_self n))).2
  choose t htu hxt using hstep
  have ht (n : ℕ) : t n ∈ IsLocalRing.maximalIdeal R :=
    (IsLocalRing.mem_maximalIdeal _).mpr (htu n)
  obtain ⟨C, w, hc⟩ := embedded_exists_uniformizerChainData_scaled O R hOR hπ x t hx ht hxt
  have hfield : ¬ IsField R := by
    intro hf
    let : Field R := hf.toField
    exact htu 0 (isUnit_iff_ne_zero.mpr (C.ratio_ne_zero 0))
  obtain ⟨v, hnorm, hv, hcenter⟩ :=
    exists_normalized_uniformizer_valuation O R hOR hfield π hπ
  have hdiv (n : ℕ) : Subring.inclusion hOR π ∣ C.endpoint n := by
    exact ⟨w * x n, by rw [hc n]; ring⟩
  have hS : Subring.inclusion hOR π * w ≠ 0 := by
    intro h
    apply C.endpoint_ne_zero 0
    rw [hc 0, h, zero_mul]
  exact ⟨_, t, C, v, hS, hc, hxt, hnorm,
    valuation_restricts_to_coefficient_dvr O π hπ v (fun a => hv (Subring.inclusion hOR a)) hnorm,
    C.one_le_endpoint_order hdiv R.subtype Subtype.val_injective v hv hnorm,
    fun n => (hcenter (t n) (C.ratio_ne_zero n)).mpr (ht n)⟩

end Normalization

section ConsecutivePowers

open IntermediateField
open scoped IntermediateField
-- Manuscript: lem:L
/-- Lemma 4.1. Every term of an integer power has norm at most that of the power
in any consecutive basis of powers for the simple extension generated by y. -/
theorem consecutive_power_basis_bound {F E : Type*} [NontriviallyNormedField F] [CompleteSpace F]
    [IsUltrametricDist F] [NormedField E] [NormedAlgebra F E]
    (y : E) (hy : IsAlgebraic F y) (hy0 : y ≠ 0) (start : ℤ) :
    ∃ B : Module.Basis (Fin (minpoly F y).natDegree) F F⟮y⟯,
      (∀ i, B i = AdjoinSimple.gen F y ^ (start + (i : ℤ))) ∧
      ∀ (n : ℤ) i, ‖B.repr (AdjoinSimple.gen F y ^ n) i • B i‖ ≤ ‖y ^ n‖ := by
  let b := adjoin.powerBasis hy.isIntegral
  let : Algebra.IsAlgebraic F F⟮y⟯ := isAlgebraic_adjoin_simple hy.isIntegral
  have hgen : b.gen ≠ 0 := fun h => hy0 (congrArg Subtype.val h)
  refine ⟨powerWindowBasis b hgen start, powerWindowBasis_apply b hgen start, ?_⟩
  intro n i
  exact (norm_powerWindowBasis_zpow_term_le b hgen start n i).trans_eq
    (by rw [norm_zpow, norm_zpow]; rfl)

end ConsecutivePowers

-- Manuscript: lem:W
/-- Lemma 4.3. A suffix satisfying its windows shifts the prefix by its pole order. -/
theorem admissible_iff_shifted_prefix {N l : ℕ} (hl : l ≤ N) (D : Fin N → ℕ)
    (β : Fin N → ℤ)
    (htail : ∀ i : Fin N, l ≤ i.val → correctedDigit β i ∈ digitInterval (D i)) :
    IsWindowExponent D β ↔
      IsWindowExponent (fun i => D (Fin.castLE hl i)) (shiftedPrefix hl β) :=
  isWindowExponent_iff_shiftedPrefix hl D β htail

-- Manuscript: lem:WB
/-- Lemma 4.4. The window monomials form a basis of the generated field. -/
theorem window_monomials_form_basis (K : Type*) {E : Type*} [NormedField K]
    [NormedField E] [NormedAlgebra K E] (y : ℕ → Eˣ)
    (hy : ∀ n, IsAlgebraic K (y n : E)) (n : ℕ) :
    ∃ B : Module.Basis (WindowExponent (fun i : Fin n => movingDegree K y i.val))
        K (movingField K y n),
      ∀ β, ((B β : movingField K y n) : E) = ((∏ i, y i.val ^ β.val i : Eˣ) : E) :=
  ⟨movingTowerBasis K y hy n, movingTowerBasis_apply K y hy n⟩

section Loss

variable (K : Type*) {E : Type*} [NontriviallyNormedField K] [CompleteSpace K]
  [NormedField E] [NormedAlgebra K E]

private def BoundsPrefix {n : ℕ} (ys : Fin n → Eˣ) (C : ℝ) : Prop :=
  ∀ (y : ℕ → Eˣ) (hy : ∀ i, IsAlgebraic K (y i : E)), (∀ i : Fin n, y i = ys i) →
    ∀ z : movingField K y n, ∀ i,
      ‖(movingTowerBasis K y hy n).repr z i • movingTowerBasis K y hy n i‖ ≤ C * ‖z‖

private theorem exists_prefix_bound {n : ℕ} (ys : Fin n → Eˣ) :
    ∃ C : ℝ, 1 ≤ C ∧ BoundsPrefix K ys C := by
  classical
  by_cases h : ∃ y : ℕ → Eˣ, (∀ i, IsAlgebraic K (y i : E)) ∧ (∀ i : Fin n, y i = ys i)
  · obtain ⟨y, hy, hyp⟩ := h
    obtain ⟨C, hC, hb⟩ := exists_movingTowerBasis_norm_bound K y hy n
    refine ⟨C, hC, fun z hz hzp => movingTowerBasis_norm_bound_congr_prefix K hy hz ?_ hb⟩
    exact fun i hi => (hyp ⟨i, hi⟩).trans (hzp ⟨i, hi⟩).symm
  · exact ⟨1, le_rfl, fun y hy hyp => (h ⟨y, hy, hyp⟩).elim⟩

private def runningBound : (n : ℕ) → (Fin n → Eˣ) → ℝ
  | 0, _ => 1
  | n+1, ys => max (runningBound n (fun i => ys i.castSucc)) (exists_prefix_bound K ys).choose

private theorem runningBound_one_le : ∀ n (ys : Fin n → Eˣ), 1 ≤ runningBound K n ys
  | 0, _ => le_rfl
  | _+1, ys => (exists_prefix_bound K ys).choose_spec.1.trans (le_max_right _ _)

private theorem runningBound_spec {n : ℕ} (y : ℕ → Eˣ) (hy : ∀ i, IsAlgebraic K (y i : E))
    (z : movingField K y n) (i : WindowExponent (fun j : Fin n => movingDegree K y j.val)) :
    ‖(movingTowerBasis K y hy n).repr z i • movingTowerBasis K y hy n i‖ ≤
      runningBound K n (fun j => y j) * ‖z‖ := by
  cases n with
  | zero => exact movingTowerBasis_zero_norm_bound K y hy z i
  | succ n =>
    let ys : Fin (n+1) → Eˣ := fun j => y j
    exact ((exists_prefix_bound K ys).choose_spec.2 y hy (fun _ => rfl) z i).trans
      (mul_le_mul_of_nonneg_right (le_max_right _ _) (norm_nonneg _))

/-- Additive basis loss chosen solely from the finite prefix of generators.
For a prefix of length n this is the paper's Ω at index n+1. -/
def windowLoss (n : ℕ) (ys : Fin n → Eˣ) : ℝ := Real.log (runningBound K n ys)

-- Manuscript: lem:WL
/-- Lemma 4.5. The exponential norm bounds include all zero terms. A monomial
at the next stage uses the preceding loss, before that generator is chosen. -/
theorem movingBasisLosses [IsUltrametricDist E] (y : ℕ → Eˣ)
    (hy : ∀ i, IsAlgebraic K (y i : E)) :
    let Ω := fun n => windowLoss K n (fun j : Fin n => y j)
    Ω 0 = 0 ∧ Monotone Ω ∧
    (∀ n (x : movingField K y n) i,
      ‖(movingTowerBasis K y hy n).repr x i • movingTowerBasis K y hy n i‖ ≤ Real.exp (Ω n) * ‖x‖) ∧
    ∀ n (c : K) (α : Fin (n+1) → ℤ) i,
      let x := c • movingMonomial K y (n+1) α
      ‖(movingTowerBasis K y hy (n+1)).repr x i • movingTowerBasis K y hy (n+1) i‖ ≤
        Real.exp (Ω n) * ‖x‖ := by
  let C := fun n => runningBound K n (fun i : Fin n => y i)
  have hC n : 1 ≤ C n := runningBound_one_le K n _
  have hpos n : 0 < C n := zero_lt_one.trans_le (hC n)
  change Real.log (C 0) = 0 ∧ _
  refine ⟨Real.log_one, monotone_nat_of_le_succ (fun n => Real.log_le_log (hpos n)
    (le_max_left _ _)), ?_, ?_⟩
  · intro n x i
    change _ ≤ Real.exp (Real.log (C n)) * ‖x‖
    rw [Real.exp_log (hpos n)]
    exact runningBound_spec K y hy x i
  · intro n c α i
    change _ ≤ Real.exp (Real.log (C n)) * _
    rw [Real.exp_log (hpos n)]
    exact norm_movingTowerBasis_monomial_term_le K y hy n (hpos n).le
      (runningBound_spec K y hy) c α i

end Loss

end HereditaryAtomicity.Manuscript
