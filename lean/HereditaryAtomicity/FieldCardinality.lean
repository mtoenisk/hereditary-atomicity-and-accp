import Mathlib.RingTheory.Algebraic.Cardinality
import Mathlib.SetTheory.Cardinal.Subfield
import Mathlib.Algebra.Algebra.ZMod
import Mathlib.Algebra.Algebra.Rat
import Mathlib.RingTheory.Algebraic.Integral
import Mathlib.Data.Rat.Encodable
import Mathlib.Algebra.Field.ZMod
import HereditaryAtomicity.Transcendence

/-!
# Countability of hereditarily atomic fields

Every hereditarily atomic field is countable. The proof uses the CGH
nonintegral-unit obstruction and elementary cardinality of algebraic
extensions; no arithmetic classification of hereditarily atomic fields is
assumed.
-/

namespace HereditaryAtomicity

universe u v

/-- An algebraic domain extension of a countable domain is countable. -/
theorem countable_of_algebraic (R : Type u) (L : Type v)
    [CommRing R] [IsDomain R] [Countable R]
    [CommRing L] [IsDomain L] [Algebra R L] [Module.IsTorsionFree R L]
    [Algebra.IsAlgebraic R L] : Countable L := by
  apply Cardinal.mk_le_aleph0_iff.mp
  have hR : Cardinal.mk R ≤ Cardinal.aleph0 := Cardinal.mk_le_aleph0_iff.mpr inferInstance
  have h := Algebra.IsAlgebraic.lift_cardinalMk_le_max R L
  have hh : Cardinal.lift.{u} (Cardinal.mk L) ≤ Cardinal.aleph0 :=
    h.trans (sup_le (by simpa only [Cardinal.lift_aleph0] using Cardinal.lift_le.mpr hR)
      le_rfl)
  exact Cardinal.lift_le_aleph0.mp hh

/-- A subfield generated by a countable set is countable, in any characteristic. -/
theorem countable_subfieldClosure {K : Type u} [Field K]
    (s : Set K) [Countable s] : Countable (Subfield.closure s) := by
  apply Cardinal.mk_le_aleph0_iff.mp
  exact (Subfield.cardinalMk_closure_le_max s).trans
    (max_le (Cardinal.mk_le_aleph0_iff.mpr inferInstance) le_rfl)

/-- The subfield generated by one element is countable. -/
theorem countable_subfieldClosure_singleton {K : Type u} [Field K] (x : K) :
    Countable (Subfield.closure ({x} : Set K)) :=
  countable_subfieldClosure {x}

/-- In positive characteristic, transcendence over the prime field rules out
integrality over the integers. This supplies the actual unit obstruction input. -/
theorem not_isIntegral_int_of_not_isAlgebraic_zmod
    {K : Type u} [Field K] (p : ℕ) [Fact p.Prime] [CharP K p]
    [Algebra (ZMod p) K] {x : K} (hx : ¬ IsAlgebraic (ZMod p) x) :
    ¬ IsIntegral ℤ x := by
  intro hi
  exact hx (IsIntegral.isAlgebraic (hi.tower_top (A := ZMod p)))

/-- A field whose elements are integral over the integers is countable.
The characteristic split uses its actual prime field as a faithful base. -/
theorem countable_of_isIntegral_int {K : Type u} [Field K]
    (hK : ∀ x : K, IsIntegral ℤ x) : Countable K := by
  rcases CharP.exists' K with hchar | ⟨p, hp, hchar⟩
  · let := hchar
    let : Algebra.IsAlgebraic ℚ K := ⟨fun x =>
      (hK x).tower_top (A := ℚ) |>.isAlgebraic⟩
    exact countable_of_algebraic ℚ K
  · let := hp
    let := hchar
    let : Algebra (ZMod p) K := ZMod.algebra K p
    let : Algebra.IsAlgebraic (ZMod p) K := ⟨fun x =>
      (hK x).tower_top (A := ZMod p) |>.isAlgebraic⟩
    exact countable_of_algebraic (ZMod p) K

/-- For a field it is enough that all units are integral over the integers. -/
theorem countable_of_units_isIntegral_int {K : Type u} [Field K]
    (hK : ∀ x : Kˣ, IsIntegral ℤ (x : K)) : Countable K := by
  apply countable_of_isIntegral_int
  intro x
  by_cases hx : x = 0
  · rw [hx]
    exact isIntegral_zero
  · exact hK (Units.mk0 x hx)

/-- Every hereditarily atomic field is countable. A nonintegral unit supplies
a countably generated coefficient subfield via the actual CGH obstruction. -/
theorem countable_of_hereditarilyAtomic_field {K : Type u} [Field K]
    (hK : Factorization.IsHereditarilyAtomic K) : Countable K := by
  classical
  by_cases hunit : ∃ u : Kˣ, ¬ IsIntegral ℤ (u : K)
  · obtain ⟨u, hu⟩ := hunit
    let F : Subfield K := Subfield.closure ({(u : K)} : Set K)
    have huF : (u : K) ∈ F := Subfield.subset_closure (Set.mem_singleton _)
    let : Countable F := countable_subfieldClosure_singleton (u : K)
    let : Algebra.IsAlgebraic F K := ⟨fun x =>
      isAlgebraic_over_subfield_of_nonintegral_unit hK (RingHom.id K)
        Function.injective_id u hu F huF x⟩
    exact countable_of_algebraic F K
  · apply countable_of_units_isIntegral_int
    simpa only [not_exists, not_not] using hunit

end HereditaryAtomicity
