import HereditaryAtomicity.DVRBase.Model

/-!
# The selected-variable polynomial part of the finite Laurent model

The polynomial ring is generated by integral coefficient constants and the selected
Laurent variables. Termwise membership follows from those generators.
-/

noncomputable section
namespace HereditaryAtomicity.DVRBase

open scoped BigOperators NNReal

variable {K : Type*} [Field K] {n : ℕ}

/-- Monomials polynomial in the selected coordinates, with integral coefficients. -/
def polynomialClass (Λ : Finset (Fin n)) : MonomialClass n where
  contains β e := 0 ≤ e ∧ (∀ i, 0 ≤ β i) ∧ ∀ i, i ∉ Λ → β i = 0
  upward := by
    intro β e f hef h
    exact ⟨h.1.trans hef, h.2⟩

theorem polynomialClass_multiplicative (Λ : Finset (Fin n)) :
    (polynomialClass Λ).IsMultiplicative where
  one_mem := by simp [polynomialClass]
  add_mem := by
    intro β γ e f he hf
    exact ⟨add_nonneg he.1 hf.1, fun i => add_nonneg (he.2.1 i) (hf.2.1 i),
      fun i hi => by simp only [Pi.add_apply, he.2.2 i hi, hf.2.2 i hi, add_zero]⟩

/-- Literal generators of the selected-variable polynomial ring. -/
inductive ModelPolynomialGenerator (v : Valuation K ℝ≥0) (Λ : Finset (Fin n)) :
    Laurent K n → Prop
  | constant (c : K) (hc : v c ≤ 1) :
      ModelPolynomialGenerator v Λ (AddMonoidAlgebra.single 0 c)
  | coordinate (i : Fin n) (hi : i ∈ Λ) :
      ModelPolynomialGenerator v Λ (variableMonomial i)

/-- The actual polynomial ring over the valuation ring in the selected variables. -/
def modelPolynomialRing (v : Valuation K ℝ≥0) (Λ : Finset (Fin n)) :
    Subring (Laurent K n) := Subring.closure {f | ModelPolynomialGenerator v Λ f}

theorem modelPolynomialRing_constant (v : Valuation K ℝ≥0) (Λ : Finset (Fin n))
    (c : K) (hc : v c ≤ 1) : AddMonoidAlgebra.single 0 c ∈ modelPolynomialRing v Λ :=
  Subring.subset_closure (ModelPolynomialGenerator.constant c hc)

theorem modelPolynomialRing_variable (v : Valuation K ℝ≥0) (Λ : Finset (Fin n))
    (i : Fin n) (hi : i ∈ Λ) : variableMonomial i ∈ modelPolynomialRing v Λ :=
  Subring.subset_closure (ModelPolynomialGenerator.coordinate i hi)

/-- A subring containing selected variables contains every nonnegative monomial
supported on those coordinates, provided it contains the constant coefficient. -/
theorem single_nonneg_supported_mem_subring (S : Subring (Laurent K n))
    (Λ : Finset (Fin n)) (hvar : ∀ i, i ∈ Λ → variableMonomial i ∈ S)
    (β : Fin n → ℤ) (hβ : ∀ i, 0 ≤ β i) (hsupp : ∀ i, i ∉ Λ → β i = 0)
    (c : K) (hc : AddMonoidAlgebra.single 0 c ∈ S) :
    AddMonoidAlgebra.single β c ∈ S := by
  classical
  have hm : (∏ i, (variableMonomial i : Laurent K n) ^ (β i).toNat) ∈ S := by
    apply S.prod_mem
    intro i _
    by_cases hi : i ∈ Λ
    · exact S.pow_mem (hvar i hi) _
    · simp [hsupp i hi]
  rw [prod_variable_pow] at hm
  have he : (fun i => ((β i).toNat : ℤ)) = β := by
    funext i
    exact Int.toNat_of_nonneg (hβ i)
  rw [he] at hm
  simpa only [AddMonoidAlgebra.single_mul_single, zero_add, mul_one] using S.mul_mem hc hm

theorem modelPolynomialRing_single (v : Valuation K ℝ≥0) (Λ : Finset (Fin n))
    (β : Fin n → ℤ) (hβ : ∀ i, 0 ≤ β i) (hsupp : ∀ i, i ∉ Λ → β i = 0)
    (c : K) (hc : v c ≤ 1) : AddMonoidAlgebra.single β c ∈ modelPolynomialRing v Λ :=
  single_nonneg_supported_mem_subring _ Λ (modelPolynomialRing_variable v Λ)
    β hβ hsupp c (modelPolynomialRing_constant v Λ c hc)

theorem modelPolynomialRing_le_supported (v : Valuation K ℝ≥0) (Λ : Finset (Fin n)) :
    modelPolynomialRing v Λ ≤
      (polynomialClass Λ).supportedSubring v (polynomialClass_multiplicative Λ) := by
  classical
  apply Subring.closure_le.mpr
  intro f hf
  change f ∈ (polynomialClass Λ).supported v
  cases hf with
  | constant c hc =>
      apply (MonomialClass.single_mem_supported v (polynomialClass Λ) 0 c).mpr
      by_cases hc0 : c = 0
      · exact Or.inl hc0
      · exact Or.inr ⟨(realValuationOrder_nonneg_iff v hc0).mpr hc, by simp, by simp⟩
  | coordinate i hi =>
      change AddMonoidAlgebra.single (Pi.single i 1) 1 ∈ (polynomialClass Λ).supported v
      apply (MonomialClass.single_mem_supported v (polynomialClass Λ) _ _).mpr
      right
      refine ⟨by simp, ?_, ?_⟩
      · intro j
        simp only [Pi.single_apply]
        split_ifs <;> norm_num
      · intro j hj
        have hij : j ≠ i := by intro h; subst j; exact hj hi
        simp [Pi.single_eq_of_ne hij]

/-- The polynomial support criterion is equivalent to membership in the
generator-defined polynomial ring, including coefficient cancellation. -/
theorem modelPolynomialRing_eq_supported (v : Valuation K ℝ≥0) (Λ : Finset (Fin n)) :
    modelPolynomialRing v Λ =
      (polynomialClass Λ).supportedSubring v (polynomialClass_multiplicative Λ) := by
  classical
  apply le_antisymm (modelPolynomialRing_le_supported v Λ)
  intro f hf
  rw [← AddMonoidAlgebra.sum_coeff_single f, Finsupp.sum]
  apply Subring.sum_mem
  intro β hβ
  have hβ0 := Finsupp.mem_support_iff.mp hβ
  have h := (MonomialClass.mem_supported v (polynomialClass Λ)).mp hf β hβ0
  exact modelPolynomialRing_single v Λ β h.2.1 h.2.2 _
    ((realValuationOrder_nonneg_iff v hβ0).mp h.1)

theorem modelPolynomialRing_single_iff (v : Valuation K ℝ≥0) (Λ : Finset (Fin n))
    (β : Fin n → ℤ) (c : K) (hc : c ≠ 0) :
    AddMonoidAlgebra.single β c ∈ modelPolynomialRing v Λ ↔
      0 ≤ realValuationOrder v c ∧ (∀ i, 0 ≤ β i) ∧ ∀ i, i ∉ Λ → β i = 0 := by
  rw [modelPolynomialRing_eq_supported, MonomialClass.mem_supportedSubring,
    MonomialClass.single_mem_supported, or_iff_right hc]
  rfl

/-- The selected-variable polynomial ring lies in the actual model ring by
its generators; no valuation normalization premise is needed here. -/
theorem modelPolynomialRing_le_modelRing (v : Valuation K ℝ≥0) (Λ : Finset (Fin n))
    (π : K) (P : ModelParameters n) : modelPolynomialRing v Λ ≤ modelRing v π P := by
  apply Subring.closure_le.mpr
  intro f hf
  cases hf with
  | constant c hc => exact modelRing_constant v π P c hc
  | coordinate i _ => exact modelRing_variable v π P i

end HereditaryAtomicity.DVRBase
