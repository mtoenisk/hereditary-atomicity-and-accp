import HereditaryAtomicity.DVRBase.RationalTopDecomposition
import HereditaryAtomicity.DVRBase.MultiplaceDescentTermination
import Mathlib.RingTheory.Ideal.Int

/-!
# Rational residue primes of actual arithmetic centers

The rational prime below a nonzero source maximal ideal is the positive
integer generator of its contraction to ℤ. Algebraicity supplies nonzero
contraction, so neither integral source elements nor a prescribed prime family
are inputs. In particular every selected center of an actual supported source
chain has this canonical rational prime.
-/

noncomputable section
namespace HereditaryAtomicity.DVRBase
variable {K : Type*} [Field K]

/-- The nonnegative integer generator of the actual contracted ideal. -/
def arithmeticResiduePrime (D : Subring K) (M : MaximalSpectrum D) : ℕ :=
  Ideal.absNorm (M.asIdeal.under ℤ)

/-- The canonical integer belongs to the original maximal ideal. -/
theorem arithmeticResiduePrime_mem (D : Subring K) (M : MaximalSpectrum D) :
    (arithmeticResiduePrime D M : D) ∈ M.asIdeal :=
  Int.absNorm_under_mem M.asIdeal

/-- The contracted ideal is literally generated by the canonical integer. -/
theorem arithmeticResiduePrime_under_eq (D : Subring K) (M : MaximalSpectrum D) :
    M.asIdeal.under ℤ = Ideal.span {(arithmeticResiduePrime D M : ℤ)} :=
  (Int.ideal_span_absNorm_eq_self _).symm

variable [CharZero K] [Algebra.IsAlgebraic ℚ K]

/-- Every nonzero ideal of an algebraic arithmetic source has nonzero integer
contraction, without an integrality hypothesis on the source. -/
theorem int_under_ne_bot_of_algebraic_rat (D : Subring K) (I : Ideal D)
    (hI : I ≠ ⊥) : I.under ℤ ≠ ⊥ := by
  let : Algebra.IsAlgebraic ℤ D := subring_isAlgebraic_int_of_rat D
  obtain ⟨x, hxI, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
  obtain ⟨a, ha0, y, hay⟩ :=
    (Algebra.IsAlgebraic.isAlgebraic (R := ℤ) x).exists_nonzero_dvd
      (mem_nonZeroDivisors_of_ne_zero hx0)
  intro hz
  apply ha0
  have haI : a ∈ I.under ℤ := by
    change algebraMap ℤ D a ∈ I
    rw [hay]
    exact I.mul_mem_right y hxI
  simpa only [hz, Ideal.mem_bot] using haI

/-- Nonzero actual centers have a prime, rather than zero, integer generator. -/
theorem arithmeticResiduePrime_prime (D : Subring K) (M : MaximalSpectrum D)
    (hM : M.asIdeal ≠ ⊥) : (arithmeticResiduePrime D M).Prime := by
  have h0 : arithmeticResiduePrime D M ≠ 0 :=
    Ideal.absNorm_eq_zero_iff.not.mpr (int_under_ne_bot_of_algebraic_rat D M.asIdeal hM)
  rw [Nat.prime_iff_prime_int, ← Ideal.span_singleton_prime (Int.natCast_ne_zero.mpr h0),
    ← arithmeticResiduePrime_under_eq D M]
  infer_instance

/-- An actual nonzero source element in the center supplies its rational prime. -/
theorem arithmeticResiduePrime_prime_of_mem (D : Subring K) (M : MaximalSpectrum D)
    (x : D) (hx : x ≠ 0) (hxM : x ∈ M.asIdeal) :
    (arithmeticResiduePrime D M).Prime := by
  apply arithmeticResiduePrime_prime D M
  intro hM
  exact hx (by simpa only [hM, Ideal.mem_bot] using hxM)

/-- Every maximal ideal of a nonfield algebraic arithmetic source has a
canonical rational residue prime. -/
theorem arithmeticResiduePrime_prime_of_not_isField (D : Subring K)
    (hD : ¬ IsField D) (M : MaximalSpectrum D) :
    (arithmeticResiduePrime D M).Prime :=
  arithmeticResiduePrime_prime D M
    (Ring.ne_bot_of_isMaximal_of_not_isField M.isMaximal hD)

/-- A prime integer in the actual center is necessarily its canonical residue
prime; the construction does not add a choice of rational prime. -/
theorem arithmeticResiduePrime_eq_of_prime_mem (D : Subring K) (M : MaximalSpectrum D)
    (p : ℕ) (hp : p.Prime) (hpM : (p : D) ∈ M.asIdeal) :
    arithmeticResiduePrime D M = p := by
  have hp0 : (p : D) ≠ 0 := Nat.cast_ne_zero.mpr hp.ne_zero
  have hprime := arithmeticResiduePrime_prime_of_mem D M (p : D) hp0 hpM
  have hdiv : arithmeticResiduePrime D M ∣ p := by
    apply Int.natCast_dvd_natCast.mp
    exact Int.cast_mem_ideal_iff.mp (by simpa only [Int.cast_natCast] using hpM)
  exact (Nat.dvd_prime hp).mp hdiv |>.resolve_left hprime.ne_one

/-- The prime family for original centers is constructed from actual nonzero
source members, with no finiteness or supplied residue-prime assumption. -/
theorem exists_arithmeticResiduePrime_family {ι : Type*} (D : Subring K)
    (M : ι → MaximalSpectrum D) (x : ι → D) (hx : ∀ i, x i ≠ 0)
    (hxM : ∀ i, x i ∈ (M i).asIdeal) :
    ∃ p : ι → ℕ, (∀ i, (p i).Prime) ∧ (∀ i, (p i : D) ∈ (M i).asIdeal) ∧
      ∀ i, (M i).asIdeal.under ℤ = Ideal.span {(p i : ℤ)} :=
  ⟨fun i => arithmeticResiduePrime D (M i),
    fun i => arithmeticResiduePrime_prime_of_mem D (M i) (x i) (hx i) (hxM i),
    fun i => arithmeticResiduePrime_mem D (M i),
    fun i => arithmeticResiduePrime_under_eq D (M i)⟩

/-- Every center selected by an actual supported source chain has its prime
internally derived from the same nonzero original endpoint. -/
theorem SupportedSourceChain.arithmeticResiduePrime_prime (D : Subring K)
    (S : Finset (MaximalSpectrum D)) (C : SupportedSourceChain D S) (P : S) :
    (arithmeticResiduePrime D P.val).Prime := by
  apply arithmeticResiduePrime_prime_of_mem D P.val (C.endpoint 0) (C.endpoint_ne_zero 0)
  rw [C.step 0]
  exact P.val.asIdeal.mul_mem_left (C.endpoint 1) ((C.support 0 P.val).mpr P.property)

end HereditaryAtomicity.DVRBase
