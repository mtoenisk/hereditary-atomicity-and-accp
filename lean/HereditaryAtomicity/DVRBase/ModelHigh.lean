import HereditaryAtomicity.DVRBase.Model

/-!
# High-level monomials and the actual high-generator ideal
-/

noncomputable section
namespace HereditaryAtomicity.DVRBase
open scoped BigOperators NNReal
variable {K : Type*} [Field K] {n : ℕ}

/-- The strictly positive levels occurring among the high generators. -/
def MeetsHighLevel (u : Fin n → ℝ) (κ : ℝ) (T : ℕ → ℝ)
    (β : Fin n → ℤ) (e : ℝ) : Prop := ∃ k, 0 < k ∧ k ≤ n ∧ T k ≤ levelValue u κ e β k

theorem MeetsHighLevel.upward {u : Fin n → ℝ} {κ : ℝ} {T : ℕ → ℝ}
    {β : Fin n → ℤ} {e f : ℝ} (h : MeetsHighLevel u κ T β e) (hef : e ≤ f) :
    MeetsHighLevel u κ T β f := by
  obtain ⟨k, hk0, hkn, hk⟩ := h
  exact ⟨k, hk0, hkn, hk.trans (levelValue_mono_coefficient u κ β k hef)⟩

theorem MeetsHighLevel.add_meetsLevel {u : Fin n → ℝ} {κ : ℝ} {T : ℕ → ℝ}
    (hu : ∀ i, 0 ≤ u i) (hs : ∀ k ≤ n, 0 ≤ remainingValue u κ k)
    (hT : ∀ k ≤ n, 0 ≤ T k) {β γ : Fin n → ℤ} {e f : ℝ}
    (he : MeetsHighLevel u κ T β e) (hf : MeetsLevel u κ T γ f) :
    MeetsHighLevel u κ T (β + γ) (e + f) := by
  obtain ⟨k, hk0, hk, he⟩ := he
  obtain ⟨l, hl, hf⟩ := hf
  rcases le_total k l with hkl | hlk
  · refine ⟨l, hk0.trans_le hkl, hl, ?_⟩
    have he' := he.trans (levelValue_mono u κ e β hu hs hkl hl)
    have hp := levelValue_add_ge u κ e f β γ l (hs l hl)
    have hz := hT k hk
    linarith
  · refine ⟨k, hk0, hk, ?_⟩
    have hf' := hf.trans (levelValue_mono u κ f γ hu hs hlk hk)
    have hp := levelValue_add_ge u κ e f β γ k (hs k hk)
    have hz := hT l hl
    linarith

def ModelParameters.highClass (P : ModelParameters n) : MonomialClass n where
  contains β e := MeetsHighLevel P.weights P.kappa P.thresholds β e
  upward := by intro β e f h hf; exact hf.upward h

/-- Products of actual supported polynomials follow any proved product rule
for their coefficient-order/exponent classes. -/
theorem supported_mul_of_monomial (v : Valuation K ℝ≥0)
    (M N Q : MonomialClass n)
    (hm : ∀ β γ e f, M.contains β e → N.contains γ f → Q.contains (β + γ) (e + f))
    {a b : Laurent K n} (ha : a ∈ M.supported v) (hb : b ∈ N.supported v) :
    a * b ∈ Q.supported v := by
  classical
  intro β
  rw [AddMonoidAlgebra.coeff_mul, Finsupp.sum]
  apply AddSubgroup.sum_mem
  intro γ hγ
  rw [Finsupp.sum]
  apply AddSubgroup.sum_mem
  intro δ hδ
  split_ifs with h
  · rw [← h]
    right
    have ha0 := Finsupp.mem_support_iff.mp hγ
    have hb0 := Finsupp.mem_support_iff.mp hδ
    rw [realValuationOrder_mul v ha0 hb0]
    exact hm γ δ _ _ ((MonomialClass.mem_supported v M).mp ha γ ha0)
      ((MonomialClass.mem_supported v N).mp hb δ hb0)
  · exact (Q.coefficients v β).zero_mem

/-- High support is closed under multiplication by actual model-ring elements. -/
theorem high_supported_mul_modelRing (v : Valuation K ℝ≥0) (π : K)
    (hπ : realValuationOrder v π = 1) (P : ModelParameters n)
    {a b : Laurent K n} (ha : a ∈ P.highClass.supported v) (hb : b ∈ modelRing v π P) :
    a * b ∈ P.highClass.supported v := by
  apply supported_mul_of_monomial v P.highClass P.ringClass P.highClass _ ha
    (modelRing_le_supported v π hπ P hb)
  intro β γ e f he hf
  exact he.add_meetsLevel (fun i => (P.weights_pos i).le)
    (fun k hk => (P.remaining_pos k hk).le) P.threshold_nonneg hf

/-- The literal high monomials, regarded as members of R₀. -/
def modelHighGenerators (v : Valuation K ℝ≥0) (π : K) (P : ModelParameters n) :
    Set (modelRing v π P) :=
  {f | ∃ k, 0 < k ∧ k ≤ n ∧ ∃ β c, c ≠ 0 ∧ SupportedBefore β k ∧
    P.thresholds k ≤ termOrder v P.weights β c ∧ f.val = AddMonoidAlgebra.single β c}

/-- The actual ideal generated by the prescribed high monomials. -/
def modelHighIdeal (v : Valuation K ℝ≥0) (π : K) (P : ModelParameters n) :
    Ideal (modelRing v π P) := Ideal.span (modelHighGenerators v π P)

/-- The actual ambient image of the high-generator ideal. -/
def modelHighPart (v : Valuation K ℝ≥0) (π : K) (P : ModelParameters n) :
    AddSubgroup (Laurent K n) := (modelHighIdeal v π P).toAddSubgroup.map
      (modelRing v π P).subtype.toAddMonoidHom

@[simp] theorem mem_modelHighPart (v : Valuation K ℝ≥0) (π : K) (P : ModelParameters n)
    (f : Laurent K n) : f ∈ modelHighPart v π P ↔
      ∃ g : modelRing v π P, g ∈ modelHighIdeal v π P ∧ g.val = f := Iff.rfl

theorem modelHighPart_le_modelRing (v : Valuation K ℝ≥0) (π : K) (P : ModelParameters n) :
    modelHighPart v π P ≤ (modelRing v π P).toAddSubgroup := by
  rintro f ⟨g, hg, rfl⟩
  exact g.property

theorem modelHighPart_mul_left (v : Valuation K ℝ≥0) (π : K) (P : ModelParameters n)
    {f g : Laurent K n} (hf : f ∈ modelRing v π P) (hg : g ∈ modelHighPart v π P) :
    f * g ∈ modelHighPart v π P := by
  obtain ⟨a, ha, rfl⟩ := hg
  refine ⟨⟨f, hf⟩ * a, (modelHighIdeal v π P).mul_mem_left _ ha, rfl⟩

theorem high_mem_modelHighPart (v : Valuation K ℝ≥0) (π : K) (P : ModelParameters n)
    (k : ℕ) (hk0 : 0 < k) (hkn : k ≤ n) (β : Fin n → ℤ) (c : K)
    (hc : c ≠ 0) (hs : SupportedBefore β k)
    (hv : P.thresholds k ≤ termOrder v P.weights β c) :
    AddMonoidAlgebra.single β c ∈ modelHighPart v π P := by
  refine ⟨⟨_, modelRing_high v π P k hk0 hkn β c hc hs hv⟩, ?_, rfl⟩
  exact Ideal.subset_span ⟨k, hk0, hkn, β, c, hc, hs, hv, rfl⟩

/-- The support ideal inside the actual model ring. -/
def highSupportIdeal (v : Valuation K ℝ≥0) (π : K)
    (hπ : realValuationOrder v π = 1) (P : ModelParameters n) : Ideal (modelRing v π P) where
  carrier := {f | f.val ∈ P.highClass.supported v}
  zero_mem' := (P.highClass.supported v).zero_mem
  add_mem' := (P.highClass.supported v).add_mem
  smul_mem' a b hb := by
    change a.val * b.val ∈ P.highClass.supported v
    rw [mul_comm]
    exact high_supported_mul_modelRing v π hπ P hb a.property

theorem modelHighIdeal_le_support (v : Valuation K ℝ≥0) (π : K)
    (hπ : realValuationOrder v π = 1) (P : ModelParameters n) :
    modelHighIdeal v π P ≤ highSupportIdeal v π hπ P := by
  apply Ideal.span_le.mpr
  rintro f ⟨k, hk0, hkn, β, c, hc, hs, hv, he⟩
  change f.val ∈ P.highClass.supported v
  rw [he, MonomialClass.single_mem_supported]
  right
  refine ⟨k, hk0, hkn, ?_⟩
  have hp : poleTail β k = 0 := (poleTail_eq_zero_iff β k).mpr (fun i hi => by simp [hs i hi])
  simpa [termOrder, levelValue, hp, partialValue_eq_total_of_tail_zero P.weights (realValuationOrder v c) β k hs]
    using hv

theorem modelHighPart_single_of_meetsHighLevel (v : Valuation K ℝ≥0) (π : K)
    (hπ0 : π ≠ 0) (hπ : realValuationOrder v π = 1) (P : ModelParameters n)
    (β : Fin n → ℤ) (c : K) (hc : c ≠ 0)
    (h : MeetsHighLevel P.weights P.kappa P.thresholds β (realValuationOrder v c)) :
    AddMonoidAlgebra.single β c ∈ modelHighPart v π P := by
  classical
  obtain ⟨k, hk0, hkn, hk⟩ := h
  let d : ℕ := (poleTail β k).toNat
  let b : K := (π ^ P.kappa) ^ d
  have hd : (d : ℤ) = poleTail β k := Int.toNat_of_nonneg (poleTail_nonneg β k)
  have hdr : (d : ℝ) = (poleTail β k : ℝ) := by exact_mod_cast hd
  have hb : b ≠ 0 := pow_ne_zero _ (pow_ne_zero _ hπ0)
  have hcb : c / b ≠ 0 := div_ne_zero hc hb
  have hhead : termOrder v P.weights (modelHeadExponent β k) (c / b) =
      levelValue P.weights P.kappa (realValuationOrder v c) β k := by
    rw [termOrder, realValuationOrder_div v hc hb]
    simp only [b, realValuationOrder_pow, hπ, mul_one, hdr]
    convert modelHeadExponent_order P.weights P.kappa (realValuationOrder v c) β k using 1
    ring
  have hheadmem : AddMonoidAlgebra.single (modelHeadExponent β k) (c / b) ∈ modelHighPart v π P :=
    high_mem_modelHighPart v π P k hk0 hkn _ _ hcb
      (modelHeadExponent_tail β k) (hk.trans_eq hhead.symm)
  have htailmem : AddMonoidAlgebra.single (modelTailExponent β k) (1 : K) ∈ modelRing v π P :=
    modelRing_nonneg_monomial v π P _ (modelTailExponent_nonneg β k) 1 (by simp)
  have hpow : (terminalMonomial π P.kappa : Laurent K n) ^ d =
      AddMonoidAlgebra.single (fun _ => -poleTail β k) b := by
    simp only [terminalMonomial, AddMonoidAlgebra.single_pow]
    congr 1
    funext i
    simp [Pi.smul_apply, hd]
  have heq : (AddMonoidAlgebra.single (modelHeadExponent β k) (c / b) *
        (terminalMonomial π P.kappa : Laurent K n) ^ d) *
        AddMonoidAlgebra.single (modelTailExponent β k) 1 = AddMonoidAlgebra.single β c := by
    rw [hpow, AddMonoidAlgebra.single_mul_single, AddMonoidAlgebra.single_mul_single,
      modelExponent_decomposition, div_mul_cancel₀ _ hb, mul_one]
  rw [← heq]
  have hm := modelHighPart_mul_left v π P htailmem
    (modelHighPart_mul_left v π P ((modelRing v π P).pow_mem (modelRing_terminal v π P) d) hheadmem)
  simpa only [mul_comm, mul_left_comm] using hm


/-- The actual high-generator ideal has exactly the positive-level support. -/
theorem modelHighPart_eq_supported (v : Valuation K ℝ≥0) (π : K)
    (hπ0 : π ≠ 0) (hπ : realValuationOrder v π = 1) (P : ModelParameters n) :
    modelHighPart v π P = P.highClass.supported v := by
  classical
  apply le_antisymm
  · rintro f ⟨g, hg, rfl⟩
    exact modelHighIdeal_le_support v π hπ P hg
  · intro f hf
    rw [← AddMonoidAlgebra.sum_coeff_single f, Finsupp.sum]
    apply AddSubgroup.sum_mem
    intro β hβ
    have hn := Finsupp.mem_support_iff.mp hβ
    exact modelHighPart_single_of_meetsHighLevel v π hπ0 hπ P β _ hn
      ((MonomialClass.mem_supported v P.highClass).mp hf β hn)

/-- Two high-level monomials remain high after losing 2κ coefficient order. -/
theorem MeetsHighLevel.add_sub_two {u : Fin n → ℝ} {κ : ℝ} {T : ℕ → ℝ}
    (hu : ∀ i, 0 ≤ u i) (hs : ∀ k ≤ n, 0 ≤ remainingValue u κ k)
    (hT : ∀ k, 0 < k → k ≤ n → 2 * κ ≤ T k) {β γ : Fin n → ℤ} {e f : ℝ}
    (he : MeetsHighLevel u κ T β e) (hf : MeetsHighLevel u κ T γ f) :
    MeetsHighLevel u κ T (β + γ) (e + f - 2 * κ) := by
  obtain ⟨k, hk0, hk, he⟩ := he
  obtain ⟨l, hl0, hl, hf⟩ := hf
  have shift : ∀ j, levelValue u κ (e + f - 2 * κ) (β + γ) j =
      levelValue u κ (e + f) (β + γ) j - 2 * κ := by
    intro j
    unfold levelValue partialValue
    ring
  rcases le_total k l with hkl | hlk
  · refine ⟨l, hl0, hl, ?_⟩
    have he' := he.trans (levelValue_mono u κ e β hu hs hkl hl)
    have hp := levelValue_add_ge u κ e f β γ l (hs l hl)
    have ht := hT k hk0 hk
    rw [shift]
    linarith
  · refine ⟨k, hk0, hk, ?_⟩
    have hf' := hf.trans (levelValue_mono u κ f γ hu hs hlk hk)
    have hp := levelValue_add_ge u κ e f β γ k (hs k hk)
    have ht := hT l hl0 hl
    rw [shift]
    linarith

/-- The actual scalar multiple π⁻κ I in the ambient Laurent algebra. -/
def modelScaledHigh (v : Valuation K ℝ≥0) (π : K) (P : ModelParameters n) :
    AddSubgroup (Laurent K n) := (modelHighPart v π P).map
      (AddMonoidHom.mulLeft (AddMonoidAlgebra.single 0 (π ^ P.kappa)⁻¹))

theorem modelScaledHigh_eq_supported (v : Valuation K ℝ≥0) (π : K)
    (hπ0 : π ≠ 0) (hπ : realValuationOrder v π = 1) (P : ModelParameters n) :
    modelScaledHigh v π P = (P.highClass.translate 0 (-(P.kappa : ℝ))).supported v := by
  ext f
  have ho : realValuationOrder v ((π ^ P.kappa)⁻¹) = -(P.kappa : ℝ) := by
    simp [realValuationOrder_inv, realValuationOrder_pow, hπ]
  rw [← ho, MonomialClass.mem_translate_iff_exists v P.highClass 0
    (inv_ne_zero (pow_ne_zero _ hπ0))]
  change (∃ g ∈ modelHighPart v π P, AddMonoidAlgebra.single 0 (π ^ P.kappa)⁻¹ * g = f) ↔ _
  rw [modelHighPart_eq_supported v π hπ0 hπ P]

/-- The scaled high part is an R₀-module in the literal ambient algebra. -/
theorem modelScaledHigh_mul_left (v : Valuation K ℝ≥0) (π : K) (P : ModelParameters n)
    {f g : Laurent K n} (hf : f ∈ modelRing v π P) (hg : g ∈ modelScaledHigh v π P) :
    f * g ∈ modelScaledHigh v π P := by
  obtain ⟨a, ha, rfl⟩ := hg
  refine ⟨f * a, modelHighPart_mul_left v π P hf ha, ?_⟩
  change AddMonoidAlgebra.single 0 (π ^ P.kappa)⁻¹ * (f * a) =
    f * (AddMonoidAlgebra.single 0 (π ^ P.kappa)⁻¹ * a)
  ring

/-- G3(a): products from π⁻κ I return to I, with literal source membership. -/
theorem modelScaledHigh_mul_mem_high (v : Valuation K ℝ≥0) (π : K)
    (hπ0 : π ≠ 0) (hπ : realValuationOrder v π = 1) (P : ModelParameters n)
    {f g : Laurent K n} (hf : f ∈ modelScaledHigh v π P) (hg : g ∈ modelScaledHigh v π P) :
    f * g ∈ modelHighPart v π P := by
  rw [modelHighPart_eq_supported v π hπ0 hπ P]
  rw [modelScaledHigh_eq_supported v π hπ0 hπ P] at hf hg
  apply supported_mul_of_monomial v _ _ P.highClass _ hf hg
  intro β γ e f he hf
  change MeetsHighLevel P.weights P.kappa P.thresholds (-0 + β) (e - -(P.kappa : ℝ)) at he
  change MeetsHighLevel P.weights P.kappa P.thresholds (-0 + γ) (f - -(P.kappa : ℝ)) at hf
  simp only [neg_zero, zero_add, sub_neg_eq_add] at he hf
  have h := he.add_sub_two (fun i => (P.weights_pos i).le)
    (fun k hk => (P.remaining_pos k hk).le) P.threshold_large hf
  change MeetsHighLevel P.weights P.kappa P.thresholds (β + γ) (e + f)
  convert h using 1
  ring

/-- R₀ plus its actual scaled high ideal, as a subring. -/
def modelSharpRing (v : Valuation K ℝ≥0) (π : K)
    (hπ0 : π ≠ 0) (hπ : realValuationOrder v π = 1) (P : ModelParameters n) :
    Subring (Laurent K n) where
  toAddSubgroup := (modelRing v π P).toAddSubgroup ⊔ modelScaledHigh v π P
  one_mem' := AddSubgroup.mem_sup_left (modelRing v π P).one_mem
  mul_mem' := by
    intro f g hf hg
    obtain ⟨a, ha, j, hj, rfl⟩ := AddSubgroup.mem_sup.mp hf
    obtain ⟨b, hb, k, hk, rfl⟩ := AddSubgroup.mem_sup.mp hg
    apply AddSubgroup.mem_sup.mpr
    refine ⟨a * b + j * k, ?_, a * k + b * j, ?_, ?_⟩
    · exact (modelRing v π P).add_mem ((modelRing v π P).mul_mem ha hb)
        (modelHighPart_le_modelRing v π P (modelScaledHigh_mul_mem_high v π hπ0 hπ P hj hk))
    · exact (modelScaledHigh v π P).add_mem
        (modelScaledHigh_mul_left v π P ha hk) (modelScaledHigh_mul_left v π P hb hj)
    · ring

def ModelParameters.sharpClass (P : ModelParameters n) : MonomialClass n :=
  P.ringClass.union (P.highClass.translate 0 (-(P.kappa : ℝ)))

theorem modelSharpRing_eq_supported (v : Valuation K ℝ≥0) (π : K)
    (hπ0 : π ≠ 0) (hπ : realValuationOrder v π = 1) (P : ModelParameters n) :
    (modelSharpRing v π hπ0 hπ P).toAddSubgroup = P.sharpClass.supported v := by
  change (modelRing v π P).toAddSubgroup ⊔ modelScaledHigh v π P = _
  rw [modelRing_eq_supported v π hπ0 hπ P, modelScaledHigh_eq_supported v π hπ0 hπ P]
  exact (MonomialClass.supported_union v P.ringClass _).symm

end HereditaryAtomicity.DVRBase

noncomputable section
namespace HereditaryAtomicity.DVRBase
open scoped BigOperators NNReal
variable {K : Type*} [Field K] {n : ℕ}

/-- The near-junk ring for a specified multiplier in R₀. -/
def modelNearRing (v : Valuation K ℝ≥0) (π : K)
    (hπ0 : π ≠ 0) (hπ : realValuationOrder v π = 1) (P : ModelParameters n)
    (m : Laurent K n) (hm : m ∈ modelRing v π P) : Subring (Laurent K n) where
  toAddSubgroup := (modelSharpRing v π hπ0 hπ P).toAddSubgroup ⊓
    (modelRing v π P).toAddSubgroup.comap (AddMonoidHom.mulLeft m)
  one_mem' := ⟨(modelSharpRing v π hπ0 hπ P).one_mem, by simpa using hm⟩
  mul_mem' := by
    intro f g hf hg
    refine ⟨(modelSharpRing v π hπ0 hπ P).mul_mem hf.1 hg.1, ?_⟩
    obtain ⟨a, ha, j, hj, hfj⟩ := AddSubgroup.mem_sup.mp hf.1
    obtain ⟨b, hb, k, hk, hgk⟩ := AddSubgroup.mem_sup.mp hg.1
    have hmf : m * f ∈ modelRing v π P := hf.2
    have hmg : m * g ∈ modelRing v π P := hg.2
    have hmj : m * j ∈ modelRing v π P := by
      have h := (modelRing v π P).sub_mem hmf ((modelRing v π P).mul_mem hm ha)
      rw [← hfj] at h
      convert h using 1
      ring
    have hjk : j * k ∈ modelRing v π P := modelHighPart_le_modelRing v π P
      (modelScaledHigh_mul_mem_high v π hπ0 hπ P hj hk)
    have h := (modelRing v π P).add_mem
      ((modelRing v π P).add_mem ((modelRing v π P).mul_mem ha hmg)
        ((modelRing v π P).mul_mem hb hmj)) ((modelRing v π P).mul_mem hm hjk)
    change m * (f * g) ∈ modelRing v π P
    rw [← hgk] at h
    rw [← hfj, ← hgk]
    convert h using 1
    ring

@[simp] theorem mem_modelNearRing (v : Valuation K ℝ≥0) (π : K)
    (hπ0 : π ≠ 0) (hπ : realValuationOrder v π = 1) (P : ModelParameters n)
    (m : Laurent K n) (hm : m ∈ modelRing v π P) (f : Laurent K n) :
    f ∈ modelNearRing v π hπ0 hπ P m hm ↔
      f ∈ modelSharpRing v π hπ0 hπ P ∧ m * f ∈ modelRing v π P := Iff.rfl

theorem modelNearRing_mul_mem_modelRing (v : Valuation K ℝ≥0) (π : K)
    (hπ0 : π ≠ 0) (hπ : realValuationOrder v π = 1) (P : ModelParameters n)
    (m : Laurent K n) (hm : m ∈ modelRing v π P) {f : Laurent K n}
    (hf : f ∈ modelNearRing v π hπ0 hπ P m hm) : m * f ∈ modelRing v π P := hf.2

/-- Intersect two upward monomial classes. -/
def MonomialClass.inter (M N : MonomialClass n) : MonomialClass n where
  contains β e := M.contains β e ∧ N.contains β e
  upward := by intro β e f h hf; exact ⟨M.upward β h hf.1, N.upward β h hf.2⟩

/-- The inverse image of a support class under multiplication by one monomial. -/
def MonomialClass.multiplyPreimage (M : MonomialClass n) (β : Fin n → ℤ) (e : ℝ) :
    MonomialClass n where
  contains γ f := M.contains (β + γ) (e + f)
  upward := by
    intro γ a b h
    apply M.upward _
    linarith

theorem single_mul_mem_supported_iff (v : Valuation K ℝ≥0) (M : MonomialClass n)
    (β : Fin n → ℤ) {c : K} (hc : c ≠ 0) (f : Laurent K n) :
    AddMonoidAlgebra.single β c * f ∈ M.supported v ↔
      f ∈ (M.multiplyPreimage β (realValuationOrder v c)).supported v := by
  constructor
  · intro h
    rw [MonomialClass.mem_supported] at h ⊢
    intro γ hγ
    have hprod : (AddMonoidAlgebra.single β c * f).coeff (β + γ) ≠ 0 := by
      simpa using mul_ne_zero hc hγ
    have hh := h (β + γ) hprod
    simpa [MonomialClass.multiplyPreimage, realValuationOrder_mul v hc hγ] using hh
  · intro h
    rw [MonomialClass.mem_supported] at h ⊢
    intro γ hγ
    have hf : f.coeff (-β + γ) ≠ 0 := by
      intro hf
      simp [AddMonoidAlgebra.coeff_single_mul_apply, hf] at hγ
    have hh := h (-β + γ) hf
    simpa [MonomialClass.multiplyPreimage, AddMonoidAlgebra.coeff_single_mul_apply,
      realValuationOrder_mul v hc hf] using hh

def ModelParameters.nearClass (P : ModelParameters n) (β : Fin n → ℤ) (e : ℝ) :
    MonomialClass n := P.sharpClass.inter (P.ringClass.multiplyPreimage β e)

/-- The near-junk ring for a monomial multiplier has exact coefficient support. -/
theorem modelNearRing_eq_supported (v : Valuation K ℝ≥0) (π : K)
    (hπ0 : π ≠ 0) (hπ : realValuationOrder v π = 1) (P : ModelParameters n)
    (β : Fin n → ℤ) (c : K) (hc : c ≠ 0)
    (hm : AddMonoidAlgebra.single β c ∈ modelRing v π P) :
    (modelNearRing v π hπ0 hπ P (AddMonoidAlgebra.single β c) hm).toAddSubgroup =
      (P.nearClass β (realValuationOrder v c)).supported v := by
  ext f
  change (f ∈ modelSharpRing v π hπ0 hπ P ∧
      AddMonoidAlgebra.single β c * f ∈ modelRing v π P) ↔ _
  have hsharp : f ∈ modelSharpRing v π hπ0 hπ P ↔ f ∈ P.sharpClass.supported v := by
    change f ∈ (modelSharpRing v π hπ0 hπ P).toAddSubgroup ↔ _
    rw [modelSharpRing_eq_supported v π hπ0 hπ P]
  rw [hsharp, modelRing_eq_supported v π hπ0 hπ P, MonomialClass.mem_supportedSubring,
    single_mul_mem_supported_iff v P.ringClass β hc f]
  simp only [MonomialClass.mem_supported, ModelParameters.nearClass, MonomialClass.inter]
  constructor
  · rintro ⟨h₁, h₂⟩ γ hγ
    exact ⟨h₁ γ hγ, h₂ γ hγ⟩
  · intro h
    exact ⟨fun γ hγ => (h γ hγ).1, fun γ hγ => (h γ hγ).2⟩

end HereditaryAtomicity.DVRBase
