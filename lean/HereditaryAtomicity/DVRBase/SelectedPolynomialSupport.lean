import HereditaryAtomicity.DVRBase.SourceLaurent

/-!
# Original-coefficient selected-variable Laurent polynomials

The selected ring is generated by the literal original coefficient ring and
selected nonnegative variables. Its collected coefficients remain in the image
of the original ring, independently of any valuation or completion.
-/

noncomputable section
namespace HereditaryAtomicity.DVRBase
open scoped BigOperators

variable {K : Type*} [Field K]

/-- Literal original coefficients and selected Laurent variables. -/
inductive SelectedFormalGenerator (O : Subring K) (Λ : Set ℕ) (n : ℕ) :
    Laurent (FractionRing O) n → Prop
  | coefficient (a : O) : SelectedFormalGenerator O Λ n
      (AddMonoidAlgebra.single 0 (algebraMap O (FractionRing O) a))
  | coordinate (i : Fin n) (hi : i.val ∈ Λ) : SelectedFormalGenerator O Λ n
      (variableMonomial i)

/-- The actual selected-variable polynomial ring over the original coefficient ring. -/
def selectedFormalRing (O : Subring K) (Λ : Set ℕ) (n : ℕ) :
    Subring (Laurent (FractionRing O) n) :=
  Subring.closure {f | SelectedFormalGenerator O Λ n f}

theorem selectedFormalRing_coefficient (O : Subring K) (Λ : Set ℕ) (n : ℕ) (a : O) :
    AddMonoidAlgebra.single 0 (algebraMap O (FractionRing O) a) ∈ selectedFormalRing O Λ n :=
  Subring.subset_closure (SelectedFormalGenerator.coefficient a)

theorem selectedFormalRing_variable (O : Subring K) (Λ : Set ℕ) {n : ℕ}
    (i : Fin n) (hi : i.val ∈ Λ) : variableMonomial i ∈ selectedFormalRing O Λ n :=
  Subring.subset_closure (SelectedFormalGenerator.coordinate i hi)

/-- Nonnegative exponents using only the selected coordinates. -/
def SelectedFormalExponent (Λ : Set ℕ) {n : ℕ} (β : Fin n → ℤ) : Prop :=
  (∀ i, 0 ≤ β i) ∧ ∀ i, i.val ∉ Λ → β i = 0

private theorem selectedFormalExponent_zero (Λ : Set ℕ) (n : ℕ) :
    SelectedFormalExponent Λ (0 : Fin n → ℤ) := by
  exact ⟨fun _ => le_rfl, fun _ _ => rfl⟩

private theorem selectedFormalExponent_add (Λ : Set ℕ) {n : ℕ}
    {β γ : Fin n → ℤ} (hβ : SelectedFormalExponent Λ β) (hγ : SelectedFormalExponent Λ γ) :
    SelectedFormalExponent Λ (β + γ) := by
  exact ⟨fun i => add_nonneg (hβ.1 i) (hγ.1 i),
    fun i hi => by simp only [Pi.add_apply, hβ.2 i hi, hγ.2 i hi, add_zero]⟩

/-- Allowed collected coefficients at a fixed exponent; zero is unrestricted. -/
private def selectedCoefficients (O : Subring K) (Λ : Set ℕ) {n : ℕ}
    (β : Fin n → ℤ) : AddSubgroup (FractionRing O) where
  carrier := {c | (∃ a : O, algebraMap O (FractionRing O) a = c) ∧
    (c ≠ 0 → SelectedFormalExponent Λ β)}
  zero_mem' := ⟨⟨0, map_zero _⟩, fun h => (h rfl).elim⟩
  add_mem' := by
    rintro c d ⟨⟨a, ha⟩, hc⟩ ⟨⟨b, hb⟩, hd⟩
    refine ⟨⟨a + b, by rw [map_add, ha, hb]⟩, ?_⟩
    intro hcd
    by_cases hc0 : c = 0
    · exact hd (by intro hd0; exact hcd (by simp [hc0, hd0]))
    · exact hc hc0
  neg_mem' := by
    rintro c ⟨⟨a, ha⟩, hc⟩
    exact ⟨⟨-a, by rw [map_neg, ha]⟩, fun h => hc (neg_ne_zero.mp h)⟩

private theorem selectedCoefficients_mul (O : Subring K) (Λ : Set ℕ) {n : ℕ}
    {β γ : Fin n → ℤ} {c d : FractionRing O}
    (hc : c ∈ selectedCoefficients O Λ β) (hd : d ∈ selectedCoefficients O Λ γ) :
    c * d ∈ selectedCoefficients O Λ (β + γ) := by
  rcases hc with ⟨⟨a, ha⟩, hc⟩
  rcases hd with ⟨⟨b, hb⟩, hd⟩
  refine ⟨⟨a * b, by rw [map_mul, ha, hb]⟩, ?_⟩
  intro hcd
  exact selectedFormalExponent_add Λ (hc (mul_ne_zero_iff.mp hcd).1)
    (hd (mul_ne_zero_iff.mp hcd).2)

private def selectedSupport (O : Subring K) (Λ : Set ℕ) (n : ℕ) :
    AddSubgroup (Laurent (FractionRing O) n) where
  carrier := {f | ∀ β, f.coeff β ∈ selectedCoefficients O Λ β}
  zero_mem' := by intro β; exact (selectedCoefficients O Λ β).zero_mem
  add_mem' := by
    intro f g hf hg β
    exact (selectedCoefficients O Λ β).add_mem (hf β) (hg β)
  neg_mem' := by
    intro f hf β
    exact (selectedCoefficients O Λ β).neg_mem (hf β)

private theorem single_mem_selectedSupport (O : Subring K) (Λ : Set ℕ) {n : ℕ}
    (β : Fin n → ℤ) (c : FractionRing O) :
    AddMonoidAlgebra.single β c ∈ selectedSupport O Λ n ↔ c ∈ selectedCoefficients O Λ β := by
  classical
  constructor
  · intro h
    simpa using h β
  · intro h γ
    by_cases hγ : β = γ
    · subst γ; simpa using h
    · simp only [AddMonoidAlgebra.coeff_single, Finsupp.single_eq_of_ne (Ne.symm hγ)]
      exact (selectedCoefficients O Λ γ).zero_mem

private theorem mul_mem_selectedSupport (O : Subring K) (Λ : Set ℕ) {n : ℕ}
    {f g : Laurent (FractionRing O) n}
    (hf : f ∈ selectedSupport O Λ n) (hg : g ∈ selectedSupport O Λ n) :
    f * g ∈ selectedSupport O Λ n := by
  classical
  intro β
  rw [AddMonoidAlgebra.coeff_mul, Finsupp.sum]
  apply AddSubgroup.sum_mem
  intro γ _hγ
  rw [Finsupp.sum]
  apply AddSubgroup.sum_mem
  intro δ _hδ
  split_ifs with h
  · rw [← h]
    exact selectedCoefficients_mul O Λ (hf γ) (hg δ)
  · exact (selectedCoefficients O Λ β).zero_mem

private def selectedSupportSubring (O : Subring K) (Λ : Set ℕ) (n : ℕ) :
    Subring (Laurent (FractionRing O) n) where
  toAddSubgroup := selectedSupport O Λ n
  one_mem' := by
    change AddMonoidAlgebra.single 0 1 ∈ selectedSupport O Λ n
    apply (single_mem_selectedSupport O Λ 0 1).mpr
    exact ⟨⟨1, map_one _⟩, fun _ => selectedFormalExponent_zero Λ n⟩
  mul_mem' := mul_mem_selectedSupport O Λ

private theorem selectedFormalRing_le_support (O : Subring K) (Λ : Set ℕ) (n : ℕ) :
    selectedFormalRing O Λ n ≤ selectedSupportSubring O Λ n := by
  classical
  apply Subring.closure_le.mpr
  intro f hf
  change f ∈ selectedSupport O Λ n
  cases hf with
  | coefficient a =>
      apply (single_mem_selectedSupport O Λ _ _).mpr
      exact ⟨⟨a, rfl⟩, fun _ => selectedFormalExponent_zero Λ n⟩
  | coordinate i hi =>
      change AddMonoidAlgebra.single (Pi.single i 1) 1 ∈ selectedSupport O Λ n
      apply (single_mem_selectedSupport O Λ _ _).mpr
      refine ⟨⟨1, map_one _⟩, fun _ => ⟨?_, ?_⟩⟩
      · intro j
        simp only [Pi.single_apply]
        split_ifs <;> norm_num
      · intro j hj
        have hji : j ≠ i := by intro he; subst j; exact hj hi
        simp [Pi.single_eq_of_ne hji]

/-- Every collected coefficient is still an image of the original coefficient ring,
including the zero coefficient. -/
theorem selectedFormalRing_coeff (O : Subring K) (Λ : Set ℕ) {n : ℕ}
    {f : Laurent (FractionRing O) n} (hf : f ∈ selectedFormalRing O Λ n)
    (β : Fin n → ℤ) :
    ∃ c : O, algebraMap O (FractionRing O) c = f.coeff β :=
  ((selectedFormalRing_le_support O Λ n hf) β).1

/-- Every nonzero collected term has original coefficients and selected nonnegative exponents. -/
theorem selectedFormalRing_term (O : Subring K) (Λ : Set ℕ) {n : ℕ}
    {f : Laurent (FractionRing O) n} (hf : f ∈ selectedFormalRing O Λ n)
    (β : Fin n → ℤ) (hβ : f.coeff β ≠ 0) :
    (∃ c : O, algebraMap O (FractionRing O) c = f.coeff β) ∧
      (∀ i, 0 ≤ β i) ∧ (∀ i, i.val ∉ Λ → β i = 0) := by
  have h := (selectedFormalRing_le_support O Λ n hf) β
  exact ⟨h.1, h.2 hβ⟩

end HereditaryAtomicity.DVRBase
