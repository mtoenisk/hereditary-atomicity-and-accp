import HereditaryAtomicity.DVRBase.CoefficientDivision
import HereditaryAtomicity.ArithmeticCoefficients
import Mathlib.Data.Nat.Prime.Int

/-!
# The rational-prime coefficient ring

The literal image of ℤ_(p) in a characteristic-zero field is a DVR with
uniformizer exactly p. It lies in every local subring where p is a nonunit;
no algebraicity of the ambient field over ℚ is required.
-/

noncomputable section
namespace HereditaryAtomicity.DVRBase
open scoped NNReal

/-- The integer prime generated by the prescribed rational prime. -/
def rationalPrimeIdeal (p : ℕ) : Ideal ℤ := Ideal.span {(p : ℤ)}

instance rationalPrimeIdeal_isPrime (p : ℕ) [Fact p.Prime] :
    (rationalPrimeIdeal p).IsPrime := by
  apply (Ideal.span_singleton_prime (by exact_mod_cast (Fact.out : p.Prime).ne_zero)).mpr
  exact Nat.prime_iff_prime_int.mp Fact.out

theorem rationalPrimeIdeal_ne_bot (p : ℕ) [Fact p.Prime] :
    rationalPrimeIdeal p ≠ ⊥ := by
  intro h
  have hp : (p : ℤ) ∈ rationalPrimeIdeal p := Ideal.subset_span (Set.mem_singleton _)
  rw [h] at hp
  exact (Nat.prime_iff_prime_int.mp (Fact.out : p.Prime)).ne_zero (Ideal.mem_bot.mp hp)

instance rationalPrimeIdeal_isMaximal (p : ℕ) [Fact p.Prime] :
    (rationalPrimeIdeal p).IsMaximal :=
  (rationalPrimeIdeal_isPrime p).isMaximal_of_ne_bot (rationalPrimeIdeal_ne_bot p)

/-- The abstract localization ℤ_(p), used only to define its canonical image. -/
abbrev rationalPrimeLocalization (p : ℕ) [Fact p.Prime] :=
  Localization.AtPrime (rationalPrimeIdeal p)

instance rationalPrimeLocalization_dvr (p : ℕ) [Fact p.Prime] :
    IsDiscreteValuationRing (rationalPrimeLocalization p) :=
  IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ℤ
    (rationalPrimeIdeal_ne_bot p) _

variable (p : ℕ) [Fact p.Prime] (K : Type*) [Field K] [CharZero K]

/-- Denominators off (p) are nonzero in every characteristic-zero field. -/
theorem rationalPrime_denominator_unit (s : (rationalPrimeIdeal p).primeCompl) :
    IsUnit ((s : ℤ) : K) := by
  apply isUnit_iff_ne_zero.mpr
  have hs : (s : ℤ) ≠ 0 := by
    intro hs
    exact s.property (by rw [hs]; exact Ideal.zero_mem _)
  exact_mod_cast hs

/-- The canonical map ℤ_(p) → K. -/
def rationalCoefficientMap : rationalPrimeLocalization p →+* K :=
  IsLocalization.lift (g := Int.castRingHom K) (rationalPrime_denominator_unit p K)

@[simp] theorem rationalCoefficientMap_int (n : ℤ) :
    rationalCoefficientMap p K (algebraMap ℤ _ n) = (n : K) :=
  IsLocalization.lift_eq (rationalPrime_denominator_unit p K) n

theorem rationalCoefficientMap_injective :
    Function.Injective (rationalCoefficientMap p K) := by
  rw [rationalCoefficientMap, IsLocalization.lift_injective_iff]
  intro a b
  rw [(IsLocalization.injective (rationalPrimeLocalization p)
    (rationalPrimeIdeal p).primeCompl_le_nonZeroDivisors).eq_iff]
  change a = b ↔ (a : K) = (b : K)
  exact Int.cast_injective.eq_iff.symm

/-- The literal rational-prime coefficient subring of the ambient field. -/
def rationalCoefficientRing : Subring K := (rationalCoefficientMap p K).range

/-- The canonical localization is isomorphic to its literal image. -/
def rationalCoefficientEquiv : rationalPrimeLocalization p ≃+* rationalCoefficientRing p K :=
  RingEquiv.ofBijective (rationalCoefficientMap p K).rangeRestrict
    ⟨fun _ _ h => rationalCoefficientMap_injective p K (congrArg Subtype.val h),
      (rationalCoefficientMap p K).rangeRestrict_surjective⟩

instance rationalCoefficientRing_dvr : IsDiscreteValuationRing (rationalCoefficientRing p K) :=
  IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing (rationalCoefficientEquiv p K)

/-- The exact rational prime, viewed in the actual coefficient ring. -/
def rationalCoefficientUniformizer : rationalCoefficientRing p K :=
  rationalCoefficientEquiv p K (algebraMap ℤ (rationalPrimeLocalization p) (p : ℤ))

@[simp] theorem rationalCoefficientUniformizer_coe :
    (rationalCoefficientUniformizer p K : K) = (p : K) := by
  change rationalCoefficientMap p K (algebraMap ℤ _ (p : ℤ)) = (p : K)
  simp

theorem rationalCoefficientUniformizer_irreducible :
    Irreducible (rationalCoefficientUniformizer p K) := by
  apply (MulEquiv.irreducible_iff (f := (rationalCoefficientEquiv p K).toMulEquiv)).mpr
  rw [IsDiscreteValuationRing.irreducible_iff_uniformizer,
    ← IsLocalization.AtPrime.map_eq_maximalIdeal (rationalPrimeIdeal p)
      (rationalPrimeLocalization p)]
  simp only [rationalPrimeIdeal, Ideal.map_span, Set.image_singleton]

/-- A local ring where p is nonunit has integer residue prime exactly (p). -/
theorem intResiduePrime_eq_rationalPrimeIdeal
    (S : Type*) [CommRing S] [IsLocalRing S]
    (hpS : (p : S) ∈ IsLocalRing.maximalIdeal S) :
    intResiduePrime S = rationalPrimeIdeal p := by
  symm
  apply (rationalPrimeIdeal_isMaximal p).eq_of_le (inferInstance : (intResiduePrime S).IsPrime).ne_top
  apply Ideal.span_le.mpr
  rintro a rfl
  change IsLocalRing.residue S ((p : ℤ) : S) = 0
  rw [Int.cast_natCast]
  exact (IsLocalRing.residue_eq_zero_iff _).mpr hpS

/-- Every local subring in which p is nonunit contains the same actual ℤ_(p).
The local subring need not have K as its fraction field. -/
theorem rationalCoefficientRing_le_local
    (S : Subring K) [IsLocalRing S]
    (hpS : (p : S) ∈ IsLocalRing.maximalIdeal S) :
    rationalCoefficientRing p K ≤ S := by
  have hP := intResiduePrime_eq_rationalPrimeIdeal p S hpS
  have hu (s : (rationalPrimeIdeal p).primeCompl) : IsUnit ((s : ℤ) : S) := by
    apply int_residue_kernel_denominator_unit S
      ⟨s, by simpa only [hP] using s.property⟩
  let f : rationalPrimeLocalization p →+* S := IsLocalization.lift (g := Int.castRingHom S) hu
  have he : S.subtype.comp f = rationalCoefficientMap p K := by
    apply IsLocalization.ringHom_ext (rationalPrimeIdeal p).primeCompl
    ext n
    simp only [RingHom.comp_apply, rationalCoefficientMap_int]
    have hf : f (algebraMap ℤ (rationalPrimeLocalization p) n) = (n : S) :=
      IsLocalization.lift_eq hu n
    change (f (algebraMap ℤ (rationalPrimeLocalization p) n) : K) = (n : K)
    rw [hf]
    rfl
  rintro x ⟨a, rfl⟩
  rw [← he]
  exact (f a).property

/-- A bounded normalized valuation makes the actual rational-prime base
satisfy division closure, with its prescribed uniformizer exactly p. -/
theorem rationalCoefficientRing_uniformizerDivisionClosed
    (O : Subring K) [IsLocalRing O]
    (hpO : (p : O) ∈ IsLocalRing.maximalIdeal O)
    (w : Valuation K ℝ≥0) (hO : ∀ a : O, w (a : K) ≤ 1)
    (hnorm : realValuationOrder w (p : K) = 1) :
    UniformizerDivisionClosed (rationalCoefficientRing p K)
      (rationalCoefficientUniformizer p K) w := by
  have hBO := rationalCoefficientRing_le_local p K O hpO
  apply uniformizerDivisionClosed_of_dvr _ _
    (rationalCoefficientUniformizer_irreducible p K) w
    (fun b => hO ⟨b, hBO b.property⟩)
  simpa using hnorm

/-- The canonical rational-prime DVR is a coefficient base simultaneously
in the source local ring and in an outside model DVR with uniformizer p. -/
theorem exists_rational_coefficient_base
    (R O : Subring K) [IsLocalRing R] [IsDiscreteValuationRing O]
    (hpR : (p : R) ∈ IsLocalRing.maximalIdeal R)
    (πO : O) (hπO : Irreducible πO) (hπeq : (πO : K) = (p : K))
    (w : Valuation K ℝ≥0) (hO : ∀ a : O, w (a : K) ≤ 1)
    (hnorm : realValuationOrder w (πO : K) = 1) :
    ∃ (B : Subring K) (πB : B) (hBO : B ≤ O) (_hBR : B ≤ R),
      B = rationalCoefficientRing p K ∧ IsDiscreteValuationRing B ∧
      (πB : K) = (πO : K) ∧ Irreducible πB ∧
      Irreducible (Subring.inclusion hBO πB) ∧
      UniformizerDivisionClosed B πB w ∧ (∀ b : B, w (b : K) ≤ 1) := by
  have hpO : (p : O) ∈ IsLocalRing.maximalIdeal O := by
    have he : (p : O) = πO := Subtype.ext hπeq.symm
    rw [he, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact hπO.not_isUnit
  let B := rationalCoefficientRing p K
  let πB := rationalCoefficientUniformizer p K
  have hBO : B ≤ O := rationalCoefficientRing_le_local p K O hpO
  have hBR : B ≤ R := rationalCoefficientRing_le_local p K R hpR
  have hπB : (πB : K) = (πO : K) := (rationalCoefficientUniformizer_coe p K).trans hπeq.symm
  refine ⟨B, πB, hBO, hBR, rfl, inferInstance, hπB,
    rationalCoefficientUniformizer_irreducible p K, ?_, ?_,
    fun b => hO ⟨b, hBO b.property⟩⟩
  · have he : Subring.inclusion hBO πB = πO := Subtype.ext hπB
    exact he.symm ▸ hπO
  · exact rationalCoefficientRing_uniformizerDivisionClosed p K O hpO w hO
      (hπeq ▸ hnorm)

end HereditaryAtomicity.DVRBase
