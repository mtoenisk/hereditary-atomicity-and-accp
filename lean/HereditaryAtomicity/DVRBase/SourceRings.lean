import HereditaryAtomicity.ConductorBranches
import Mathlib.LinearAlgebra.Span.Defs
import Mathlib.Algebra.Order.Monovary

/-!
# The chain ideal and its source subring

For a chain with z n = z (n+1) * y n, the ascending union of the principal endpoint
ideals is an ideal. Adding it to the subring on selected ratios permits division
inside that same ring.
-/

noncomputable section
namespace HereditaryAtomicity.DVRBase
open scoped NNReal

variable {R : Type*} [CommRing R]

/-- The actual subring generated over a coefficient subring by a set of elements. -/
def generatedOver (O : Subring R) (G : Set R) : Subring R := O ⊔ Subring.closure G

theorem coefficient_le_generatedOver (O : Subring R) (G : Set R) :
    O ≤ generatedOver O G := le_sup_left

theorem generators_subset_generatedOver (O : Subring R) (G : Set R) :
    G ⊆ generatedOver O G :=
  fun _ hx => (show Subring.closure G ≤ generatedOver O G from le_sup_right)
    (Subring.subset_closure hx)

theorem generatedOver_le (O C : Subring R) (G : Set R)
    (hOC : O ≤ C) (hG : G ⊆ C) : generatedOver O G ≤ C :=
  sup_le hOC (Subring.closure_le.mpr hG)

/-- The literal generator ring O[y_n,z_n,G] used before adjoining the chain ideal. -/
def sourceGeneratorRing (O : Subring R) (z y : ℕ → R) (G : Set R) : Subring R :=
  generatedOver O (Set.range z ∪ Set.range y ∪ G)

theorem endpoint_mem_sourceGeneratorRing (O : Subring R) (z y : ℕ → R)
    (G : Set R) (n : ℕ) : z n ∈ sourceGeneratorRing O z y G :=
  generators_subset_generatedOver O _ (Or.inl (Or.inl ⟨n, rfl⟩))

theorem ratio_mem_sourceGeneratorRing (O : Subring R) (z y : ℕ → R)
    (G : Set R) (n : ℕ) : y n ∈ sourceGeneratorRing O z y G :=
  generators_subset_generatedOver O _ (Or.inl (Or.inr ⟨n, rfl⟩))

theorem extra_subset_sourceGeneratorRing (O : Subring R) (z y : ℕ → R)
    (G : Set R) : G ⊆ sourceGeneratorRing O z y G :=
  fun _ hx => generators_subset_generatedOver O _ (Or.inr hx)

theorem sourceGeneratorRing_le (O C : Subring R) (z y : ℕ → R) (G : Set R)
    (hOC : O ≤ C) (hz : ∀ n, z n ∈ C) (hy : ∀ n, y n ∈ C)
    (hG : G ⊆ C) : sourceGeneratorRing O z y G ≤ C := by
  apply generatedOver_le O C _ hOC
  rintro x ((⟨n, rfl⟩ | ⟨n, rfl⟩) | hx)
  · exact hz n
  · exact hy n
  · exact hG hx

/-- Every expression in a ring generated by an increasing union occurs at one
finite stage, with all coefficient-ring elements retained at every stage. -/
theorem mem_generatedOver_iUnion_iff (O : Subring R) (G : ℕ → Set R)
    (hG : Monotone G) (x : R) :
    x ∈ generatedOver O (⋃ n, G n) ↔ ∃ n, x ∈ generatedOver O (G n) := by
  have hmono : Monotone (fun n => generatedOver O (G n)) := by
    intro n m hnm
    exact sup_le_sup_left (Subring.closure_mono (hG hnm)) O
  have heq : generatedOver O (⋃ n, G n) = ⨆ n, generatedOver O (G n) := by
    apply le_antisymm
    · apply generatedOver_le
      · exact (coefficient_le_generatedOver O (G 0)).trans
          (le_iSup (fun n => generatedOver O (G n)) 0)
      · intro a ha
        obtain ⟨n, hn⟩ := Set.mem_iUnion.mp ha
        exact (le_iSup (fun n => generatedOver O (G n)) n)
          (generators_subset_generatedOver O (G n) hn)
    · apply iSup_le
      intro n
      exact generatedOver_le O _ (G n)
        (coefficient_le_generatedOver O _)
        (fun a ha => generators_subset_generatedOver O _
          (Set.mem_iUnion.mpr ⟨n, ha⟩))
  rw [heq, Subring.mem_iSup_of_directed hmono.directed_le]

/-- The ideal generated by all endpoints of a chain. Under the exact chain
equations below, it is also their ascending union. -/
def chainIdeal (z : ℕ → R) : Ideal R := ⨆ n, Ideal.span {z n}

theorem chain_principal_monotone (z y : ℕ → R)
    (hstep : ∀ n, z n = z (n + 1) * y n) :
    Monotone (fun n => Ideal.span ({z n} : Set R)) := by
  apply monotone_nat_of_le_succ
  intro n
  exact Ideal.span_singleton_le_span_singleton.mpr ⟨y n, hstep n⟩

/-- An element of the chain ideal is a multiple of one actual endpoint. -/
theorem mem_chainIdeal_iff (z y : ℕ → R)
    (hstep : ∀ n, z n = z (n + 1) * y n) (g : R) :
    g ∈ chainIdeal z ↔ ∃ n, ∃ q : R, g = z n * q := by
  rw [chainIdeal, Submodule.mem_iSup_of_directed _
    (chain_principal_monotone z y hstep).directed_le]
  simp only [Ideal.mem_span_singleton, dvd_def]

theorem endpoint_mem_chainIdeal (z : ℕ → R) (n : ℕ) : z n ∈ chainIdeal z :=
  (le_iSup (fun i => Ideal.span ({z i} : Set R)) n)
    (Ideal.subset_span (Set.mem_singleton _))

/-- Removing any finite initial segment leaves the same chain ideal. -/
theorem mem_chainIdeal_iff_exists_ge (z y : ℕ → R)
    (hstep : ∀ n, z n = z (n + 1) * y n) (g : R) (N : ℕ) :
    g ∈ chainIdeal z ↔ ∃ n : ℕ, N ≤ n ∧ ∃ q : R, g = z n * q := by
  constructor
  · intro hg
    obtain ⟨n, q, hq⟩ := (mem_chainIdeal_iff z y hstep g).mp hg
    have hm : g ∈ Ideal.span ({z (max N n)} : Set R) :=
      chain_principal_monotone z y hstep (le_max_right N n)
        (Ideal.mem_span_singleton.mpr ⟨q, hq⟩)
    exact ⟨max N n, le_max_left N n, Ideal.mem_span_singleton.mp hm⟩
  · rintro ⟨n, _, q, hq⟩
    exact (mem_chainIdeal_iff z y hstep g).mpr ⟨n, q, hq⟩

/-- The literal subring consisting of a base-ring element plus an ideal element. -/
def idealThickening (B : Subring R) (J : Ideal R) : Subring R where
  carrier := {x | ∃ b : R, b ∈ B ∧ x - b ∈ J}
  zero_mem' := ⟨0, B.zero_mem, by simp⟩
  one_mem' := ⟨1, B.one_mem, by simp⟩
  add_mem' := by
    rintro x y ⟨b, hb, hx⟩ ⟨c, hc, hy⟩
    refine ⟨b + c, B.add_mem hb hc, ?_⟩
    have heq : x + y - (b + c) = (x - b) + (y - c) := by ring
    rw [heq]
    exact J.add_mem hx hy
  neg_mem' := by
    rintro x ⟨b, hb, hx⟩
    refine ⟨-b, B.neg_mem hb, ?_⟩
    have heq : -x - -b = -(x - b) := by ring
    rw [heq]
    exact J.neg_mem hx
  mul_mem' := by
    rintro x y ⟨b, hb, hx⟩ ⟨c, hc, hy⟩
    refine ⟨b * c, B.mul_mem hb hc, ?_⟩
    have heq : x * y - b * c = (x - b) * y + b * (y - c) := by ring
    rw [heq]
    exact J.add_mem (J.mul_mem_right y hx) (J.mul_mem_left b hy)

theorem mem_idealThickening_iff (B : Subring R) (J : Ideal R) (x : R) :
    x ∈ idealThickening B J ↔ ∃ b : R, b ∈ B ∧ ∃ j : R, j ∈ J ∧ x = b + j := by
  constructor
  · rintro ⟨b, hb, hx⟩
    exact ⟨b, hb, x - b, hx, by ring⟩
  · rintro ⟨b, hb, j, hj, rfl⟩
    exact ⟨b, hb, by simpa using hj⟩

theorem base_le_idealThickening (B : Subring R) (J : Ideal R) :
    B ≤ idealThickening B J := by
  intro b hb
  exact ⟨b, hb, by simp⟩

theorem ideal_subset_idealThickening (B : Subring R) (J : Ideal R) :
    (J : Set R) ⊆ idealThickening B J := by
  intro j hj
  exact ⟨0, B.zero_mem, by simpa using hj⟩

/-- Each element of the source ring has a single finite-stage endpoint remainder. -/
theorem mem_chainThickening_iff (B : Subring R) (z y : ℕ → R)
    (hstep : ∀ n, z n = z (n + 1) * y n) (x : R) :
    x ∈ idealThickening B (chainIdeal z) ↔
      ∃ b : R, b ∈ B ∧ ∃ n : ℕ, ∃ q : R, x = b + z n * q := by
  rw [mem_idealThickening_iff]
  constructor
  · rintro ⟨b, hb, j, hj, rfl⟩
    obtain ⟨n, q, rfl⟩ := (mem_chainIdeal_iff z y hstep j).mp hj
    exact ⟨b, hb, n, q, rfl⟩
  · rintro ⟨b, hb, n, q, rfl⟩
    refine ⟨b, hb, z n * q, ?_, rfl⟩
    exact (chainIdeal z).mul_mem_right q (endpoint_mem_chainIdeal z n)

/-- Cofinal selected ratios divide every ideal element, with quotient still in
the same chain ideal. The selected index can exceed any prescribed threshold. -/
theorem exists_fresh_chainIdeal_factor (z y : ℕ → R)
    (hstep : ∀ n, z n = z (n + 1) * y n)
    (Λ : Set ℕ) (hcofinal : ∀ N : ℕ, ∃ m, N ≤ m ∧ m ∈ Λ)
    {g : R} (hg : g ∈ chainIdeal z) (N : ℕ) :
    ∃ m : ℕ, N ≤ m ∧ m ∈ Λ ∧ ∃ q : R, q ∈ chainIdeal z ∧ g = y m * q := by
  obtain ⟨n, a, ha⟩ := (mem_chainIdeal_iff z y hstep g).mp hg
  obtain ⟨m, hm, hmΛ⟩ := hcofinal (max N n)
  have hnm : n ≤ m := (le_max_right N n).trans hm
  have hgm : g ∈ Ideal.span ({z m} : Set R) :=
    chain_principal_monotone z y hstep hnm (Ideal.mem_span_singleton.mpr ⟨a, ha⟩)
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp hgm
  refine ⟨m, (le_max_left N n).trans hm, hmΛ, z (m + 1) * b,
    (chainIdeal z).mul_mem_right b (endpoint_mem_chainIdeal z (m + 1)), ?_⟩
  rw [hb, hstep m]
  ring

section Valued

variable {K : Type*} [Field K]

/-- Positive endpoint values force positive values on every nonzero chain-ideal
element, using actual source membership of its multiplier. -/
theorem chainIdeal_order_pos (z y : ℕ → R)
    (hstep : ∀ n, z n = z (n + 1) * y n)
    (f : R →+* K) (hf : Function.Injective f) (v : Valuation K ℝ≥0)
    (hv : ∀ r : R, v (f r) ≤ 1)
    (hz : ∀ n, 0 < realValuationOrder v (f (z n)))
    {g : R} (hg : g ∈ chainIdeal z) (hg0 : g ≠ 0) :
    0 < realValuationOrder v (f g) := by
  obtain ⟨n, q, rfl⟩ := (mem_chainIdeal_iff z y hstep g).mp hg
  have hp : f (z n) * f q ≠ 0 := by
    rw [← map_mul]
    exact (map_ne_zero_iff f hf).mpr hg0
  obtain ⟨hzn, hq⟩ := mul_ne_zero_iff.mp hp
  rw [map_mul, realValuationOrder_mul v hzn hq]
  exact add_pos_of_pos_of_nonneg (hz n)
    ((realValuationOrder_nonneg_iff v hq).mpr (hv q))

/-- Valuation positivity gives intrinsic nonunit status under any ring map
whose whole source is contained in the valuation ring. -/
theorem not_isUnit_of_mapped_order_pos
    (f : R →+* K) (v : Valuation K ℝ≥0) (hv : ∀ r : R, v (f r) ≤ 1)
    {r : R} (hr : 0 < realValuationOrder v (f r)) : ¬ IsUnit r := by
  intro hu
  have hval := coefficient_unit_value f v hv hu
  simp only [realValuationOrder, hval, NNReal.coe_one, Real.log_one, neg_zero] at hr
  exact (lt_irrefl 0) hr

/-- Every nonzero chain-ideal element splits into two intrinsic nonunits of
the actual source ring B+J, when cofinally selected positive ratios belong to B. -/
theorem exists_nonunit_factors_in_chainThickening
    (B : Subring R) (z y : ℕ → R)
    (hstep : ∀ n, z n = z (n + 1) * y n)
    (Λ : Set ℕ) (hcofinal : ∀ N : ℕ, ∃ m, N ≤ m ∧ m ∈ Λ)
    (hB : ∀ m ∈ Λ, y m ∈ B)
    (f : R →+* K) (hf : Function.Injective f) (v : Valuation K ℝ≥0)
    (hv : ∀ r : R, v (f r) ≤ 1)
    (hz : ∀ n, 0 < realValuationOrder v (f (z n)))
    (hy : ∀ m ∈ Λ, 0 < realValuationOrder v (f (y m)))
    (g : idealThickening B (chainIdeal z)) (hg : (g : R) ∈ chainIdeal z)
    (hg0 : g ≠ 0) :
    ∃ b c : idealThickening B (chainIdeal z),
      ¬ IsUnit b ∧ ¬ IsUnit c ∧ g = b * c := by
  obtain ⟨m, _, hm, q, hq, heq⟩ :=
    exists_fresh_chainIdeal_factor z y hstep Λ hcofinal hg 0
  have hgR : (g : R) ≠ 0 := Subtype.coe_ne_coe.mpr hg0
  have hq0 : q ≠ 0 := by
    intro hqzero
    exact hgR (by simpa [hqzero] using heq)
  let b : idealThickening B (chainIdeal z) :=
    ⟨y m, base_le_idealThickening B (chainIdeal z) (hB m hm)⟩
  let c : idealThickening B (chainIdeal z) :=
    ⟨q, ideal_subset_idealThickening B (chainIdeal z) hq⟩
  refine ⟨b, c, ?_, ?_, Subtype.ext heq⟩
  · intro hu
    exact not_isUnit_of_mapped_order_pos f v hv (hy m hm)
      (hu.map (idealThickening B (chainIdeal z)).subtype)
  · intro hu
    exact not_isUnit_of_mapped_order_pos f v hv
      (chainIdeal_order_pos z y hstep f hf v hv hz hq hq0)
      (hu.map (idealThickening B (chainIdeal z)).subtype)

end Valued
end HereditaryAtomicity.DVRBase
