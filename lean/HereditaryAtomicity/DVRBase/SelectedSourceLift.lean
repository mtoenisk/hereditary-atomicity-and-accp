import HereditaryAtomicity.DVRBase.SelectedPolynomialSupport
import HereditaryAtomicity.DVRBase.SourceLaurent

/-!
# Selected-variable source lifts at a common finite stage

The formal selected ring uses the original coefficient subring. Every-large-stage
lifts follow from monotone generator sets, without reindexing Laurent rings.
-/

noncomputable section
namespace HereditaryAtomicity.DVRBase
open scoped BigOperators

/-- Finitely many eventual stage requirements hold beyond one common maximum. -/
theorem exists_common_stage_of_finite {ι : Type*} (s : Finset ι) (P : ι → ℕ → Prop)
    (hP : ∀ i ∈ s, ∃ N : ℕ, ∀ n, N ≤ n → P i n) :
    ∃ N : ℕ, ∀ n, N ≤ n → ∀ i ∈ s, P i n := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | @insert i s hi ih =>
      obtain ⟨Ni, hNi⟩ := hP i (Finset.mem_insert_self _ _)
      obtain ⟨Ns, hNs⟩ := ih (fun j hj => hP j (Finset.mem_insert_of_mem hj))
      refine ⟨max Ni Ns, fun n hn j hj => ?_⟩
      rcases Finset.mem_insert.mp hj with rfl | hj
      · exact hNi n ((le_max_left _ _).trans hn)
      · exact hNs n ((le_max_right _ _).trans hn) j hj

namespace SourceBlockData
variable {K : Type*} [Field K] {R : Subring K} (D : SourceBlockData R)

/-- The selected actual ratios occurring strictly before the finite cut. -/
def selectedRatiosAt (Λ : Set ℕ) (n : ℕ) : Set K :=
  {x | ∃ i < n, i ∈ Λ ∧ x = (D.ratio i : K)}

theorem selectedRatiosAt_mono (Λ : Set ℕ) : Monotone (D.selectedRatiosAt Λ) := by
  intro n m hnm x hx
  obtain ⟨i, hi, hiΛ, rfl⟩ := hx
  exact ⟨i, hi.trans_le hnm, hiΛ, rfl⟩

theorem selectedRatiosAt_iUnion (Λ : Set ℕ) :
    (⋃ n, D.selectedRatiosAt Λ n) = {x | ∃ i ∈ Λ, x = (D.ratio i : K)} := by
  ext x
  constructor
  · intro hx
    obtain ⟨n, i, _, hiΛ, he⟩ := Set.mem_iUnion.mp hx
    exact ⟨i, hiΛ, he⟩
  · rintro ⟨i, hiΛ, rfl⟩
    exact Set.mem_iUnion.mpr ⟨i + 1, i, Nat.lt_succ_self i, hiΛ, rfl⟩

/-- Selected polynomial generators are among the literal finite source generators. -/
theorem selectedFormalRing_le_formalRing (O : Subring K) (π : O) (Λ : Set ℕ) (n : ℕ) :
    selectedFormalRing O Λ n ≤ D.formalRing O π n := by
  apply Subring.closure_le.mpr
  intro f hf
  cases hf with
  | coefficient a => exact Subring.subset_closure (FormalGenerator.coefficient a)
  | coordinate i _ => exact Subring.subset_closure (FormalGenerator.coordinate i)

/-- The finite selected formal ring evaluates to exactly the corresponding actual ratio ring. -/
theorem selectedFormalRing_map_evaluation (O : Subring K) (Λ : Set ℕ) (n : ℕ) :
    (selectedFormalRing O Λ n).map (D.evaluation O n) = generatedOver O (D.selectedRatiosAt Λ n) := by
  apply le_antisymm
  · rw [selectedFormalRing, RingHom.map_closure]
    apply Subring.closure_le.mpr
    rintro x ⟨f, hf, rfl⟩
    cases hf with
    | coefficient a =>
        rw [D.evaluation_coefficient]
        exact coefficient_le_generatedOver O _ a.property
    | coordinate i hi =>
        rw [D.evaluation_variable]
        exact generators_subset_generatedOver O _ ⟨i.val, i.isLt, hi, rfl⟩
  · apply generatedOver_le
    · intro a ha
      exact ⟨_, selectedFormalRing_coefficient O Λ n ⟨a, ha⟩,
        D.evaluation_coefficient O ⟨a, ha⟩⟩
    · rintro x ⟨i, hi, hiΛ, rfl⟩
      exact ⟨_, selectedFormalRing_variable O Λ (⟨i, hi⟩ : Fin n) hiΛ,
        D.evaluation_variable O ⟨i, hi⟩⟩

/-- The intrinsic selected base lies in the ambient ring generated by the same selected ratios. -/
theorem selectedBase_coe_mem (O : Subring K) (Λ : Set ℕ)
    (b : D.sourceRing O) (hb : b ∈ D.selectedBase O Λ) :
    (b : K) ∈ generatedOver O {x | ∃ i ∈ Λ, x = (D.ratio i : K)} := by
  have hle : D.selectedBase O Λ ≤
      (generatedOver O {x | ∃ i ∈ Λ, x = (D.ratio i : K)}).comap (D.sourceRing O).subtype := by
    apply generatedOver_le
    · intro x hx
      exact coefficient_le_generatedOver O _ hx
    · rintro x ⟨i, hi, rfl⟩
      exact generators_subset_generatedOver O _ ⟨i, hi, rfl⟩
  exact hle hb

/-- Every intrinsic selected-base element has a selected polynomial lift at every sufficiently large stage. -/
theorem exists_selectedFormal_lift_ge (O : Subring K) (Λ : Set ℕ)
    (b : D.sourceRing O) (hb : b ∈ D.selectedBase O Λ) :
    ∃ N : ℕ, ∀ n, N ≤ n → ∃ p : Laurent (FractionRing O) n,
      p ∈ selectedFormalRing O Λ n ∧ D.evaluation O n p = (b : K) := by
  have hb' := D.selectedBase_coe_mem O Λ b hb
  rw [← D.selectedRatiosAt_iUnion Λ] at hb'
  obtain ⟨N, hN⟩ := (mem_generatedOver_iUnion_iff O (D.selectedRatiosAt Λ)
    (D.selectedRatiosAt_mono Λ) (b : K)).mp hb'
  refine ⟨N, fun n hn => ?_⟩
  have hn' : (b : K) ∈ generatedOver O (D.selectedRatiosAt Λ n) :=
    (sup_le_sup_left (Subring.closure_mono (D.selectedRatiosAt_mono Λ hn)) O) hN
  rw [← D.selectedFormalRing_map_evaluation O Λ n] at hn'
  exact hn'

/-- Every source-ring element has an actual formal source lift at every sufficiently large stage. -/
theorem exists_formal_lift_ge (O : Subring K) (π : O)
    (hπ : (π : K) = (D.uniformizer : K)) (x : D.sourceRing O) :
    ∃ N : ℕ, ∀ n, N ≤ n → ∃ q : Laurent (FractionRing O) n,
      q ∈ D.formalRing O π n ∧ D.evaluation O n q = (x : K) := by
  obtain ⟨N, hN⟩ := (D.mem_sourceRing_iff_finite_stage O (x : K)).mp x.property
  refine ⟨N, fun n hn => ?_⟩
  have hn' : (x : K) ∈ generatedOver O (D.generatorsAt n) :=
    (sup_le_sup_left (Subring.closure_mono (D.generatorsAt_mono hn)) O) hN
  rw [← D.formalRing_map_evaluation O π hπ n] at hn'
  exact hn'

/-- A finite family of selected/source pairs lifts at every sufficiently large common stage,
which can also exceed any prescribed endpoint indices. -/
theorem exists_common_formal_lifts (O : Subring K) (π : O)
    (hπ : (π : K) = (D.uniformizer : K)) (Λ : Set ℕ)
    {ι : Type*} (s : Finset ι) (b q : ι → D.sourceRing O) (m : ι → ℕ)
    (hb : ∀ i ∈ s, b i ∈ D.selectedBase O Λ) :
    ∃ N : ℕ, ∀ n, N ≤ n → ∀ i ∈ s, m i ≤ n ∧
      ∃ p : Laurent (FractionRing O) n, p ∈ selectedFormalRing O Λ n ∧
        D.evaluation O n p = (b i : K) ∧
      ∃ r : Laurent (FractionRing O) n, r ∈ D.formalRing O π n ∧
        D.evaluation O n r = (q i : K) := by
  apply exists_common_stage_of_finite s
  intro i hi
  obtain ⟨Nb, hNb⟩ := D.exists_selectedFormal_lift_ge O Λ (b i) (hb i hi)
  obtain ⟨Nq, hNq⟩ := D.exists_formal_lift_ge O π hπ (q i)
  refine ⟨max (m i) (max Nb Nq), fun n hn => ?_⟩
  obtain ⟨p, hp, hep⟩ := hNb n (by omega)
  obtain ⟨r, hr, her⟩ := hNq n (by omega)
  exact ⟨by omega, p, hp, hep, r, hr, her⟩

/-- A source-thickening element lifts as a selected polynomial plus an actual endpoint multiple,
with the endpoint index bounded by every sufficiently large stage. -/
theorem exists_sourceThickening_lift_ge (O : Subring K) (π : O)
    (hπ : (π : K) = (D.uniformizer : K)) (Λ : Set ℕ)
    (x : D.sourceRing O) (hx : x ∈ D.sourceThickening O Λ) :
    ∃ N : ℕ, ∀ n, N ≤ n → ∃ m : ℕ, m ≤ n ∧
      ∃ p : Laurent (FractionRing O) n, p ∈ selectedFormalRing O Λ n ∧
      ∃ q : Laurent (FractionRing O) n, q ∈ D.formalRing O π n ∧
        D.evaluation O n (p + endpointMonomial (algebraMap O (FractionRing O) π) D.exponent m * q) =
          (x : K) := by
  obtain ⟨b, hb, m, q, he⟩ := (D.mem_sourceThickening_iff O Λ x).mp hx
  obtain ⟨Nb, hNb⟩ := D.exists_selectedFormal_lift_ge O Λ b hb
  obtain ⟨Nq, hNq⟩ := D.exists_formal_lift_ge O π hπ q
  refine ⟨max m (max Nb Nq), fun n hn => ?_⟩
  have hmn : m ≤ n := by omega
  obtain ⟨p, hp, hep⟩ := hNb n (by omega)
  obtain ⟨r, hr, her⟩ := hNq n (by omega)
  refine ⟨m, hmn, p, hp, r, hr, ?_⟩
  rw [map_add, map_mul, hep, her, D.evaluation_endpoint O π hπ m hmn]
  exact (congrArg (D.sourceRing O).subtype he).symm

/-- Finitely many thickening elements admit all their polynomial/endpoint decompositions
in one common finite Laurent ring, and in every later stage. -/
theorem exists_common_sourceThickening_lifts (O : Subring K) (π : O)
    (hπ : (π : K) = (D.uniformizer : K)) (Λ : Set ℕ)
    {ι : Type*} (s : Finset ι) (x : ι → D.sourceRing O)
    (hx : ∀ i ∈ s, x i ∈ D.sourceThickening O Λ) :
    ∃ N : ℕ, ∀ n, N ≤ n → ∀ i ∈ s, ∃ m : ℕ, m ≤ n ∧
      ∃ p : Laurent (FractionRing O) n, p ∈ selectedFormalRing O Λ n ∧
      ∃ q : Laurent (FractionRing O) n, q ∈ D.formalRing O π n ∧
        D.evaluation O n (p + endpointMonomial (algebraMap O (FractionRing O) π) D.exponent m * q) =
          (x i : K) := by
  exact exists_common_stage_of_finite s _
    (fun i hi => D.exists_sourceThickening_lift_ge O π hπ Λ (x i) (hx i hi))

end SourceBlockData
end HereditaryAtomicity.DVRBase
