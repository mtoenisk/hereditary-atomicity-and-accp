import HereditaryAtomicity.DVRBase.MovingBasis
import HereditaryAtomicity.DVRBase.MovingFields

/-!
# Actual moving monomial bases in finite field towers

Each field is the actual successive adjunction of the chosen nonzero algebraic
elements in one ambient normed field. No algebraicity of the entire ambient
completion is required. The basis is constructed from the actual power bases,
not taken as an additional hypothesis.
-/

noncomputable section
namespace HereditaryAtomicity.DVRBase

open scoped BigOperators


section Fields
variable {K E : Type*} [Field K] [Field E] [Algebra K E]
  {F G : IntermediateField K E}

@[simp] theorem intermediateField_equivOfEq_coe (h : F = G) (x : F) :
    ((IntermediateField.equivOfEq h x : G) : E) = (x : E) := rfl

@[simp] theorem intermediateField_equivOfEq_symm_coe (h : F = G) (x : G) :
    (((IntermediateField.equivOfEq h).symm x : F) : E) = (x : E) := rfl

@[simp] theorem intermediateField_equivOfEq_toLinearEquiv_coe (h : F = G) (x : F) :
    (((IntermediateField.equivOfEq h).toLinearEquiv x : G) : E) = (x : E) := rfl

/-- Equality of ambient vectors determines the transported field basis. -/
theorem intermediateField_basis_map_reindex_eq {ι ι' : Type*} (h : F = G)
    (b : Module.Basis ι K F) (c : Module.Basis ι' K G) (q : ι ≃ ι')
    (hbc : ∀ j, (b (q.symm j) : E) = (c j : E)) :
    (b.map (IntermediateField.equivOfEq h).toLinearEquiv).reindex q = c := by
  apply DFunLike.ext
  intro j
  rw [Module.Basis.reindex_apply, Module.Basis.map_apply]
  apply Subtype.ext
  rw [intermediateField_equivOfEq_toLinearEquiv_coe]
  exact hbc j

end Fields

section Norms
variable {K E : Type*} [Field K] [NormedField E] [Algebra K E]
  {F G : IntermediateField K E}

@[simp] theorem intermediateField_equivOfEq_norm (h : F = G) (x : F) :
    ‖IntermediateField.equivOfEq h x‖ = ‖x‖ := rfl

@[simp] theorem intermediateField_equivOfEq_symm_norm (h : F = G) (x : G) :
    ‖(IntermediateField.equivOfEq h).symm x‖ = ‖x‖ := rfl

/-- A bound for a basis survives an equality of ambient intermediate fields. -/
theorem intermediateField_basis_norm_bound_congr {ι ι' : Type*} (h : F = G)
    (b : Module.Basis ι K F) (c : Module.Basis ι' K G) (q : ι ≃ ι')
    (hbc : (b.map (IntermediateField.equivOfEq h).toLinearEquiv).reindex q = c)
    {C : ℝ} (hb : ∀ x : F, ∀ i, ‖b.repr x i • b i‖ ≤ C * ‖x‖) :
    ∀ x : G, ∀ i, ‖c.repr x i • c i‖ ≤ C * ‖x‖ := by
  rw [← hbc]
  intro x i
  let e := IntermediateField.equivOfEq h
  simp only [Module.Basis.repr_reindex_apply, Module.Basis.reindex_apply,
    Module.Basis.map_repr, Module.Basis.map_apply]
  change ‖b.repr (e.symm x) (q.symm i) • e (b (q.symm i))‖ ≤ C * ‖x‖
  rw [← map_smul, intermediateField_equivOfEq_norm]
  simpa only [e, intermediateField_equivOfEq_symm_norm] using hb (e.symm x) (q.symm i)

end Norms

section Prefix

def windowDegreeEquiv {N : ℕ} {D D' : Fin N → ℕ} (h : ∀ i, D i = D' i) :
    WindowExponent D ≃ WindowExponent D' where
  toFun β := ⟨β.val, fun i => by
    rw [← h i]
    exact β.property i⟩
  invFun β := ⟨β.val, fun i => by
    rw [h i]
    exact β.property i⟩
  left_inv β := Subtype.ext rfl
  right_inv β := Subtype.ext rfl

@[simp] theorem windowDegreeEquiv_val {N : ℕ} {D D' : Fin N → ℕ}
    (h : ∀ i, D i = D' i) (β : WindowExponent D) :
    (windowDegreeEquiv h β).val = β.val := rfl

@[simp] theorem windowDegreeEquiv_symm_val {N : ℕ} {D D' : Fin N → ℕ}
    (h : ∀ i, D i = D' i) (β : WindowExponent D') :
    ((windowDegreeEquiv h).symm β).val = β.val := rfl

variable (K : Type*) {E : Type*} [Field K] [Field E] [Algebra K E]

noncomputable def movingWindowPrefixEquiv {y z : ℕ → Eˣ} {n : ℕ}
    (h : ∀ i < n, y i = z i) :
    WindowExponent (fun i : Fin n => movingDegree K y i.val) ≃
      WindowExponent (fun i : Fin n => movingDegree K z i.val) :=
  windowDegreeEquiv fun i => movingDegree_congr_prefix K
    (fun j hj => h j (lt_of_le_of_lt hj i.isLt))

@[simp] theorem movingWindowPrefixEquiv_val {y z : ℕ → Eˣ} {n : ℕ}
    (h : ∀ i < n, y i = z i)
    (β : WindowExponent (fun i : Fin n => movingDegree K y i.val)) :
    (movingWindowPrefixEquiv K h β).val = β.val :=
  windowDegreeEquiv_val _ β

@[simp] theorem movingWindowPrefixEquiv_symm_val {y z : ℕ → Eˣ} {n : ℕ}
    (h : ∀ i < n, y i = z i)
    (β : WindowExponent (fun i : Fin n => movingDegree K z i.val)) :
    ((movingWindowPrefixEquiv K h).symm β).val = β.val :=
  windowDegreeEquiv_symm_val _ β


end Prefix

section Algebraic

variable (K : Type*) {E : Type*} [NormedField K] [NormedField E] [NormedAlgebra K E]

/-- The moving basis of the actual field generated by the first n generators. -/
def movingTowerBasis (y : ℕ → Eˣ) (hy : ∀ n, IsAlgebraic K (y n : E)) :
    (n : ℕ) → Module.Basis (WindowExponent (fun i : Fin n => movingDegree K y i.val))
      K (movingField K y n)
  | 0 => ((Module.Basis.singleton Unit K).map
      (movingFieldZeroEquiv K y).symm.toLinearEquiv).reindex
        (windowZeroEquiv (fun i : Fin 0 => movingDegree K y i.val)).symm
  | n + 1 => movingBasisStep (fun i : Fin (n + 1) => movingDegree K y i.val)
      (movingTowerBasis y hy n)
      (centeredPowerBasis (movingPowerBasis K y hy n) (movingFieldGenerator_ne_zero K y n))
      (∏ i, movingFieldUnits K y n i)

/-- Coercing a monomial in the actual nth field gives the literal ambient monomial. -/
@[simp] theorem movingFieldUnits_monomial_coe (y : ℕ → Eˣ) (n : ℕ)
    (β : Fin n → ℤ) :
    (((∏ i, movingFieldUnits K y n i ^ β i : (movingField K y n)ˣ) :
      movingField K y n) : E) = ((∏ i, y i.val ^ β i : Eˣ) : E) := by
  change ((algebraMap (movingField K y n) E).toMonoidHom.comp (Units.coeHom _))
      (∏ i, movingFieldUnits K y n i ^ β i) =
    (Units.coeHom E) (∏ i, y i.val ^ β i)
  simp only [map_prod, MonoidHom.comp_apply, Units.coeHom_apply, Units.val_zpow_eq_zpow_val]
  apply Finset.prod_congr rfl
  intro i _
  change (algebraMap (movingField K y n) E) ((movingFieldUnits K y n i : movingField K y n) ^ β i) = _
  rw [map_zpow₀]
  rfl

/-- Every vector of the constructed basis is the actual monomial at its moving exponent. -/
theorem movingTowerBasis_apply (y : ℕ → Eˣ) (hy : ∀ n, IsAlgebraic K (y n : E))
    (n : ℕ) (β : WindowExponent (fun i : Fin n => movingDegree K y i.val)) :
    ((movingTowerBasis K y hy n β : movingField K y n) : E) =
      ((∏ i, y i.val ^ β.val i : Eˣ) : E) := by
  induction n with
  | zero =>
      rw [movingTowerBasis, Module.Basis.reindex_apply, Module.Basis.map_apply,
        Module.Basis.singleton_apply]
      change ((movingFieldZeroEquiv K y).symm (1 : K) : E) = _
      rw [movingFieldZeroEquiv_symm_coe]
      simp
  | succ n ih =>
      let b := movingTowerBasis K y hy n
      let c := centeredPowerBasis (movingPowerBasis K y hy n)
        (movingFieldGenerator_ne_zero K y n)
      have hb : ∀ γ, b γ = ((∏ i, movingFieldUnits K y n i ^ γ.val i :
          (movingField K y n)ˣ) : movingField K y n) := by
        intro γ
        apply Subtype.ext
        rw [movingFieldUnits_monomial_coe]
        exact ih γ
      have hc : ∀ j, c j = movingFieldGenerator K y n ^ j.val := by
        intro j
        exact centeredPowerBasis_apply _ _ j
      have hm := movingBasisStep_apply_monomial
        (fun i : Fin (n + 1) => movingDegree K y i.val) b c
        (movingFieldUnits K y n) (movingFieldGenerator K y n) hb hc β
      have hcoe := congrArg (fun x : movingField K y (n + 1) => (x : E)) hm
      change ((movingTowerBasis K y hy (n + 1) β : movingField K y (n + 1)) : E) = _ at hcoe
      rw [hcoe]
      rw [IntermediateField.coe_mul, movingField_step_algebraMap_coe,
        movingFieldUnits_monomial_coe]
      change _ * (algebraMap (movingField K y (n + 1)) E) (movingFieldGenerator K y n ^ β.val (Fin.last n)) = _
      rw [map_zpow₀]
      simp only [Fin.prod_univ_castSucc, Units.val_mul,
        Fin.val_castSucc, Fin.val_last, Units.val_zpow_eq_zpow_val]
      rfl

/-- An arbitrary integer monomial in the generators of the actual finite stage. -/
def movingMonomial (y : ℕ → Eˣ) (n : ℕ) (α : Fin n → ℤ) : movingField K y n :=
  ((∏ i, movingFieldUnits K y n i ^ α i : (movingField K y n)ˣ) : movingField K y n)

@[simp] theorem movingMonomial_coe (y : ℕ → Eˣ) (n : ℕ) (α : Fin n → ℤ) :
    (movingMonomial K y n α : E) = ((∏ i, y i.val ^ α i : Eˣ) : E) :=
  movingFieldUnits_monomial_coe K y n α

theorem movingMonomial_ne_zero (y : ℕ → Eˣ) (n : ℕ) (α : Fin n → ℤ) :
    movingMonomial K y n α ≠ 0 := Units.ne_zero _

/-- The literal monomial splits into a scalar from the preceding field and a power
of the newest generator. -/
theorem movingMonomial_succ (y : ℕ → Eˣ) (n : ℕ) (α : Fin (n + 1) → ℤ) :
    movingMonomial K y (n + 1) α =
      movingMonomial K y n (fun i => α i.castSucc) • movingFieldGenerator K y n ^ α (Fin.last n) := by
  apply Subtype.ext
  rw [movingMonomial_coe, Algebra.smul_def, IntermediateField.coe_mul,
    movingField_step_algebraMap_coe, movingMonomial_coe]
  change _ = _ * (algebraMap (movingField K y (n + 1)) E)
    (movingFieldGenerator K y n ^ α (Fin.last n))
  rw [map_zpow₀]
  simp only [Fin.prod_univ_castSucc, Units.val_mul,
    Fin.val_castSucc, Fin.val_last, Units.val_zpow_eq_zpow_val]
  rfl

/-- Corresponding moving basis vectors have the same ambient monomial. -/
theorem movingTowerBasis_prefix_coe {y z : ℕ → Eˣ}
    (hy : ∀ i, IsAlgebraic K (y i : E)) (hz : ∀ i, IsAlgebraic K (z i : E))
    {n : ℕ} (h : ∀ i < n, y i = z i)
    (β : WindowExponent (fun i : Fin n => movingDegree K z i.val)) :
    ((movingTowerBasis K y hy n ((movingWindowPrefixEquiv K h).symm β) :
      movingField K y n) : E) = ((movingTowerBasis K z hz n β : movingField K z n) : E) := by
  rw [movingTowerBasis_apply, movingTowerBasis_apply]
  apply congrArg Units.val
  apply Finset.prod_congr rfl
  intro i _
  rw [h i.val i.isLt, movingWindowPrefixEquiv_symm_val]

/-- The actual monomial identity makes the moving basis local in the selected prefix. -/
theorem movingTowerBasis_map_prefix {y z : ℕ → Eˣ}
    (hy : ∀ i, IsAlgebraic K (y i : E)) (hz : ∀ i, IsAlgebraic K (z i : E))
    {n : ℕ} (h : ∀ i < n, y i = z i) :
    ((movingTowerBasis K y hy n).map
      (IntermediateField.equivOfEq (movingField_congr_prefix K h)).toLinearEquiv).reindex
        (movingWindowPrefixEquiv K h) = movingTowerBasis K z hz n := by
  exact intermediateField_basis_map_reindex_eq _ _ _ _
    (movingTowerBasis_prefix_coe K hy hz h)

/-- A norm-coordinate constant transfers to any sequence with the same chosen prefix.
This lets a recursive construction choose the constant before its next generator. -/
theorem movingTowerBasis_norm_bound_congr_prefix {y z : ℕ → Eˣ}
    (hy : ∀ i, IsAlgebraic K (y i : E)) (hz : ∀ i, IsAlgebraic K (z i : E))
    {n : ℕ} (h : ∀ i < n, y i = z i) {C : ℝ}
    (hb : ∀ x : movingField K y n, ∀ i,
      ‖(movingTowerBasis K y hy n).repr x i • movingTowerBasis K y hy n i‖ ≤ C * ‖x‖) :
    ∀ x : movingField K z n, ∀ i,
      ‖(movingTowerBasis K z hz n).repr x i • movingTowerBasis K z hz n i‖ ≤ C * ‖x‖ := by
  exact intermediateField_basis_norm_bound_congr _ _ _ _
    (movingTowerBasis_map_prefix K hy hz h) hb

end Algebraic

section Bounds

variable (K : Type*) {E : Type*} [NontriviallyNormedField K] [CompleteSpace K]
  [NormedField E] [NormedAlgebra K E] [IsUltrametricDist E]

omit [IsUltrametricDist E] in
/-- Every current moving basis has one uniform norm constant, at least one. -/
theorem exists_movingTowerBasis_norm_bound (y : ℕ → Eˣ)
    (hy : ∀ n, IsAlgebraic K (y n : E)) (n : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ z : movingField K y n, ∀ i,
      ‖(movingTowerBasis K y hy n).repr z i • movingTowerBasis K y hy n i‖ ≤ C * ‖z‖ := by
  let := Fintype.ofFinite (WindowExponent (fun i : Fin n => movingDegree K y i.val))
  obtain ⟨C, _, hC⟩ := exists_basis_term_norm_bound (movingTowerBasis K y hy n)
  exact ⟨max 1 C, le_max_left _ _, fun z i => (hC z i).trans
    (mul_le_mul_of_nonneg_right (le_max_right _ _) (norm_nonneg z))⟩

omit [CompleteSpace K] [IsUltrametricDist E] in
/-- At the initial field the only basis term is the element itself. -/
theorem movingTowerBasis_zero_term (y : ℕ → Eˣ)
    (hy : ∀ n, IsAlgebraic K (y n : E)) (x : movingField K y 0)
    (β : WindowExponent (fun i : Fin 0 => movingDegree K y i.val)) :
    (movingTowerBasis K y hy 0).repr x β • movingTowerBasis K y hy 0 β = x := by
  let : Unique (WindowExponent (fun i : Fin 0 => movingDegree K y i.val)) :=
    ⟨⟨β⟩, fun γ => Subtype.ext (funext fun i => Fin.elim0 i)⟩
  have he : (default : WindowExponent (fun i : Fin 0 => movingDegree K y i.val)) = β :=
    Subtype.ext (funext fun i => Fin.elim0 i)
  simpa only [Finset.univ_unique, Finset.sum_singleton, he] using
    (movingTowerBasis K y hy 0).sum_repr x

set_option maxHeartbeats 600000 in
/-- For a monomial at the next level, the preceding moving-basis constant bounds each
term. That constant depends only on the generators already chosen. -/
theorem norm_movingTowerBasis_monomial_term_le
    (y : ℕ → Eˣ) (hy : ∀ n, IsAlgebraic K (y n : E)) (n : ℕ)
    {C : ℝ} (hC : 0 ≤ C)
    (hb : ∀ z : movingField K y n, ∀ i,
      ‖(movingTowerBasis K y hy n).repr z i • movingTowerBasis K y hy n i‖ ≤ C * ‖z‖)
    (c : K) (α : Fin (n + 1) → ℤ)
    (β : WindowExponent (fun i : Fin (n + 1) => movingDegree K y i.val)) :
    ‖(movingTowerBasis K y hy (n + 1)).repr (c • movingMonomial K y (n + 1) α) β •
        movingTowerBasis K y hy (n + 1) β‖ ≤ C * ‖c • movingMonomial K y (n + 1) α‖ := by
  let : Algebra (movingField K y n) (movingField K y (n + 1)) :=
    movingField_stepAlgebra K y n
  let : Module (movingField K y n) (movingField K y (n + 1)) := Algebra.toModule
  let : NormedAlgebra (movingField K y n) (movingField K y (n + 1)) :=
    movingField_stepNormedAlgebra K y n
  let : IsScalarTower K (movingField K y n) (movingField K y (n + 1)) :=
    movingField_stepScalarTower K y n
  let : CompleteSpace (movingField K y n) := movingField_completeSpace K y hy n
  let := (movingPowerBasis K y hy n).finite
  change ‖(movingBasisStep _ _ _ _).repr _ β • movingBasisStep _ _ _ _ β‖ ≤ _
  apply norm_movingBasisStep_term_le _ _ _ _ hC hb
  intro j
  rw [movingMonomial_succ, ← smul_assoc]
  exact norm_centeredPowerBasis_monomial_term_le (movingPowerBasis K y hy n)
    (movingFieldGenerator_ne_zero K y n)
    (c • movingMonomial K y n (fun i => α i.castSucc)) (α (Fin.last n)) j

omit [CompleteSpace K] [IsUltrametricDist E] in
/-- The initial basis has norm constant one and hence additive loss zero. -/
theorem movingTowerBasis_zero_norm_bound (y : ℕ → Eˣ)
    (hy : ∀ n, IsAlgebraic K (y n : E)) (x : movingField K y 0)
    (β : WindowExponent (fun i : Fin 0 => movingDegree K y i.val)) :
    ‖(movingTowerBasis K y hy 0).repr x β • movingTowerBasis K y hy 0 β‖ ≤ 1 * ‖x‖ := by
  rw [movingTowerBasis_zero_term, one_mul]

/-- The additive-order form of the monomial basis bound, with the logarithm of the preceding
basis constant as loss. Zero coordinates are excluded explicitly. -/
theorem order_movingTowerBasis_monomial_term_ge
    (y : ℕ → Eˣ) (hy : ∀ n, IsAlgebraic K (y n : E)) (n : ℕ)
    {C : ℝ} (hC : 1 ≤ C)
    (hb : ∀ z : movingField K y n, ∀ i,
      ‖(movingTowerBasis K y hy n).repr z i • movingTowerBasis K y hy n i‖ ≤ C * ‖z‖)
    (c : K) (α : Fin (n + 1) → ℤ)
    (β : WindowExponent (fun i : Fin (n + 1) => movingDegree K y i.val))
    (hβ : (movingTowerBasis K y hy (n + 1)).repr
      (c • movingMonomial K y (n + 1) α) β ≠ 0) :
    -Real.log ‖c • movingMonomial K y (n + 1) α‖ - Real.log C ≤
      -Real.log ‖(movingTowerBasis K y hy (n + 1)).repr
        (c • movingMonomial K y (n + 1) α) β • movingTowerBasis K y hy (n + 1) β‖ := by
  have hCpos : 0 < C := lt_of_lt_of_le zero_lt_one hC
  have hx : c • movingMonomial K y (n + 1) α ≠ 0 := by
    intro hz
    exact hβ (by rw [hz, map_zero, Finsupp.zero_apply])
  have ht : 0 < ‖(movingTowerBasis K y hy (n + 1)).repr
      (c • movingMonomial K y (n + 1) α) β • movingTowerBasis K y hy (n + 1) β‖ :=
    norm_pos_iff.mpr (smul_ne_zero hβ ((movingTowerBasis K y hy (n + 1)).ne_zero β))
  have hn := norm_movingTowerBasis_monomial_term_le K y hy n hCpos.le hb c α β
  have hl := Real.log_le_log ht hn
  rw [Real.log_mul hCpos.ne' (norm_ne_zero_iff.mpr hx)] at hl
  linarith

end Bounds

end HereditaryAtomicity.DVRBase
