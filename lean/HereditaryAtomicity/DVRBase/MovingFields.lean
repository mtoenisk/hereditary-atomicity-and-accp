import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.Analysis.Normed.Field.Basic
import Mathlib.Analysis.Normed.Algebra.Basic
import Mathlib.Analysis.Normed.Algebra.Ultra
import Mathlib.Analysis.Normed.Group.Ultra
import Mathlib.Tactic

/-!
# Actual successive simple-extension fields

The stages live as intermediate fields of one ambient field. Only the chosen
sequence is required to be algebraic over the base; the ambient field itself
may be transcendental over the base, as happens for an ambient completion.
-/

noncomputable section
namespace HereditaryAtomicity.DVRBase

section Fields

variable (K : Type*) {E : Type*} [Field K] [Field E] [Algebra K E]

/-- The actual field generated by the first n elements, constructed as a tower
of simple adjunctions to make all adjacent extension structures literal. -/
def movingField (y : ℕ → Eˣ) : ℕ → IntermediateField K E
  | 0 => ⊥
  | n + 1 => (IntermediateField.adjoin (movingField y n) {(y n : E)}).restrictScalars K

@[simp] theorem movingField_zero (y : ℕ → Eˣ) : movingField K y 0 = ⊥ := rfl

instance movingField_stepAlgebra (y : ℕ → Eˣ) (n : ℕ) :
    Algebra (movingField K y n) (movingField K y (n + 1)) :=
  inferInstanceAs (Algebra (movingField K y n)
    (IntermediateField.adjoin (movingField K y n) {(y n : E)}))

instance movingField_stepScalarTower (y : ℕ → Eˣ) (n : ℕ) :
    IsScalarTower K (movingField K y n) (movingField K y (n + 1)) :=
  inferInstanceAs (IsScalarTower K (movingField K y n)
    (IntermediateField.adjoin (movingField K y n) {(y n : E)}))

instance movingField_stepAmbientScalarTower (y : ℕ → Eˣ) (n : ℕ) :
    IsScalarTower (movingField K y n) (movingField K y (n + 1)) E :=
  inferInstanceAs (IsScalarTower (movingField K y n)
    (IntermediateField.adjoin (movingField K y n) {(y n : E)}) E)

@[simp] theorem movingField_step_algebraMap_coe (y : ℕ → Eˣ) (n : ℕ)
    (x : movingField K y n) :
    ((algebraMap (movingField K y n) (movingField K y (n + 1)) x :
      movingField K y (n + 1)) : E) = (x : E) := rfl

theorem movingField_le_succ (y : ℕ → Eˣ) (n : ℕ) :
    movingField K y n ≤ movingField K y (n + 1) := by
  intro x hx
  exact IntermediateField.algebraMap_mem (IntermediateField.adjoin (movingField K y n) {(y n : E)})
    (⟨x, hx⟩ : movingField K y n)

theorem movingField_monotone (y : ℕ → Eˣ) : Monotone (movingField K y) :=
  monotone_nat_of_le_succ (movingField_le_succ K y)

theorem movingField_generator_mem (y : ℕ → Eˣ) (n : ℕ) :
    (y n : E) ∈ movingField K y (n + 1) :=
  IntermediateField.subset_adjoin (movingField K y n) {(y n : E)} (Set.mem_singleton _)

theorem movingField_generator_mem_of_lt (y : ℕ → Eˣ) {i n : ℕ} (hi : i < n) :
    (y i : E) ∈ movingField K y n :=
  movingField_monotone K y (Nat.succ_le_of_lt hi) (movingField_generator_mem K y i)

/-- The newest generator viewed as an element of its actual successor field. -/
def movingFieldGenerator (y : ℕ → Eˣ) (n : ℕ) : movingField K y (n + 1) :=
  ⟨y n, movingField_generator_mem K y n⟩

@[simp] theorem movingFieldGenerator_coe (y : ℕ → Eˣ) (n : ℕ) :
    (movingFieldGenerator K y n : E) = (y n : E) := rfl

theorem movingFieldGenerator_ne_zero (y : ℕ → Eˣ) (n : ℕ) :
    movingFieldGenerator K y n ≠ 0 := by
  intro h
  exact (y n).ne_zero (congrArg (fun x : movingField K y (n + 1) => (x : E)) h)

/-- The actual adjacent extension has the power basis of the next chosen element. -/
def movingPowerBasis (y : ℕ → Eˣ) (hy : ∀ n, IsAlgebraic K (y n : E)) (n : ℕ) :
    PowerBasis (movingField K y n) (movingField K y (n + 1)) :=
  IntermediateField.adjoin.powerBasis ((hy n).tower_top (L := movingField K y n)).isIntegral

@[simp] theorem movingPowerBasis_gen (y : ℕ → Eˣ)
    (hy : ∀ n, IsAlgebraic K (y n : E)) (n : ℕ) :
    (movingPowerBasis K y hy n).gen = movingFieldGenerator K y n := rfl

theorem movingPowerBasis_dim (y : ℕ → Eˣ)
    (hy : ∀ n, IsAlgebraic K (y n : E)) (n : ℕ) :
    (movingPowerBasis K y hy n).dim =
      Module.finrank (movingField K y n) (movingField K y (n + 1)) :=
  (movingPowerBasis K y hy n).finrank.symm

/-- The actual relative degree, expressed by the next generator's minimal polynomial. -/
def movingDegree (y : ℕ → Eˣ) (n : ℕ) : ℕ :=
  (minpoly (movingField K y n) (y n : E)).natDegree

@[simp] theorem movingPowerBasis_dim_eq (y : ℕ → Eˣ)
    (hy : ∀ n, IsAlgebraic K (y n : E)) (n : ℕ) :
    (movingPowerBasis K y hy n).dim = movingDegree K y n := rfl

/-- Every finite stage has finite degree over the original coefficient field. -/
theorem movingField_finiteDimensional (y : ℕ → Eˣ)
    (hy : ∀ n, IsAlgebraic K (y n : E)) (n : ℕ) :
    FiniteDimensional K (movingField K y n) := by
  induction n with
  | zero => exact (IntermediateField.botEquiv K E).symm.toLinearEquiv.finiteDimensional
  | succ n ih =>
      let := ih
      let := (movingPowerBasis K y hy n).finite
      exact FiniteDimensional.trans K (movingField K y n) (movingField K y (n + 1))

/-- The initial level is canonically the coefficient field. -/
def movingFieldZeroEquiv (y : ℕ → Eˣ) : movingField K y 0 ≃ₐ[K] K :=
  IntermediateField.botEquiv K E

@[simp] theorem movingFieldZeroEquiv_symm_coe (y : ℕ → Eˣ) (c : K) :
    ((movingFieldZeroEquiv K y).symm c : E) = algebraMap K E c := by
  rfl

/-- The first n generators are actual units of the nth field. -/
def movingFieldUnits (y : ℕ → Eˣ) (n : ℕ) : Fin n → (movingField K y n)ˣ := fun i =>
  Units.mk0 ⟨y i.val, movingField_generator_mem_of_lt K y i.isLt⟩ (by
    intro h
    exact (y i.val).ne_zero
      (congrArg (fun z : movingField K y n => (z : E)) h))

@[simp] theorem movingFieldUnits_coe (y : ℕ → Eˣ) (n : ℕ) (i : Fin n) :
    (((movingFieldUnits K y n i : (movingField K y n)ˣ) : movingField K y n) : E) =
      (y i.val : E) := rfl

@[simp] theorem movingFieldUnits_step (y : ℕ → Eˣ) (n : ℕ) (i : Fin n) :
    Units.map (algebraMap (movingField K y n) (movingField K y (n + 1)))
      (movingFieldUnits K y n i) = movingFieldUnits K y (n + 1) i.castSucc := by
  apply Units.ext
  apply Subtype.ext
  rfl

@[simp] theorem movingFieldUnits_last (y : ℕ → Eˣ) (n : ℕ) :
    (movingFieldUnits K y (n + 1) (Fin.last n) : movingField K y (n + 1)) =
      movingFieldGenerator K y n := rfl

/-- A finite field stage depends only on the finite prefix chosen so far. -/
theorem movingField_congr_prefix {y z : ℕ → Eˣ} {n : ℕ}
    (h : ∀ i < n, y i = z i) : movingField K y n = movingField K z n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      have hp := ih (fun i hi => h i (Nat.lt_succ_of_lt hi))
      have hn := h n (Nat.lt_succ_self n)
      change (IntermediateField.adjoin (movingField K y n) {(y n : E)}).restrictScalars K =
        (IntermediateField.adjoin (movingField K z n) {(z n : E)}).restrictScalars K
      rw [hn]
      exact congrArg (fun F : IntermediateField K E =>
        (IntermediateField.adjoin F {(z n : E)}).restrictScalars K) hp

/-- A step degree depends only on the prefix including its new generator. -/
theorem movingDegree_congr_prefix {y z : ℕ → Eˣ} {n : ℕ}
    (h : ∀ i ≤ n, y i = z i) : movingDegree K y n = movingDegree K z n := by
  have hp := movingField_congr_prefix K (fun i hi => h i (Nat.le_of_lt hi))
  have hn := h n le_rfl
  change (minpoly (movingField K y n) (y n : E)).natDegree =
    (minpoly (movingField K z n) (z n : E)).natDegree
  rw [hn]
  exact congrArg (fun F : IntermediateField K E => (minpoly F (z n : E)).natDegree) hp

theorem movingDegree_eq_finrank (y : ℕ → Eˣ)
    (hy : ∀ n, IsAlgebraic K (y n : E)) (n : ℕ) :
    movingDegree K y n = Module.finrank (movingField K y n) (movingField K y (n + 1)) :=
  movingPowerBasis_dim K y hy n

theorem movingDegree_pos (y : ℕ → Eˣ)
    (hy : ∀ n, IsAlgebraic K (y n : E)) (n : ℕ) : 0 < movingDegree K y n :=
  (movingPowerBasis K y hy n).dim_pos

/-- The literal set of the first n chosen ambient generators. -/
def movingPrefixSet (y : ℕ → Eˣ) (n : ℕ) : Set E :=
  Set.range (fun i : Fin n => (y i.val : E))

theorem movingPrefixSet_succ (y : ℕ → Eˣ) (n : ℕ) :
    movingPrefixSet y (n + 1) = movingPrefixSet y n ∪ {(y n : E)} := by
  ext x
  simp only [movingPrefixSet, Set.mem_range, Set.mem_union, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩
    by_cases hi : i.val < n
    · exact Or.inl ⟨⟨i.val, hi⟩, rfl⟩
    · right
      have hn : i.val = n := by omega
      rw [hn]
  · rintro (⟨i, rfl⟩ | rfl)
    · exact ⟨i.castSucc, rfl⟩
    · exact ⟨Fin.last n, rfl⟩

/-- The recursive fields are precisely the fields generated by the finite prefixes. -/
theorem movingField_eq_adjoin_prefix (y : ℕ → Eˣ) (n : ℕ) :
    movingField K y n = IntermediateField.adjoin K (movingPrefixSet y n) := by
  induction n with
  | zero => simp [movingField, movingPrefixSet]
  | succ n ih =>
      change (IntermediateField.adjoin (movingField K y n) {(y n : E)}).restrictScalars K = _
      calc
        _ = (IntermediateField.adjoin (IntermediateField.adjoin K (movingPrefixSet y n))
            {(y n : E)}).restrictScalars K :=
          congrArg (fun F : IntermediateField K E =>
            (IntermediateField.adjoin F {(y n : E)}).restrictScalars K) ih
        _ = IntermediateField.adjoin K (movingPrefixSet y n ∪ {(y n : E)}) :=
          IntermediateField.adjoin_adjoin_left K (movingPrefixSet y n) {(y n : E)}
        _ = _ := congrArg (IntermediateField.adjoin K) (movingPrefixSet_succ y n).symm

end Fields

section Normed

variable (K : Type*) {E : Type*} [NontriviallyNormedField K] [NormedField E]
  [NormedAlgebra K E]

instance movingField_ambientNormedAlgebra (y : ℕ → Eˣ) (n : ℕ) :
    NormedAlgebra (movingField K y n) E where
  norm_smul_le r x := by
    change ‖(r : E) * x‖ ≤ ‖r‖ * ‖x‖
    exact le_of_eq (norm_mul _ _)

instance movingField_stepNormedAlgebra (y : ℕ → Eˣ) (n : ℕ) :
    NormedAlgebra (movingField K y n) (movingField K y (n + 1)) :=
  inferInstanceAs (NormedAlgebra (movingField K y n)
    (IntermediateField.adjoin (movingField K y n) {(y n : E)}))

/-- Each algebraic finite stage is complete under its inherited ambient norm. -/
theorem movingField_completeSpace [CompleteSpace K] (y : ℕ → Eˣ)
    (hy : ∀ n, IsAlgebraic K (y n : E)) (n : ℕ) : CompleteSpace (movingField K y n) := by
  let := movingField_finiteDimensional K y hy n
  exact FiniteDimensional.complete K (movingField K y n)

instance movingField_ultrametric [IsUltrametricDist E] (y : ℕ → Eˣ) (n : ℕ) :
    IsUltrametricDist (movingField K y n) :=
  IsUltrametricDist.of_normedAlgebra' E

end Normed

end HereditaryAtomicity.DVRBase
