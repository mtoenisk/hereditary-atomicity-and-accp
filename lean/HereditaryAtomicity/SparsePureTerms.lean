import HereditaryAtomicity.SparseConductorBase

/-! # Pure polynomial parts of the actual conductor cut -/
open scoped NNReal
noncomputable section
namespace HereditaryAtomicity
variable {K : Type*} [Field K]

/-- Collected support on nonnegative generator exponents, without endpoints. -/
def SparsePure {A : Type*} [CommRing A] (p : AddMonoidAlgebra A SparseLaurentKey) : Prop :=
  ∀ w, p.coeff w ≠ 0 → w.Pure

namespace SparsePure
variable {A : Type*} [CommRing A] {p q : AddMonoidAlgebra A SparseLaurentKey}

theorem zero : SparsePure (0 : AddMonoidAlgebra A SparseLaurentKey) := by
  intro w h
  exact (h rfl).elim

theorem single (w : SparseLaurentKey) (b : A) (hw : w.Pure) :
    SparsePure (AddMonoidAlgebra.single w b) := by
  classical
  intro z hz
  by_cases h : z=w
  · simpa only [h] using hw
  · exact (hz (by simp [AddMonoidAlgebra.coeff_single, Ne.symm h])).elim

theorem add (hp : SparsePure p) (hq : SparsePure q) : SparsePure (p+q) := by
  intro w hw
  by_cases h : p.coeff w=0
  · apply hq w
    intro hz
    exact hw (by simp [h,hz])
  · exact hp w h

theorem neg (hp : SparsePure p) : SparsePure (-p) := by
  intro w hw
  apply hp w
  intro h
  exact hw (by simp [h])

theorem mul (hp : SparsePure p) (hq : SparsePure q) : SparsePure (p*q) := by
  classical
  intro w hw
  rw [AddMonoidAlgebra.coeff_mul] at hw
  obtain ⟨u,_,hu⟩ := Finset.exists_ne_zero_of_sum_ne_zero hw
  obtain ⟨z,_,hz⟩ := Finset.exists_ne_zero_of_sum_ne_zero hu
  by_cases heq : u+z=w
  · simp only [heq, ↓reduceIte] at hz
    rw [← heq]
    exact (hp u (fun h0 => hz (by rw [h0,zero_mul]))).add
      (hq z (fun h0 => hz (by rw [h0,mul_zero])))
  · exact (hz (by simp [heq])).elim

end SparsePure

def sparsePureSupportSubring (A : Subring K) : Subring (AddMonoidAlgebra A SparseLaurentKey) where
  carrier := SparsePure
  zero_mem' := SparsePure.zero
  one_mem' := SparsePure.single 0 1 SparseLaurentKey.pure_zero
  add_mem' := SparsePure.add
  neg_mem' := SparsePure.neg
  mul_mem' := SparsePure.mul

/-- The actual polynomial algebra generated by the coefficient ring and a_n,
inside the collected Laurent algebra. -/
def sparsePurePolynomialRing (A : Subring K) : Subring (AddMonoidAlgebra A SparseLaurentKey) :=
  Subring.closure (Set.range (fun b:A => AddMonoidAlgebra.single 0 b) ∪
    Set.range (fun n:ℕ => AddMonoidAlgebra.single (SparseLaurentKey.variableKey n) (1:A)))

theorem sparsePurePolynomialRing_pure (A : Subring K)
    {p:AddMonoidAlgebra A SparseLaurentKey} (hp : p∈sparsePurePolynomialRing A) : SparsePure p := by
  have h : sparsePurePolynomialRing A ≤ sparsePureSupportSubring A := by
    apply Subring.closure_le.mpr
    rintro p (⟨b,rfl⟩ | ⟨n,rfl⟩)
    · exact SparsePure.single 0 b SparseLaurentKey.pure_zero
    · exact SparsePure.single _ 1 (SparseLaurentKey.pure_variable n)
  exact h hp

theorem sparsePurePolynomialRing_collected {ι : Type*} (v : ι → Valuation K ℝ≥0)
    (R A : Subring K) (hA : A ≤ R)
    (hR : ∀ z∈R, z≠0 → ∀ i, 0≤realValuationOrder (v i) z)
    (a : ℕ → Kˣ) (ha : ∀ n, (a n:K)∈R) (x y : Kˣ) (c : ℝ)
    {p:AddMonoidAlgebra A SparseLaurentKey} (hp : p∈sparsePurePolynomialRing A) :
    SparseCollected v R A a x y c p := by
  have h : sparsePurePolynomialRing A ≤ sparseCollectedSubring v R A hR a x y c := by
    apply Subring.closure_le.mpr
    rintro p (⟨b,rfl⟩ | ⟨n,rfl⟩)
    · apply SparseCollected.single
      · simpa using hA b.property
      · exact fun h => (h SparseLaurentKey.pure_zero).elim
      · exact fun h => (h SparseLaurentKey.pure_zero.relevant).elim
    · apply SparseCollected.single
      · simpa using ha n
      · exact fun h => (h (SparseLaurentKey.pure_variable n)).elim
      · exact fun h => (h (SparseLaurentKey.pure_variable n).relevant).elim
  exact h hp

theorem sparsePurePolynomialRing_eval_mem (S A : Subring K) (hAS : A ≤ S)
    (a : ℕ → Kˣ) (ha : ∀ n,(a n:K)∈S) (x y:Kˣ)
    {p:AddMonoidAlgebra A SparseLaurentKey} (hp : p∈sparsePurePolynomialRing A) :
    sparseLaurentEval A a x y p∈S := by
  have h : sparsePurePolynomialRing A ≤ S.comap (sparseLaurentEval A a x y) := by
    apply Subring.closure_le.mpr
    rintro p (⟨b,rfl⟩ | ⟨n,rfl⟩)
    · change sparseLaurentEval A a x y (AddMonoidAlgebra.single 0 b)∈S
      simpa [sparseLaurentEval] using hAS b.property
    · change sparseLaurentEval A a x y (AddMonoidAlgebra.single (.variableKey n) 1)∈S
      simpa [sparseLaurentEval] using ha n
  exact h hp

/-- The source-generated ring is polynomial modulo any ideal containing the
actual high generators. The polynomial representative is independent of branch. -/
theorem sparseConductorBase_pure_decomposition {ι : Type*}
    (v : ι → Valuation K ℝ≥0) (A S : Subring K)
    (a : ℕ → Kˣ) (x y : Kˣ) (π:K) (c:ℝ)
    (hCS : sparseConductorBase v A a x y π c ≤ S)
    (I : Ideal S)
    (hGI : ∀ z, ∀ hz:z∈sparseHighGenerators v a x y π c,
      (⟨z,hCS (sparseConductorBase_high v A a x y π c hz)⟩:S)∈I)
    {z:K} (hz:z∈sparseConductorBase v A a x y π c) :
    ∃ p:AddMonoidAlgebra A SparseLaurentKey, p∈sparsePurePolynomialRing A ∧
      ∃ b:S, b∈I ∧ z=sparseLaurentEval A a x y p+(b:K) := by
  let hAS : A ≤ S := (sparseConductorBase_coefficient v A a x y π c).trans hCS
  let haS : ∀ n,(a n:K)∈S := fun n => hCS (sparseConductorBase_variable v A a x y π c n)
  let f : sparsePurePolynomialRing A →+* S :=
    ((sparseLaurentEval A a x y).comp (sparsePurePolynomialRing A).subtype).codRestrict S
      (fun p => sparsePurePolynomialRing_eval_mem S A hAS a haS x y p.property)
  let D := (subringPlusIdeal f.range I).map S.subtype
  have hD : sparseConductorBase v A a x y π c ≤ D := by
    apply Subring.closure_le.mpr
    rintro z ((hz | ⟨n,rfl⟩) | hz)
    · let p : sparsePurePolynomialRing A := ⟨AddMonoidAlgebra.single 0 ⟨z,hz⟩,
        Subring.subset_closure (Or.inl ⟨⟨z,hz⟩,rfl⟩)⟩
      refine ⟨f p,subring_le_subringPlusIdeal f.range I ⟨p,rfl⟩,?_⟩
      simp [f,p,sparseLaurentEval]
    · let p : sparsePurePolynomialRing A := ⟨AddMonoidAlgebra.single (.variableKey n) 1,
        Subring.subset_closure (Or.inr ⟨n,rfl⟩)⟩
      refine ⟨f p,subring_le_subringPlusIdeal f.range I ⟨p,rfl⟩,?_⟩
      simp [f,p,sparseLaurentEval]
    · exact ⟨⟨z,hCS (sparseConductorBase_high v A a x y π c hz)⟩,
        ideal_subset_subringPlusIdeal f.range I (hGI z hz),rfl⟩
  obtain ⟨zS,⟨b,⟨p,rfl⟩,i,hi,hzi⟩,hzS⟩ := hD hz
  refine ⟨p,p.property,i,hi,?_⟩
  rw [← hzS,hzi]
  rfl

end HereditaryAtomicity
